@@ -0,0 +1,119 @@
+"""Fixed 64-seed fresh validation of the reconstructed public END planner."""
+import argparse
+from dataclasses import asdict
+import json
+import multiprocessing as mp
+import os
+from pathlib import Path
+import time
+
+import numpy as np
+import torch
+from plan_common import CURRENT, install, load_actor, save as save_json, seed_of
+from planner import BattleScorer, PlannerConfig
+from public_opponent import PublicOpponentPlanner
+
+
+FOLDER=Path(os.environ.get('SAP_PANEL_OUTPUT','public-panel-v1'))
+N=64
+CONFIG=PlannerConfig(position_only=True,sim_opponent=True)
+NAMESPACE='public-25772-end-panel-v1'
+
+
+class MatchBattleScorer:
+    # This configuration only compares boards generated during this decision.
+    versus_many=BattleScorer.versus_many
+
+    def __init__(self,pool):
+        self.pool=pool
+
+
+@torch.inference_mode()
+def play(index,seat,actor,scorer):
+    from sapai_gym1.rl.selfplay_env import ParallelSelfPlayEnv
+    from sapai_gym1.rl.joint_action import step_decisions
+    from sapai_gym1.rl.distributed import _completed_match_result
+    from teacher_world import ActorRequest
+    seed=seed_of(NAMESPACE,'game',index)
+    env=ParallelSelfPlayEnv()
+    env.reset(seed=seed,paired_tape=True)
+    planner=getattr(scorer,'planner_type',PublicOpponentPlanner)(actor,scorer,CONFIG,seed_of(NAMESPACE,'search',index,seat))
+    memory=[torch.zeros(actor.model.config.memory_dim) for _ in range(2)]
+    start=time.monotonic()
+    for step in range(1,2501):
+        actions=[None,None]
+        obs=env.observations()
+        for side,active in enumerate(env.active_players()):
+            if active:
+                if side==seat:
+                    response=planner.decide(env,side,memory[side])
+                else:
+                    response=actor.act_many([ActorRequest(obs[side],memory[side],actor.owner)])[0]
+                actions[side]=response.action
+                memory[side]=response.next_memory
+        if step_decisions(env,actions).result.terminated:
+            winner=_completed_match_result(env.core)
+            return dict(index=index,seed=seed,seat=seat,checkpoint=actor.owner,config=asdict(CONFIG),
+                        steps=step,score=.5 if winner==2 else float(winner==seat),
+                        stats=planner.stats,seconds=time.monotonic()-start)
+    raise RuntimeError('Game exceeded the bounded simulator horizon')
+
+
+def run(start,stop,backend='reference',rollout_width=64):
+    assert 0<=start<stop<=N
+    FOLDER.mkdir(parents=True,exist_ok=True)
+    install(cuda=False)
+    # Fork the CPU battle workers before CUDA initialization.
+    with mp.get_context('fork').Pool(3) as pool:
+        install(cuda=True)
+        torch.cuda.set_per_process_memory_fraction(.04)
+        actor=load_actor(device='cuda')
+        from scorer_backend import select_backend
+        scorer,identity=select_backend(backend,pool,rollout_width)
+        for index in range(start,stop):
+            for seat in (0,1):
+                path=FOLDER/f'game-{index:03d}-{seat}.json'
+                if path.exists():
+                    saved=json.loads(path.read_text())
+                    legacy={'scorer':'reference','nativeSHA256':None,'planner':'PublicOpponentPlanner'}
+                    if saved.get('backend',legacy)!=identity:
+                        raise ValueError('Scorer differs from the saved game')
+                    if (saved['checkpoint'],saved['config'],saved['index'],saved['seat'],saved['seed'])!=(
+                        actor.owner,asdict(CONFIG),index,seat,seed_of(NAMESPACE,'game',index)):
+                        raise ValueError('Resume record does not match fixed panel')
+                    continue
+                row=play(index,seat,actor,scorer)
+                row['backend']=identity
+                save_json(path,row)
+                print(index,seat,row['score'],round(row['seconds'],1),flush=True)
+
+
+def summarize():
+    rows=[json.loads((FOLDER/f'game-{i:03d}-{s}.json').read_text()) for i in range(N) for s in (0,1)]
+    legacy={'scorer':'reference','nativeSHA256':None,'planner':'PublicOpponentPlanner'}
+    if any(r.get('backend',legacy)!=rows[0].get('backend',legacy) for r in rows):
+        raise ValueError('Cannot combine games from different scoring backends')
+    scores=[]
+    for i in range(N):
+        pair=rows[2*i:2*i+2]
+        assert [r['seat'] for r in pair]==[0,1]
+        assert all((r['index'],r['seed'],r['config'],r['checkpoint']) ==
+                   (i,seed_of(NAMESPACE,'game',i),asdict(CONFIG),CURRENT['sha']) and
+                   r['score'] in (0,.5,1) for r in pair)
+        scores.append(np.mean([r['score'] for r in pair]))
+    boot=np.random.default_rng(20261121).choice(scores,(20000,N)).mean(1)
+    result=dict(pairs=N,games=len(rows),score=np.mean(scores),
+                paired95=np.quantile(boot,[.025,.975]).tolist(),config=asdict(CONFIG))
+    save_json(FOLDER/'summary.json',result)
+    print(result)
+
+
+if __name__=='__main__':
+    p=argparse.ArgumentParser()
+    p.add_argument('--start',type=int,default=0)
+    p.add_argument('--stop',type=int,default=N)
+    p.add_argument('--summary',action='store_true')
+    p.add_argument('--backend',choices=('auto','reference','compact','native'),default='reference')
+    p.add_argument('--rollout-width',type=int,choices=(8,64),default=64)
+    args=p.parse_args()
+    summarize() if args.summary else run(args.start,args.stop,args.backend,args.rollout_width)
