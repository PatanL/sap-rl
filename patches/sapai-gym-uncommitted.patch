@@ -0,0 +1,165 @@
+"""Schedule and score a fixed human panel locally.
+
+Create from a JSON roster of {"player": "...", "qualification": "..."} rows.
+Keep the printed plan digest before playing. Use it for play and score.
+Qualifications are supplied by the organizer. No human actions are logged.
+"""
+import argparse
+from collections import Counter
+import hashlib
+import json
+import math
+import os
+from pathlib import Path
+import secrets
+import subprocess
+
+
+HERE = Path(__file__).resolve().parent
+PARENT = '0669109e9b6ee2d4f0309a3fec83039fc8a7d74f74e3c9f629d2f7026e515d49'
+SIMULATOR = 'turtle-v30-food-right-reorder10-v1-20260911'
+DRIVER = ('public_opponent.py', 'public_panel.py', 'matched_play.py')
+
+
+def digest(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def create(folder, roster, games, engine):
+    if games < 2 or games % 2:
+        raise ValueError('Choose an even number of games per player for balanced seats.')
+    if not isinstance(roster, list) or not roster:
+        raise ValueError('A roster is required.')
+    for row in roster:
+        if not all(isinstance(row.get(k), str) and row[k].strip() for k in ('player', 'qualification')):
+            raise ValueError('Each player needs an identifier and a qualification reference.')
+    players = [r['player'] for r in roster]
+    if len(players) != len(set(players)):
+        raise ValueError('Duplicate player identifier')
+    schedule = []
+    for player in players:
+        for _ in range(games // 2):
+            first = secrets.randbelow(2)
+            for seat in (first, 1-first):
+                schedule.append(dict(player=player, humanSeat=seat))
+    plan = dict(schema='sap-frozen-human-series-v1', roster=roster, engine=engine,
+                checkpoint=PARENT, simulator=SIMULATOR, gamesPerPlayer=games,
+                schedule=schedule, trainingUse=False,
+                scoring='Bot win 1, draw 0.5, loss 0. Equal games per rostered player. Report every slot.')
+    folder.mkdir(parents=True, exist_ok=True)
+    if any(folder.iterdir()):
+        raise ValueError('Choose a new or empty series directory.')
+    with (folder/'plan.json').open('x') as f:
+        json.dump(plan, f, indent=2, ensure_ascii=False)
+    return digest(folder/'plan.json')
+
+
+def engine_identity(release):
+    experiment = release/'runs/claude-end-positioner-20261112-v1'
+    mode=os.environ.get('SAP_MATCH_MODE','raw')
+    if mode not in ('raw','planner'):
+        raise ValueError('SAP_MATCH_MODE must be raw or planner')
+    return dict(policyMode=mode,driver={name:digest(HERE/name) for name in DRIVER},
+                wrapper=digest(HERE/'run_matched_play.sh'),
+                scoringProgram=digest(Path(__file__)),
+                simulatorManifest=digest(release/'runs/search-throughput-5x-20260912-v1/REFERENCE_MANIFEST.json'),
+                planner={name:digest(experiment/name) for name in ('planner.py','plan_common.py')},
+                image=subprocess.check_output(['docker','image','inspect','--format','{{.Id}}',
+                                               os.environ.get('SAP_MATCH_IMAGE','sap-rl-shared')], text=True).strip())
+
+
+def read_plan(folder, expected):
+    if digest(folder/'plan.json') != expected:
+        raise ValueError('Plan digest does not match the pre-play commitment.')
+    return json.loads((folder/'plan.json').read_text())
+
+
+def play(folder, plan, expected_digest, player, release):
+    if engine_identity(release) != plan['engine']:
+        raise ValueError('Engine differs from the rostered series.')
+    for i,slot in enumerate(plan['schedule']):
+        if slot['player'] != player:
+            continue
+        path=folder/f'game-{i:04d}'
+        if path.exists():
+            continue
+        # Only one operator may claim this slot. A failed launch remains visible.
+        path.mkdir()
+        return subprocess.run(['bash',str(HERE/'run_matched_play.sh'),str(release),
+                               str(slot['humanSeat']),str(path.resolve())],
+                              env={**os.environ,'SAP_MATCH_IMAGE':plan['engine']['image'],
+                                   'SAP_SERIES_DIGEST':expected_digest,'SAP_SERIES_SLOT':str(i)}).returncode
+    raise ValueError('No unstarted slot for this player.')
+
+
+def score(folder, plan):
+    results={r['player']:Counter() for r in plan['roster']}
+    seen_seeds=set()
+    expected_digest=digest(folder/'plan.json')
+    for i,slot in enumerate(plan['schedule']):
+        path=folder/f'game-{i:04d}'
+        files=list(path.glob('*.json'))
+        if not files:
+            results[slot['player']]['incomplete' if path.exists() else 'unstarted']+=1
+            continue
+        if len(files)!=1:
+            raise ValueError(f'Multiple receipts in {path}')
+        row=json.loads(files[0].read_text())
+        if row.get('policyMode')!=plan['engine']['policyMode']:
+            raise ValueError(f'Policy mode differs from the precommitted series: {path}')
+        if row.get('seriesDigest')!=expected_digest or row.get('seriesSlot')!=str(i):
+            raise ValueError(f'Receipt does not belong to this series slot: {path}')
+        if (row['humanSeat'],row['checkpoint'],row['simulator'],row['sourceHashes'],row['trainingUse'])!=(
+                slot['humanSeat'],plan['checkpoint'],plan['simulator'],plan['engine']['driver'],False):
+            raise ValueError(f'Receipt mismatch in {path}')
+        if row['status']!='completed':
+            results[slot['player']]['incomplete']+=1
+            continue
+        winner=row['winner']
+        if type(winner) is not int or winner not in (0,1,2):
+            raise ValueError('Invalid winner')
+        seeds=f"{row['gameSeed']}/{row['searchSeed']}"
+        if hashlib.sha256(seeds.encode()).hexdigest()!=row['seedCommitment'] or row['gameSeed'] in seen_seeds:
+            raise ValueError('Invalid or duplicated seed')
+        seen_seeds.add(row['gameSeed'])
+        results[slot['player']]['draw' if winner==2 else 'loss' if winner==slot['humanSeat'] else 'win']+=1
+    total=sum(results.values(),Counter())
+    n=len(plan['schedule'])
+    completed=total['win']+total['draw']+total['loss']
+    points=total['win']+0.5*total['draw']
+    # Fixed scheduled denominator. Missing games cannot improve the lower bound.
+    return dict(scheduled=n, completed=completed, counts=total, byPlayer=results,
+                possibleRosterScore=[points/n,(points+n-completed)/n],
+                completedRosterScore=points/n if completed==n else None,
+                # One-sided bounded-outcome concentration for the scheduled games.
+                # Describes this panel under fresh draws, not all top SAP players.
+                lower95ForScheduledMean=max(0.,points/n-math.sqrt(math.log(20)/(2*n))) if completed==n else None)
+
+
+def main():
+    p=argparse.ArgumentParser(description=__doc__)
+    sub=p.add_subparsers(dest='command',required=True)
+    for command in ('create','play','score'):
+        s=sub.add_parser(command)
+        s.add_argument('folder',type=Path)
+        if command!='create':
+            s.add_argument('digest')
+        if command!='score':
+            s.add_argument('--release',required=True,type=Path)
+        if command=='create':
+            s.add_argument('--roster',required=True,type=Path)
+            s.add_argument('--games-per-player',required=True,type=int)
+        if command=='play':
+            s.add_argument('--player',required=True)
+    args=p.parse_args()
+    if args.command=='create':
+        print(create(args.folder,json.loads(args.roster.read_text()),args.games_per_player,engine_identity(args.release)))
+    else:
+        plan=read_plan(args.folder,args.digest)
+        if args.command=='play':
+            raise SystemExit(play(args.folder,plan,args.digest,args.player,args.release))
+        print(json.dumps(score(args.folder,plan),indent=2))
+
+
+if __name__=='__main__':
+    main()
