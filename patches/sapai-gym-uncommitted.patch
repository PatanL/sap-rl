+#!/usr/bin/env bash
+# Run or resume the bounded league on a restored release workspace.
+set -eu
+if [ "$#" -ne 2 ]; then
+    echo 'Usage: bash run.sh RESTORED_RELEASE RUN_DIRECTORY' >&2
+    exit 2
+fi
+release=$(realpath "$1")
+test -f "$release/runs/direct-opening-exploration-20260918-v1/train_runtime.py"
+test -f "$release/runs/ordinary-rl-shared-20260924-v2/outputs/chunk-20/update-025772.pt"
+mkdir -p "$2"
+job=$(realpath "$2")
+code=$(cd "$(dirname "$0")" && pwd)
+name="sap-loop-$(basename "$job")"
+if docker container inspect "$name" >/dev/null 2>&1; then
+    for entry in "/workspace:$release" "/job:$job" "/loop:$code"; do
+        dest=${entry%%:*}
+        expected=${entry#*:}
+        actual=$(docker inspect -f "{{range .Mounts}}{{if eq .Destination \"$dest\"}}{{.Source}}{{end}}{{end}}" "$name")
+        if [ "$actual" != "$expected" ]; then
+            echo "Existing container $name points to a different $dest." >&2
+            exit 1
+        fi
+    done
+    if [ "$(docker inspect -f '{{.State.Running}}' "$name")" = true ]; then
+        echo "$name is running"
+        exit 0
+    fi
+    exec docker start "$name"
+fi
+exec docker run -d --name "$name" --gpus all --network none \
+    --cpus 4 --memory 12g --memory-swap 12g --shm-size 1g --user "$(id -u):$(id -g)" \
+    -e OMP_NUM_THREADS=1 -e OPENBLAS_NUM_THREADS=1 -e MKL_NUM_THREADS=1 \
+    -e PYTHONUNBUFFERED=1 -e PYTHONDONTWRITEBYTECODE=1 -e TORCH_ALLOW_TF32_CUBLAS_OVERRIDE=0 \
+    -e PYTHONPATH=/workspace/runs/claude-end-positioner-20261112-v1 \
+    -v "$release:/workspace:ro" -v "$code:/loop:ro" -v "$job:/job" \
+    --entrypoint python "${SAP_MATCH_IMAGE:-sap-rl-shared:research-25772}" /loop/loop.py
