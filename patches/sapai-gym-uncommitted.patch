+#!/usr/bin/env bash
+# Usage: bash run_matched_play.sh RESTORED_RELEASE_DIRECTORY HUMAN_SEAT RECEIPT_DIRECTORY
+set -eu
+if [ "$#" -ne 3 ]; then
+    echo 'Expected a restored release directory, human seat (0 or 1), and a receipt directory.' >&2
+    exit 2
+fi
+release_dir=$(realpath "$1")
+seat=$2
+case "$seat" in 0|1) ;; *) echo 'Human seat must be 0 or 1.' >&2; exit 2 ;; esac
+test -f "$release_dir/runs/ordinary-rl-shared-20260924-v2/outputs/chunk-20/update-025772.pt"
+test -f "$release_dir/runs/claude-end-positioner-20261112-v1/plan_common.py"
+script_dir=$(cd "$(dirname "$0")" && pwd)
+mkdir -p -- "$3"
+receipt_dir=$(realpath "$3")
+exec docker run --rm -it --network none --gpus all --cpus 4 --memory 8g --memory-swap 8g \
+    --user "$(id -u):$(id -g)" -e OMP_NUM_THREADS=1 -e OPENBLAS_NUM_THREADS=1 \
+    -e SAP_SERIES_DIGEST -e SAP_SERIES_SLOT \
+    -e PYTHONDONTWRITEBYTECODE=1 -e TORCH_ALLOW_TF32_CUBLAS_OVERRIDE=0 \
+    -e PYTHONPATH=/workspace/runs/claude-end-positioner-20261112-v1 \
+    -v "$release_dir:/workspace:ro" -v "$script_dir:/out:ro" -v "$receipt_dir:/receipts" \
+    --entrypoint python "${SAP_MATCH_IMAGE:-sap-rl-shared}" /out/matched_play.py \
+    --human-seat "$seat" --receipt-dir /receipts --mode "${SAP_MATCH_MODE:-raw}"
