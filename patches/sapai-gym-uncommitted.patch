@@ -0,0 +1,77 @@
+"""Audit a completed positioning-training trial using matched world seeds.
+
+Report the change in relative match score between search on for both policies
+and search off for both. This is an evaluation-mode interaction, not an
+attribution to any specific pet purchase.
+"""
+import argparse
+from collections import Counter
+import hashlib
+import json
+from pathlib import Path
+
+import numpy as np
+from plan_common import seed_of
+
+
+def interval(differences):
+    n=len(differences)
+    samples=np.random.default_rng(25772).choice(differences,(20000,n)).mean(1)
+    return np.quantile(samples,[.025,.975]).tolist()
+
+
+def audit(folder):
+    protocol=json.loads((folder/'protocol.json').read_text())
+    summary=json.loads((folder/'result.json').read_text())
+    history=json.loads((folder/'training.json').read_text())
+    if len(history)!=protocol['updates'] or any(
+        row['update']!=i or any(row['arms'][arm]['trained']!=protocol['batch']
+                                for arm in ('ordinary','assisted'))
+        for i,row in enumerate(history,1)):
+        raise ValueError('Incomplete or unbalanced training')
+    train_seeds={s for r in history for s in r['worlds']}
+    with (folder/'training.pt').open('rb') as stream:
+        checkpoint=hashlib.file_digest(stream,'sha256').hexdigest()
+    archived=folder/'learning-curve'/f"update-{len(history):03d}.json"
+    if archived.exists() and json.loads(archived.read_text())['sha256']!=checkpoint:
+        raise ValueError('Final snapshot differs from learning-curve snapshot')
+    modes=('same_public_planner','both_raw')
+    pairs={}
+    outcomes={}
+    seeds=[seed_of(protocol['namespace']+'-evaluation-world',i) for i in range(protocol['pairs'])]
+    if len(set(seeds))!=len(seeds) or set(seeds)&train_seeds:
+        raise ValueError('Evaluation seed collision')
+    for mode in modes:
+        game_scores=[]
+        if len(list(folder.glob(mode+'-*.json')))!=len(seeds)*2:
+            raise ValueError('Incomplete or unexpected match receipts')
+        for i,seed in enumerate(seeds):
+            for seat in (0,1):
+                row=json.loads((folder/f'{mode}-{i:03d}-{seat}.json').read_text())
+                if (row['world'],row['seat'],row['mode'],row['trainingSHA256'])!=(seed,seat,mode,checkpoint):
+                    raise ValueError('Wrong seed, seat, condition or frozen policy')
+                if row['score'] not in (0,.5,1):
+                    raise ValueError('Invalid terminal score')
+                game_scores.append(row['score'])
+        scores=np.array(game_scores).reshape(-1,2).mean(1)
+        if scores.mean()!=summary[mode]['assistedTrainedScore'] or interval(scores)!=summary[mode]['paired95']:
+            raise ValueError('Recomputed paired estimate disagrees with summary')
+        pairs[mode]=scores
+        counts=Counter(game_scores)
+        outcomes[mode]=dict(wins=counts[1],draws=counts[.5],losses=counts[0],score=scores.mean(),
+                            paired95=interval(scores))
+    gain=pairs[modes[0]]-pairs[modes[1]]
+    return dict(checkpoint=checkpoint,independentWorlds=len(seeds),
+                decisionsPerArm=protocol['batch']*protocol['updates'],outcomes=outcomes,
+                relativeScoreWithMinusWithoutPlanner=dict(change=gain.mean(),paired95=interval(gain)))
+
+
+if __name__=='__main__':
+    parser=argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('run',type=Path)
+    args=parser.parse_args()
+    report=audit(args.run)
+    tmp=args.run/'paired-audit.partial'
+    tmp.write_text(json.dumps(report,indent=2))
+    tmp.replace(args.run/'paired-audit.json')
+    print(json.dumps(report))
diff --git a/research/selfplay/population_league.py b/research/selfplay/population_league.py
new file mode 100644
index 0000000..45ebb7c
--- /dev/null
+++ b/research/selfplay/population_league.py
@@ -0,0 +1,149 @@
+"""Train against distinct frozen AI responses and test one preselected finalist."""
+import fcntl
+import os
+from pathlib import Path
+import sys
+
+from loop import OUT, PARENT, PARENT_SHA, SOURCE, read, run_logged, save, sha
+
+
+METHOD = Path(__file__).resolve().parent
+MILESTONES = (384, 1024)
+NAMESPACE = 'sap-response-population-25772-v1'
+
+
+def command(folder, residents):
+    ordinary = OUT/'inputs/ordinary-command.json'
+    if sha(ordinary) != '3e56d3f33eed71b60bc587f1fa8602b46fb8ac55f3470dece3484b032ce609df':
+        raise ValueError('Unexpected reference league recipe')
+    args = read(ordinary)
+    args[:2] = [sys.executable, str(METHOD/'train_stage.py')]
+    for key, value in {'--updates':MILESTONES[-1], '--max-historical-residents':2,
+                       '--seed':257720311, '--checkpoint-dir':folder}.items():
+        args[args.index(key)+1] = str(value)
+    for name in residents:
+        args.extend(['--resident-checkpoint', str(OUT/'residents'/(name+'.pt'))])
+    return args
+
+
+def train():
+    import torch
+    folder = OUT/'training'
+    folder.mkdir(exist_ok=True)
+    receipt = read(OUT/'residents/receipt.json')
+    residents = receipt['residents']
+    if sha(PARENT) != PARENT_SHA or receipt['parent'] != PARENT_SHA or set(residents) != {'terminal-response','strategy'}:
+        raise ValueError('Unexpected population or initial policy')
+    if any(sha(OUT/'residents'/(name+'.pt')) != h for name,h in residents.items()):
+        raise ValueError('Resident weights changed')
+    args = command(folder, residents)
+    protocol = dict(parent=PARENT_SHA, residents=residents, milestones=list(MILESTONES), command=args,
+                    trainingSource=sha(SOURCE/'train_runtime.py'),
+                    methods={p.name:sha(p) for p in METHOD.glob('*.py')},
+                    developmentPairs=96, finalConfirmationPairs=320, historicalTransferPairs=64)
+    if (OUT/'protocol.json').exists() and read(OUT/'protocol.json') != protocol:
+        raise ValueError('Run configuration changed')
+    save(OUT/'protocol.json', protocol)
+    league_path = folder/'league.json'
+    completed = 0
+    if league_path.exists():
+        league = read(league_path)
+        historical = [m for m in league['members'] if m['role']=='historical']
+        if historical:
+            last = max(historical, key=lambda m:m['created_step'])
+            ck_path = Path(last['checkpoint'])
+            ck = torch.load(ck_path, map_location='cpu', weights_only=True, mmap=True)
+            completed = ck['update']
+            if (ck_path != folder/f'update-{completed:06d}.pt' or ck['transitions'] != last['created_step']
+                    or not ck['optimizer']['state'] or ck['privileged_replay'] is not None):
+                raise ValueError('Incomplete native league checkpoint')
+            del ck
+            index = args.index('--init-checkpoint')
+            args = [*args[:index], '--resume-checkpoint', str(ck_path)]
+    if completed < MILESTONES[-1]:
+        env = dict(os.environ, SAP_TRAIN_SOURCE=str(SOURCE),
+                   PYTHONPATH=f'{SOURCE}/source/sapai:{SOURCE}/source/sapai-gym')
+        from tempfile import NamedTemporaryFile
+        with NamedTemporaryFile(dir=OUT, prefix=f'train-from-{completed:06d}-', suffix='.log', delete=False) as f:
+            log = Path(f.name)
+        print('training from update', completed, 'see', log, flush=True)
+        run_logged(args, log, env)
+    league = read(league_path)
+    games = {m['member_id']:len(league['results'].get('main|'+m['member_id'], []))
+             for m in league['members'] if m['role']=='exploiter'}
+    if len(games) != 3 or min(games.values()) == 0:
+        raise ValueError('Expected all three fixed residents to participate')
+    checkpoints = {}
+    for step in MILESTONES:
+        p = folder/f'update-{step:06d}.pt'
+        ck = torch.load(p, map_location='cpu', weights_only=True, mmap=True)
+        if (ck['update'] != step or ck['privileged_replay'] is not None or not ck['optimizer']['state']
+                or not all(v.isfinite().all().item() for v in ck['model'].values())):
+            raise ValueError('Invalid training milestone')
+        checkpoints[str(step)] = dict(path=str(p), sha=sha(p), decisions=ck['transitions'])
+        del ck
+    save(OUT/'trained.json', dict(checkpoints=checkpoints, recordedResidentMatches=games))
+
+
+def evaluate():
+    import numpy as np
+    import torch
+    from crossplay import PrimitiveResident, RESIDENTS, gain, paired_differences
+    from plan_common import install, load_actor, seed_of
+    from score import panel
+    install(cuda=True)
+    torch.cuda.set_per_process_memory_fraction(min(1., 6*1024**3/torch.cuda.get_device_properties(0).total_memory))
+    protocol = read(OUT/'protocol.json')
+    checkpoints = read(OUT/'trained.json')['checkpoints']
+    parent = load_actor(dict(path=str(PARENT), sha=PARENT_SHA), device='cuda').model
+    folder = OUT/'eval'
+    folder.mkdir(exist_ok=True)
+    def play(label, left, right, hashes, part, pairs):
+        namespace = NAMESPACE+'-'+part
+        path = folder/(label+'.json')
+        identity = dict(hashes=hashes, namespace=namespace, pairs=pairs, protocol=sha(OUT/'protocol.json'))
+        if not path.exists():
+            save(path, dict(identity=identity, result=panel(left, right, namespace, pairs)))
+        receipt = read(path)
+        if receipt['identity'] != identity:
+            raise ValueError('Different opponent or seed panel')
+        result = receipt['result']
+        seeds = [seed_of(namespace,i) for i in range(pairs)]
+        paired_differences(result['games'], result['games'], seeds)
+        if result['score'] != float(np.mean([r[2] for r in result['games']])):
+            raise ValueError('Invalid match summary')
+        return result
+    monitoring = {}
+    for step in MILESTONES:
+        ck = checkpoints[str(step)]
+        candidate = load_actor(dict(path=ck['path'], sha=ck['sha']), device='cuda').model
+        hashes = [ck['sha'], PARENT_SHA]
+        result = play(f'development-{step}', candidate, parent, hashes, 'development', protocol['developmentPairs'])
+        monitoring[str(step)] = dict(score=result['score'], paired95=result['paired95'], decisions=ck['decisions'])
+    confirmation = None
+    if result['score'] > .5:
+        confirm = play('final-confirmation', candidate, parent, hashes, 'final-confirmation', protocol['finalConfirmationPairs'])
+        confirmation = dict(score=confirm['score'], paired95=confirm['paired95'])
+    pairs = protocol['historicalTransferPairs']
+    transfer = {}
+    deltas = []
+    for name in RESIDENTS:
+        resident = PrimitiveResident(name)
+        arms = [play('transfer-'+name+'-'+arm, model, resident, [h,RESIDENTS[name]], 'transfer', pairs)
+                for arm, model, h in [('parent',parent,PARENT_SHA), ('final',candidate,ck['sha'])]]
+        seeds = [seed_of(NAMESPACE+'-transfer',i) for i in range(pairs)]
+        delta = paired_differences(arms[1]['games'], arms[0]['games'], seeds)
+        deltas.append(delta)
+        transfer[name] = dict(parent=arms[0]['score'], candidate=arms[1]['score'], **gain(delta))
+    transfer['average'] = gain(np.mean(deltas,axis=0))
+    advances = bool(confirmation and confirmation['paired95'][0]>.5 and transfer['average']['scoreChange']>=0
+                    and all(transfer[n]['paired95'][1]>=0 for n in RESIDENTS))
+    save(OUT/'result.json', dict(parent=PARENT_SHA, candidate=ck['sha'], monitoring=monitoring,
+                                confirmation=confirmation, transfer=transfer, passedAIComparison=advances))
+
+
+if __name__ == '__main__':
+    lock = (OUT/'run.lock').open('a')
+    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+    train()
+    evaluate()
diff --git a/research/selfplay/population_residents.py b/research/selfplay/population_residents.py
new file mode 100644
index 0000000..655131d
--- /dev/null
+++ b/research/selfplay/population_residents.py
@@ -0,0 +1,108 @@
+"""Package two self-play challengers as frozen residents of the v30 league."""
+import copy
+from dataclasses import replace
+import json
+from pathlib import Path
+
+import numpy as np
+import torch
+from loop import PARENT, PARENT_SHA, read, save, sha
+from plan_common import install, load_actor
+
+
+DELTA_SHA = 'c389870a0d1d7b07ed2ba570d8529b306ca386f49d99f541277f16f921ec1361'
+OFFSET_SHA = '79808d255447979ae7e17b314b6860a9be9fdd70d838dea34b17516fbdc42d0f'
+HEADS = ('type_head.', 'source_query.', 'source_key.', 'target_query.', 'target_key.',
+         'action_type_embedding.', 'end_freeze_head.', 'no_target_embedding', 'no_source_embedding')
+
+
+@torch.inference_mode()
+def check(parent, residents, offset, histories):
+    histories = [read(path)['publicHistory'] for path in histories]
+    memory = parent.initial_memory(len(histories), 'cpu')
+    changed = {name:0 for name in residents}
+    decisions = 0
+    max_error = 0.
+    for t in range(max(map(len, histories))):
+        active = [i for i,h in enumerate(histories) if t < len(h)]
+        rows = [histories[i][t] for i in active]
+        obs = {k:torch.from_numpy(np.stack([np.array(r[k]['data'], dtype=r[k]['dtype']) for r in rows]))
+               for k in rows[0]}
+        f = parent.encode_decision(obs, memory[active], forecast=False)
+        base = parent.sample_joint_action(f, deterministic=True)
+        expected = parent.sample_joint_action(replace(f, context=f.context + offset), deterministic=True)
+        for name, model in residents.items():
+            features = model.encode_decision(obs, memory[active], forecast=False)
+            if not torch.equal(features.memory, f.memory):
+                raise ValueError('A frozen decoder change altered recurrent memory')
+            actual = model.sample_joint_action(features, deterministic=True)
+            if name == 'strategy':
+                error = (features.context - (f.context + offset)).abs().max().item()
+                max_error = max(max_error, error)
+                if error > 1e-4 or not (torch.equal(actual.actions, expected.actions)
+                                        and torch.equal(actual.end_freeze_mask, expected.end_freeze_mask)):
+                    raise ValueError('Native strategy resident changed a replayed choice')
+            changed[name] += int(((base.actions != actual.actions).any(1) |
+                                  (base.end_freeze_mask != actual.end_freeze_mask)).sum())
+        memory[active] = f.memory
+        decisions += len(rows)
+    if not all(changed.values()):
+        raise ValueError('Expected both residents to differ from the parent on public histories')
+    return dict(decisions=decisions, changedChoices=changed, maxStrategyContextError=max_error)
+
+
+def prepare(folder, inputs):
+    install(cuda=False)
+    torch.set_num_threads(1)
+    torch.backends.mha.set_fastpath_enabled(False)
+    paths = [inputs/'challenger.pt', inputs/'candidate.npy']
+    if [sha(p) for p in paths] != [DELTA_SHA, OFFSET_SHA] or sha(PARENT) != PARENT_SHA:
+        raise ValueError('Unexpected parent or challenger source')
+    histories = sorted(inputs.glob('game-*-seat-*.json'))
+    if len(histories) != 4:
+        raise ValueError('Expected four self-play histories for the native resident check')
+    parent = load_actor(device='cpu').model
+    checkpoint = torch.load(PARENT, map_location='cpu', weights_only=True, mmap=True)
+    weights = torch.load(paths[0], map_location='cpu', weights_only=True)
+    offset = torch.from_numpy(np.load(paths[1], allow_pickle=False))
+    head_names = {k for k,_ in parent.named_parameters() if k.startswith(HEADS)}
+    if weights['parent'] != PARENT_SHA or set(weights['updatedParameters']) != head_names:
+        raise ValueError('Wrong terminal-response head or lineage')
+    models = {name:copy.deepcopy(parent).eval() for name in ('terminal-response','strategy')}
+    models['terminal-response'].load_state_dict({**parent.state_dict(), **weights['updatedParameters']}, strict=True)
+    # This bias is the final operation of the context projection. Addition
+    # before the opponent adapter is equivalent up to FP32 roundoff.
+    with torch.no_grad():
+        models['strategy'].context_projection[-1].bias.add_(offset)
+    contract = check(parent, models, offset, histories)
+    folder.mkdir(exist_ok=True)
+    digests = {}
+    from sapai_gym1.rl.causal_transport import validate_checkpoint_context
+    for name,model in models.items():
+        payload = {key:checkpoint[key] for key in (
+            'config','simulator_revision','observation_revision','causal_context')}
+        payload.update(model=model.state_dict(), parent=PARENT_SHA)
+        path = folder/(name+'.pt')
+        if not path.exists():
+            tmp = path.with_suffix('.tmp')
+            torch.save(payload, tmp)
+            tmp.replace(path)
+        stored = torch.load(path, map_location='cpu', weights_only=True)
+        validate_checkpoint_context(stored)
+        if any(stored[k] != v for k,v in payload.items() if k != 'model') or (
+            stored['model'].keys() != payload['model'].keys() or
+            any(not torch.equal(v, stored['model'][k]) for k,v in payload['model'].items())
+        ):
+            raise ValueError('Frozen resident mismatch')
+        digests[name] = sha(path)
+    receipt = dict(parent=PARENT_SHA, terminalResponse=DELTA_SHA, strategyOffset=OFFSET_SHA,
+                   checks=contract, histories={p.name:sha(p) for p in histories}, residents=digests)
+    if (folder/'receipt.json').exists() and read(folder/'receipt.json') != receipt:
+        raise ValueError('Resident preparation differs on resume')
+    save(folder/'receipt.json', receipt)
+    return receipt
+
+
+if __name__ == '__main__':
+    import sys
+    print(json.dumps(prepare(Path(sys.argv[1]), Path(sys.argv[2])), indent=2))
diff --git a/research/selfplay/position_outcomes.py b/research/selfplay/position_outcomes.py
new file mode 100644
index 0000000..1a8d1e4
--- /dev/null
+++ b/research/selfplay/position_outcomes.py
@@ -0,0 +1,172 @@
+"""Learnable END-order targets from complete, unassisted AI self-play games.
+
+Candidate inputs are fixed before seeing either submitted battle board. After
+the round, score each candidate against the opponent that actually submitted,
+using common seeds and the original seat. Only the outcomes enter the dataset.
+"""
+import argparse
+import fcntl
+import json
+import random
+import time
+from pathlib import Path
+
+import numpy as np
+import torch
+from plan_common import CURRENT, install, load_actor, seed_of, sha
+from planner import TurnPlanner, safe_battle
+
+
+TAG = 'end-order-outcomes-25772-v1'
+GAMES = {'contract': 1, 'train': 128, 'validation': 32, 'test': 32}
+
+
+def board(team):
+    # Keep physical slots for moves. Encode only public effective stats.
+    return {'team': [dict(pet=dict(name=slot.pet.name, status=slot.pet.status,
+                                   level=slot.pet.level, attack=int(slot.pet.attack),
+                                   health=int(slot.pet.health))) for slot in team]}
+
+
+def encode_board(state):
+    from bp_common import encode
+    return [x.tolist() for x in encode(state)]
+
+
+def candidates(env, side, end, key):
+    from sapai_gym1.rl.action_schema import ActionType, AutoregressiveAction
+    from sapai_gym1.rl.joint_action import JointAction
+    from sapai_gym1.rl.rollout_search import PublicSearchState
+
+    view = PublicSearchState.from_core(env.core, side)
+    paths = TurnPlanner._order_paths(view.core, 0)
+    if len(paths) < 2:
+        return None
+    if paths[0]:
+        raise ValueError('Missing current order')
+    rng = random.Random(seed_of(*key, 'orders'))
+    paths = [paths[0], *rng.sample(paths[1:], min(5, len(paths)-1))]
+    base = board(view.core.agent.team)
+    inputs, submitted = [], []
+    for path in paths:
+        clone = view.clone()
+        clone.redeterminize(seed_of(*key, 'own-end'))
+        # The remaining shop-action budget must fit every MOVE and freeze
+        # toggle. The no-move path must always admit the sampled END.
+        try:
+            for a, b in path:
+                move = JointAction(AutoregressiveAction(ActionType.MOVE, a, b), 0)
+                TurnPlanner._apply(clone.core, 0, move)
+            TurnPlanner._apply(clone.core, 0, end)
+        except ValueError:
+            if not path:
+                raise
+            continue
+        inputs.append(encode_board(TurnPlanner._reordered(base, path)))
+        submitted.append(clone.core.agent.team)
+    if len(inputs) < 2:
+        return None
+    features = dict(turn=env.core.turn, side=side, opp=encode_board(board(view.core.previous_opponent_state)),
+                    orders=inputs)
+    return features, submitted
+
+
+def label(data, opponent, side, key):
+    features, teams = data
+    seeds = [seed_of(*key, 'fight', k) % (2**32) for k in range(4)]
+    targets = []
+    for team in teams:
+        pair = (team, opponent) if side == 0 else (opponent, team)
+        outcomes = [safe_battle(*pair, s) for s in seeds]
+        if None in outcomes:
+            raise RuntimeError('A counterfactual battle timed out')
+        targets.append(sum(.5 if r == 2 else float(r == side) for r in outcomes) / len(seeds))
+    return dict(**features, y=targets)
+
+
+@torch.inference_mode()
+def game(actor, split, i):
+    from sapai_gym1.rl.action_schema import AutoregressiveAction
+    from sapai_gym1.rl.joint_action import JointAction, step_decisions
+    from sapai_gym1.rl.selfplay_env import ParallelSelfPlayEnv
+    env = ParallelSelfPlayEnv()
+    world = seed_of(TAG, split, i)
+    env.reset(seed=world, paired_tape=True)
+    memory = actor.model.initial_memory(2, 'cpu')
+    pending = [None, None]
+    rows = []
+    for _ in range(2500):
+        turn = env.core.turn
+        sides = [s for s, active in enumerate(env.active_players()) if active]
+        obs = env.observations()
+        batch = {k: torch.from_numpy(np.stack([obs[s][k] for s in sides])) for k in obs[sides[0]]}
+        result = actor.model.act(batch, memory=memory[sides], deterministic=True)
+        actions = [None, None]
+        for j, s in enumerate(sides):
+            action = JointAction(AutoregressiveAction(*result.actions[j].tolist()), int(result.end_freeze_mask[j]))
+            actions[s] = action
+            memory[s] = result.memory[j]
+            if turn > 1 and action.action_type == 0:
+                pending[s] = candidates(env, s, action, (world, turn, s))
+        step = step_decisions(env, actions).result
+        if step.battle_resolved:
+            for side, data in enumerate(pending):
+                if data is not None:
+                    opponent = (env.core.previous_opponent_state if side == 0 else env.core.previous_agent_state)
+                    rows.append(label(data, opponent, side, (world, turn, side)))
+            pending = [None, None]
+        if step.terminated:
+            return dict(world=world, rows=rows)
+    raise RuntimeError('Incomplete self-play game')
+
+
+def write(path, value):
+    tmp = path.with_suffix('.tmp')
+    tmp.write_text(json.dumps(value, separators=(',', ':'), allow_nan=False))
+    tmp.replace(path)
+
+
+def run(folder, split):
+    install(cuda=False)
+    torch.set_num_threads(1)
+    torch.backends.mha.set_fastpath_enabled(False)
+    actor = load_actor(device='cpu')
+    path = folder / split
+    path.mkdir(parents=True, exist_ok=True)
+    lock = (path / 'collection.lock').open('a')
+    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+    spec = dict(parent=CURRENT['sha'], split=split, games=GAMES[split], namespace=TAG,
+                source=sha(__file__), candidates=6, seeds=4)
+    if (path / 'protocol.json').exists() and json.loads((path / 'protocol.json').read_text()) != spec:
+        raise ValueError('Incompatible data collection protocol')
+    write(path / 'protocol.json', spec)
+    identity = sha(path / 'protocol.json')
+    roots = informative = battles = 0
+    for i in range(GAMES[split]):
+        dest = path / f'game-{i:03d}.json'
+        if dest.exists():
+            receipt = json.loads(dest.read_text())
+            if (receipt['world'], receipt['protocol']) != (seed_of(TAG, split, i), identity):
+                raise ValueError('Incompatible self-play game')
+        else:
+            start = time.monotonic()
+            receipt = game(actor, split, i)
+            receipt.update(protocol=identity, seconds=time.monotonic() - start)
+            write(dest, receipt)
+        roots += len(receipt['rows'])
+        informative += sum(max(r['y']) > min(r['y']) for r in receipt['rows'])
+        battles += sum(len(r['y']) * spec['seeds'] for r in receipt['rows'])
+        if (i + 1) % 8 == 0 or i + 1 == GAMES[split]:
+            print(split, i + 1, 'games', roots, 'decisions', informative, 'with differing outcomes', flush=True)
+    if not informative:
+        raise ValueError('No varying counterfactual targets')
+    write(path / 'summary.json', dict(protocol=identity, games=GAMES[split], decisions=roots,
+                                      nonconstant=informative, battles=battles))
+
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('folder', type=Path)
+    parser.add_argument('split', choices=GAMES)
+    args = parser.parse_args()
+    run(args.folder, args.split)
diff --git a/research/selfplay/position_trial.py b/research/selfplay/position_trial.py
new file mode 100644
index 0000000..b9ffd82
--- /dev/null
+++ b/research/selfplay/position_trial.py
@@ -0,0 +1,215 @@
+"""Matched shopper learning, with and without a fixed public END positioner."""
+import argparse
+import copy
+import fcntl
+import hashlib
+import json
+import math
+import multiprocessing as mp
+import os
+from pathlib import Path
+import random
+import time
+
+import numpy as np
+import torch
+from check_assisted_end import collect, verify_likelihood
+from plan_common import install, load_actor, seed_of
+from public_opponent import PublicOpponentPlanner
+from public_panel import CONFIG, MatchBattleScorer
+
+
+ARMS = ('ordinary','assisted')
+TAG = 'sap-public-END-shopping-ab-v1'
+
+
+def write(path, data):
+    tmp = path.with_suffix('.partial')
+    tmp.write_text(json.dumps(data, indent=2, allow_nan=False))
+    tmp.replace(path)
+
+
+def select_turns(segments, target, seed):
+    """Select exactly target decisions, preserving each complete turn and its reward."""
+    indices = list(range(len(segments)))
+    random.Random(seed).shuffle(indices)
+    # Subset sum uses lengths and a fixed shuffle only. It never inspects
+    # purchases, returns, opponent identity, or which turns were reordered.
+    paths = {0: None}
+    for i in indices:
+        length = len(segments[i].transitions)
+        if not length:
+            raise ValueError('Empty turn')
+        for n in sorted(paths, reverse=True):
+            total = n+length
+            if total <= target and total not in paths:
+                paths[total] = n,i
+        if target in paths:
+            selected = []
+            total = target
+            while total:
+                total,i = paths[total]
+                selected.append(segments[i])
+            return selected
+    return None
+
+
+def planner(actor, scorer, seed):
+    return getattr(scorer, "planner_type", PublicOpponentPlanner)(actor,scorer,CONFIG,seed)
+
+
+def train(args,actor,scorer):
+    from sapai_gym1.rl.training import learner_update
+    device = next(actor.model.parameters()).device
+    models = {arm:copy.deepcopy(actor.model).requires_grad_(True) for arm in ARMS}
+    optim = {arm:torch.optim.AdamW(models[arm].parameters(),lr=2e-6) for arm in ARMS}
+    state_path=args.output/'training.pt'
+    history = []
+    if state_path.exists():
+        state=torch.load(state_path,map_location='cpu',weights_only=True)
+        if state['parent']!=actor.owner or state['protocol']!=args.protocol:
+            raise ValueError('Stored training snapshot belongs to a different run')
+        for arm in ARMS:
+            models[arm].load_state_dict(state[arm]['model'])
+            optim[arm].load_state_dict(state[arm]['optimizer'])
+        history=state['history']
+        del state
+    for update in range(len(history)+1,args.updates+1):
+        started=time.monotonic()
+        for model in models.values():
+            model.eval()
+        turns={arm:[] for arm in ARMS}
+        games={arm:[] for arm in ARMS}
+        changed_segments={arm:set() for arm in ARMS}
+        selected={}
+        # Pair games before checking the budget to give the two arms the same
+        # worlds, seats and opponents. Rotate a released and two evolving players.
+        for index in range(64):
+            common=(update-1)*64+index
+            opponent=(actor.model,models['ordinary'],actor.model,models['assisted'])[(index+update-1)%4]
+            for arm in ARMS:
+                helper=planner(actor,scorer,seed_of(TAG,'train-planner',common)) if arm=='assisted' else None
+                s,stats=collect(models[arm],opponent,helper,common,namespace=args.namespace+'-train',
+                                collection_actor=getattr(scorer,'collection_actor',None))
+                changed_segments[arm].update(id(s[j]) for j in stats['changedTurnIndices'])
+                turns[arm].extend(s)
+                games[arm].append(stats)
+            if index%2==0:
+                continue
+            selected={arm:select_turns(turns[arm],args.batch,seed_of(TAG,'segments',update)) for arm in ARMS}
+            if all(s is not None for s in selected.values()):
+                break
+        else:
+            raise RuntimeError('Could not form two decision-matched complete-turn batches')
+        receipts={}
+        for arm in ARMS:
+            batch=selected[arm]
+            likelihood_error=verify_likelihood(models[arm],batch) if update==1 else None
+            metrics=learner_update(models[arm],optim[arm],batch,device,use_bfloat16=False,lean_bootstrap=True)
+            if metrics.transitions!=args.batch or not math.isfinite(metrics.total_loss):
+                raise ValueError('Invalid matched learner update')
+            receipts[arm]=dict(trained=metrics.transitions,loss=metrics.total_loss,logProbError=likelihood_error,
+                               collected=sum(g['decisions'] for g in games[arm]),
+                               purchases=sum(t.action[0].item() in (2,3) for s in batch for t in s.transitions),
+                               plannerMoves=sum(g['plannerMoves'] for g in games[arm]),
+                               collectedAssistedTurnsWithPurchase=sum(g['assistedTurnsWithPurchase'] for g in games[arm]),
+                               assistedTurnsWithPurchase=sum(id(s) in changed_segments[arm] and
+                                   any(int(t.action[0]) in (2,3) for t in s.transitions) for s in batch),
+                               endStepSeconds=sum(g['endStepSeconds'] for g in games[arm]))
+        assert [g['world'] for g in games['ordinary']]==[g['world'] for g in games['assisted']]
+        history.append(dict(update=update,gamesPerArm=len(games['ordinary']),seconds=time.monotonic()-started,
+                            worlds=[g['world'] for g in games['ordinary']],arms=receipts))
+        state=dict(parent=actor.owner,protocol=args.protocol,history=history)
+        for arm in ARMS:
+            state[arm]=dict(model=models[arm].state_dict(),optimizer=optim[arm].state_dict())
+        tmp=state_path.with_suffix('.tmp')
+        torch.save(state,tmp)
+        tmp.replace(state_path)
+        write(args.output/'training.json',history)
+        print('update',update,'decisions per arm',args.batch*update,'planner moves',receipts['assisted']['plannerMoves'],flush=True)
+    if not any(h['arms']['assisted']['assistedTurnsWithPurchase'] for h in history):
+        raise ValueError('No opportunity for the hypothesized training effect')
+    for m in models.values():
+        m.eval().requires_grad_(False)
+    return models
+
+
+def compare(args,actor,scorer,models):
+    results={}
+    with (args.output/'training.pt').open('rb') as stream:
+        trained_hash=hashlib.file_digest(stream,'sha256').hexdigest()
+    for mode in ('same_public_planner','both_raw'):
+        rows=[]
+        for i in range(args.pairs):
+            for seat in (0,1):
+                path=args.output/f'{mode}-{i:03d}-{seat}.json'
+                word=args.namespace+'-evaluation'
+                if path.exists():
+                    row=json.loads(path.read_text())
+                    if (row['world'],row['seat'],row['mode'],row['trainingSHA256'])!=(
+                            seed_of(word+'-world',i),seat,mode,trained_hash):
+                        raise ValueError('Resume record mismatch')
+                else:
+                    planners=[None,None]
+                    if mode=='same_public_planner':
+                        planners=[planner(actor,scorer,seed_of(TAG,'eval-planner',i,s)) for s in (0,1)]
+                    _,row=collect(models['assisted'],models['ordinary'],planners[seat],2*i+seat,
+                                   world_index=i,namespace=word,greedy=True,opponent_planner=planners[1-seat],
+                                   collection_actor=getattr(scorer,'collection_actor',None))
+                    row.update(mode=mode,trainingSHA256=trained_hash)
+                    write(path,row)
+                rows.append(row)
+            print('evaluation',mode,'pairs',i+1,flush=True)
+        scores=np.array([(a['score']+b['score'])/2 for a,b in zip(rows[::2],rows[1::2])])
+        boot=np.random.default_rng(25772).choice(scores,(20000,len(scores))).mean(1)
+        results[mode]=dict(assistedTrainedScore=scores.mean(),pairs=args.pairs,
+                           paired95=np.quantile(boot,[.025,.975]).tolist())
+    write(args.output/'result.json',results)
+    print(json.dumps(results),flush=True)
+
+
+def main():
+    p=argparse.ArgumentParser(description=__doc__)
+    p.add_argument('--output',required=True,type=Path)
+    p.add_argument('--device',choices=('cpu','cuda'),default='cuda')
+    p.add_argument('--backend',choices=('auto','reference','compact','native'),default=os.environ.get('SAP_SCORER','auto'))
+    p.add_argument('--rollout-width',type=int,choices=(8,64),default=int(os.environ.get('SAP_ROLLOUT_WIDTH','8')))
+    p.add_argument('--contract',action='store_true',help='Separate tiny interface check; no strength conclusion')
+    args=p.parse_args()
+    args.updates,args.batch,args.pairs=(1,64,1) if args.contract else (32,512,32)
+    args.namespace=TAG+('-smoke' if args.contract else '')
+    args.output.mkdir(exist_ok=True,parents=True)
+    lock=(args.output/'trial.lock').open('a')
+    fcntl.flock(lock,fcntl.LOCK_EX|fcntl.LOCK_NB)
+    here=Path(__file__).resolve().parent
+    from inspect import getfile
+    files=[here/'position_trial.py',here/'check_assisted_end.py',here/'assisted_end.py',
+           Path(getfile(PublicOpponentPlanner)),Path(getfile(MatchBattleScorer))]
+    args.protocol=dict(namespace=args.namespace,updates=args.updates,batch=args.batch,pairs=args.pairs,
+                       device=args.device,sources={f.name:hashlib.sha256(f.read_bytes()).hexdigest() for f in files})
+    from scorer_backend import select_backend
+    from native_scorer import NativeScorer
+    planner_dir=Path(getfile(NativeScorer)).parent
+    for filename in ('scorer_backend.py','native_scorer.py','prepared_scorer.py','compact_scorer.py',
+                     'fast_public_planner.py','graph_actor.py','native/battle.rs'):
+        args.protocol['sources'][filename]=hashlib.sha256((planner_dir/filename).read_bytes()).hexdigest()
+    protocol_path=args.output/'protocol.json'
+    install(cuda=False)
+    with mp.get_context('fork').Pool(3 if args.device=='cuda' else 1) as pool:
+        if args.device=='cuda':
+            install(cuda=True)
+            torch.cuda.set_per_process_memory_fraction(.05)
+        else:
+            torch.set_num_threads(1)
+            torch.backends.mha.set_fastpath_enabled(False)
+        scorer,args.protocol['backend']=select_backend(args.backend,pool,args.rollout_width)
+        if protocol_path.exists() and json.loads(protocol_path.read_text())!=args.protocol:
+            raise ValueError('Output directory contains a different experiment')
+        write(protocol_path,args.protocol)
+        actor=load_actor(device=args.device)
+        models=train(args,actor,scorer)
+        compare(args,actor,scorer,models)
+
+
+if __name__=='__main__':
+    main()
diff --git a/research/selfplay/preserve_trial.py b/research/selfplay/preserve_trial.py
new file mode 100644
index 0000000..3eddb2e
--- /dev/null
+++ b/research/selfplay/preserve_trial.py
@@ -0,0 +1,72 @@
+"""Keep matched learning-curve checkpoints without changing a running trial.
+
+The training process atomically replaces training.pt after each paired update.
+Hard-link its published inode and verify the embedded update before retaining
+it. No source checkpoint or training record is modified.
+"""
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import tempfile
+import time
+
+import torch
+
+
+def digest(path):
+    with path.open('rb') as stream:
+        return hashlib.file_digest(stream,'sha256').hexdigest()
+
+
+def preserve(folder, milestones):
+    protocol=json.loads((folder/'protocol.json').read_text())
+    if any(t<1 or t>protocol['updates'] for t in milestones):
+        raise ValueError('Milestone outside the training protocol')
+    archive=folder/'learning-curve'
+    archive.mkdir(exist_ok=True)
+    for target in sorted(set(milestones)):
+        checkpoint=archive/f'update-{target:03d}.pt'
+        if not checkpoint.exists():
+            while True:
+                history_file=folder/'training.json'
+                if history_file.exists() and len(json.loads(history_file.read_text()))>=target:
+                    break
+                time.sleep(5)
+            with tempfile.TemporaryDirectory(prefix='snapshot-',dir=archive) as tmp:
+                captured=Path(tmp)/'captured.pt'
+                os.link(folder/'training.pt',captured)
+                state=torch.load(captured,map_location='cpu',mmap=True,weights_only=True)
+                if len(state['history'])!=target or state['protocol']!=protocol:
+                    raise RuntimeError(f'Missed or incompatible checkpoint {target}')
+                os.link(captured,checkpoint)
+                del state
+        state=torch.load(checkpoint,map_location='cpu',mmap=True,weights_only=True)
+        history=state['history']
+        if state['protocol']!=protocol or [h['update'] for h in history]!=list(range(1,target+1)):
+            raise ValueError('Invalid archived history')
+        for arm in ('ordinary','assisted'):
+            if any(h['arms'][arm]['trained']!=protocol['batch'] for h in history):
+                raise ValueError('Decision budgets differ')
+            steps={int(v['step']) for v in state[arm]['optimizer']['state'].values()}
+            if steps!={target}:
+                raise ValueError(f'Unexpected optimizer steps for {arm}: {steps}')
+        record=dict(parent=state['parent'],update=target,decisionsPerArm=target*protocol['batch'],
+                    sha256=digest(checkpoint))
+        receipt=checkpoint.with_suffix('.json')
+        if receipt.exists() and json.loads(receipt.read_text())!=record:
+            raise ValueError('Existing checkpoint receipt differs')
+        temp=receipt.with_suffix('.tmp')
+        temp.write_text(json.dumps(record,indent=2))
+        temp.replace(receipt)
+        print(record,flush=True)
+        del state
+
+
+if __name__=='__main__':
+    parser=argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('run',type=Path)
+    parser.add_argument('milestones',type=int,nargs='+')
+    args=parser.parse_args()
+    preserve(args.run,args.milestones)
diff --git a/research/selfplay/purchase_probe.py b/research/selfplay/purchase_probe.py
new file mode 100644
index 0000000..c1d13c6
--- /dev/null
+++ b/research/selfplay/purchase_probe.py
@@ -0,0 +1,125 @@
+"""Measure purchase preferences of both shoppers on identical public histories.
+
+Descriptive only. No outcomes, human actions, gradients, or checkpoint selection.
+Both networks reconstruct their own recurrent memory from the public prefix.
+"""
+import argparse
+from collections import Counter
+import copy
+import hashlib
+import json
+from pathlib import Path
+
+import numpy as np
+import torch
+from plan_common import install, load_actor
+
+
+def decode(model, obs, memory, buy):
+    feat = model.encode_decision(obs, memory, forecast=False)
+    action = model.sample_joint_action(feat,deterministic=True)
+    # Sum over legal destinations and normalize within BUY_PET. Keep this
+    # in log space so low absolute buy probability does not erase preferences.
+    log_mass = model.primitive_log_probabilities(feat)[:,buy,:10,:].logsumexp(-1)
+    legal_buy = obs['type_mask'][:,buy].bool()
+    if legal_buy.any() and not torch.isfinite(log_mass[legal_buy].logsumexp(-1)).all():
+        raise ValueError('Legal buy with no probability mass')
+    slot_probs = torch.zeros_like(log_mass)
+    slot_probs[legal_buy] = torch.softmax(log_mass[legal_buy],dim=-1)
+    return feat.memory, action.actions.tolist(), slot_probs.numpy()
+
+
+@torch.inference_mode()
+def run(run_dir, histories_dir, milestone):
+    install(cuda=False)
+    from sapai_gym1.rl.action_schema import ActionType, MAX_SHOP_SLOTS
+    from sapai_gym1.rl.entity_observation import MAX_TEAM_SLOTS
+    torch.set_num_threads(1)
+    torch.backends.mha.set_fastpath_enabled(False)
+    actor = load_actor(device='cpu')
+    source = run_dir/'learning-curve'/f'update-{milestone:03d}.pt'
+    receipt = json.loads(source.with_suffix('.json').read_text())
+    with source.open('rb') as f:
+        if hashlib.file_digest(f,'sha256').hexdigest()!=receipt['sha256']:
+            raise ValueError('Checkpoint differs from archive receipt')
+    state = torch.load(source,map_location='cpu',mmap=True,weights_only=True)
+    if state['parent']!=actor.owner or len(state['history'])!=milestone:
+        raise ValueError('Unexpected model lineage')
+    models = {}
+    for arm in ('ordinary','assisted'):
+        model=copy.deepcopy(actor.model)
+        model.load_state_dict(state[arm]['model'],strict=True)
+        models[arm]=model.eval()
+    files=sorted(histories_dir.glob('game-*-seat-*.json'))
+    if len(files)!=64:
+        raise ValueError('Expected the 64 archived self-play seat histories')
+    buy=int(ActionType.BUY_PET)
+    counts=Counter()
+    total_variation=0.
+    manifest=hashlib.sha256()
+    origins=set()
+    for start in range(0,len(files),8):
+        group=[]
+        for path in files[start:start+8]:
+            raw=path.read_bytes()
+            manifest.update(hashlib.sha256(raw).digest())
+            record=json.loads(raw)
+            origins.add(record['origin'])
+            group.append(record['publicHistory'])
+        memories={k:m.initial_memory(len(group),'cpu') for k,m in models.items()}
+        for t in range(max(map(len,group))):
+            active=[i for i,h in enumerate(group) if t<len(h)]
+            rows=[group[i][t] for i in active]
+            obs={k:torch.from_numpy(np.stack([np.asarray(r[k]['data'],dtype=r[k]['dtype']) for r in rows]))
+                 for k in rows[0]}
+            decoded={}
+            for k,model in models.items():
+                mem,actions,p=decode(model,obs,memories[k][active],buy)
+                memories[k][active]=mem
+                decoded[k]=actions,p
+            for j in range(len(active)):
+                counts['allDecisions']+=1
+                ids=obs['item_ids'][j,1+MAX_TEAM_SLOTS:1+MAX_TEAM_SLOTS+MAX_SHOP_SLOTS].numpy()
+                slots=obs['source_mask'][j,buy,:MAX_SHOP_SLOTS].numpy().astype(bool)
+                species=np.unique(ids[slots])
+                if not obs['type_mask'][j,buy] or len(species)<2:
+                    continue
+                counts['multiSpeciesBuyOpportunities']+=1
+                distributions=[]
+                choices=[]
+                for k in models:
+                    actions,p=decoded[k]
+                    mass=np.array([p[j,ids==item].sum() for item in species])
+                    if not np.isclose(mass.sum(),1.,atol=1e-5):
+                        raise ValueError('Species probability failed normalization')
+                    distributions.append(mass)
+                    action=actions[j]
+                    choices.append(int(ids[action[1]]) if action[0]==buy else None)
+                a,b=distributions
+                total_variation+=.5*float(abs(a-b).sum())
+                counts['differentMostLikelySpeciesGivenBuy']+=int(a.argmax()!=b.argmax())
+                counts['onlyOneGreedilyBuysPet']+=int((choices[0] is None)!=(choices[1] is None))
+                if None not in choices:
+                    counts['bothGreedilyBuyPet']+=1
+                    counts['differentSpeciesActuallyChosen']+=int(choices[0]!=choices[1])
+    if len(origins)!=32 or counts['multiSpeciesBuyOpportunities']==0:
+        raise ValueError('Unexpected comparison panel')
+    result=dict(update=milestone,checkpoint=receipt['sha256'],decisionsPerArm=receipt['decisionsPerArm'],
+                publicHistoryArchiveDigest=manifest.hexdigest(),origins=len(origins),counts=counts,
+                meanSpeciesTVGivenBuy=total_variation/counts['multiSpeciesBuyOpportunities'])
+    destination=source.with_name(f'purchase-probe-{milestone:03d}.json')
+    if destination.exists() and json.loads(destination.read_text())!=result:
+        raise ValueError('Existing result differs')
+    temp=destination.with_suffix('.tmp')
+    temp.write_text(json.dumps(result,indent=2,allow_nan=False))
+    temp.replace(destination)
+    print(json.dumps(result))
+
+
+if __name__=='__main__':
+    parser=argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('run_dir',type=Path)
+    parser.add_argument('history_dir',type=Path)
+    parser.add_argument('milestone',type=int)
+    args=parser.parse_args()
+    run(args.run_dir,args.history_dir,args.milestone)
