+"""Opponent-turn reconstruction for a new evaluation of simulated positioning.
+
+The only inputs transferred from the game are submitted boards, public
+scoreboard values, the turn and last match round result. Unknown shop upgrades
+and freezes have their default values. Temporary stat magnitudes are unknown;
+the frozen public-board hypothesis preserves effective totals.
+"""
+from types import SimpleNamespace
+
+import torch
+from planner import TurnPlanner
+
+
+class PublicOpponentPlanner(TurnPlanner):
+    def _position(self, env, side, end_joint):
+        """Run the entire END search inside a one-seat public reconstruction."""
+        from sapai_gym1.rl.rollout_search import PublicSearchState
+        if not self.cfg.position_only or not self.cfg.sim_opponent or any((
+                self.cfg.oracle,self.cfg.diag_oracle,self.cfg.sim_keep_frozen,
+                self.cfg.mix_prev,self.cfg.prev_as_sim,self.cfg.label_out)):
+            raise ValueError('Expected the fixed public positioning evaluation configuration')
+        if env.core.turn==1:
+            return None
+        state=PublicSearchState.from_core(env.core,side)
+        # The public projection assigns the acting player seat zero. Recover
+        # the previous battle outcome for the placeholder from the public result.
+        outcome=state.core.agent.last_battle_outcome
+        state.core.opponent.last_battle_outcome=None if outcome is None else -outcome
+        state.core.opponent.lf_winner=None if outcome is None else outcome<=0
+        return super()._position(state,0,end_joint)
+
+    def _public_clone(self, env, side):
+        clone=env.clone()
+        clone.redeterminize(self.rng.getrandbits(62))
+        return clone
+
+    def _simulated_opponent_boards(self, env, side, n, memory=None):
+        from sapai import Player, Shop
+        from sapai_gym1.rl.public_battle_board import sanitize
+
+        if self.cfg.sim_keep_frozen or self.cfg.sim_memory!='zeros':
+            raise ValueError('Public opponent reconstruction requires public inputs and zero opponent memory')
+        live=env.core
+        other=1-side
+        own_scores=self._player(live,side)
+        other_scores=self._player(live,other)
+        other_name='agent' if other==0 else 'opponent'
+        latest=getattr(live,'previous_'+other_name+'_state')
+        if latest is None:
+            return []
+        clones=[]
+        for core in self._public_shop_cores(live,n):
+            simulated_shop=Shop([],turn=live.turn-1,fixed_rules=True)
+            simulated_shop.fixed_rules=False
+            simulated_shop.enable_paired_tape(self.rng.getrandbits(62),other)
+            imagined=Player(team=sanitize(latest),shop=simulated_shop,lives=other_scores.lives,
+                            wins=other_scores.wins,turn=live.turn-1,lf_winner=other_scores.lf_winner,
+                            last_battle_outcome=other_scores.last_battle_outcome,record_actions=False)
+            core.turn=live.turn
+            unused=self._player(core,side)
+            unused.lives=own_scores.lives
+            unused.wins=own_scores.wins
+            setattr(core,other_name,imagined)
+            setattr(core,'team_'+other_name,imagined.team)
+            setattr(core,'shop_'+other_name,imagined.shop)
+            imagined.start_turn(winner=imagined.lf_winner)
+            setattr(core,'_seen_team_orders_'+other_name,{core._team_order_key(imagined)})
+            setattr(core,'_'+other_name+'_actions_cache',None)
+            clones.append(SimpleNamespace(core=core,encoder=env.encoder))
+        return self._finish_public_shops(clones,other)
+
+    def _public_shop_cores(self,live,n):
+        from sapai_gym1 import SuperAutoPetsEnv
+        from sapai_gym1.rl.public_battle_board import sanitize
+        for _ in range(n):
+            core=SuperAutoPetsEnv(opponent_generator=None,valid_actions_only=True,
+                                  manual_battles=True,initialization_seed=0)
+            for prefix in ('previous_', 'previous_previous_'):
+                for seat_name in ('agent','opponent'):
+                    attr=prefix+seat_name+'_state'
+                    setattr(core,attr,sanitize(getattr(live,attr)))
+            yield core
+
+    def _finish_public_shops(self,clones,other):
+        zero=[torch.zeros(self.actor.model.config.memory_dim) for _ in clones]
+        _,_,finals,done=self._lockstep(clones,zero,other,allow_roll=True,all_greedy=True)
+        return [board for board,complete in zip(finals,done) if complete]
