@@ -0,0 +1,192 @@
+"""Static FP32 inference for frozen, greedy opponent-shop rollouts."""
+
+import math
+import threading
+import warnings
+
+import torch
+
+
+def _choice(logits, mask):
+    masked = logits.masked_fill(~mask.bool(), torch.finfo(logits.dtype).min)
+    # Categorical.logits is normalized before the released actor's argmax.
+    normalized = masked - masked.logsumexp(dim=-1, keepdim=True)
+    return normalized.argmax(-1), mask.any(-1) & torch.isfinite(normalized).all(-1)
+
+
+class GreedyGraph:
+    def __init__(self, model, obs, memory):
+        from sapai_gym1.rl.action_schema import ActionType, MAX_SHOP_SLOTS, NO_TARGET, NUM_ACTION_TYPES
+        from sapai_gym1.rl.end_freeze import SHOP_ACTION_CAP
+        from sapai_gym1.rl.entity_observation import MAX_TEAM_SLOTS
+
+        if model.training or not model.config.end_freeze or model.config.causal_context_schema:
+            raise ValueError("Greedy CUDA graph requires the frozen public joint-action policy")
+        self.inputs = {k: v.clone() for k, v in obs.items()}
+        self.memory = memory.clone()
+        shop_type = torch.zeros(NUM_ACTION_TYPES, dtype=torch.bool, device=memory.device)
+        shop_type[list(model.SHOP_SOURCE_TYPES)] = True
+        bits = model.end_freeze_head.subsets.to(dtype=torch.float32, device=memory.device)
+        sizes = model.end_freeze_head.subset_sizes.to(memory.device)
+        # Graph replay retains device addresses, including these pre-capture allocations.
+        self.constants = (shop_type, bits, sizes)
+
+        def forward():
+            f = model.encode_decision(self.inputs, self.memory, forecast=False)
+            ctx, tok, inputs = f.context, f.tokens, self.inputs
+            batch = ctx.shape[0]
+            kind, valid = _choice(model.type_head(ctx), inputs["type_mask"])
+            teams = torch.cat(
+                (
+                    tok[:, 1 : 1 + MAX_TEAM_SLOTS],
+                    tok.new_zeros((batch, MAX_SHOP_SLOTS - MAX_TEAM_SLOTS, ctx.shape[1])),
+                ),
+                1,
+            )
+            shop = tok[:, 1 + MAX_TEAM_SLOTS : 1 + MAX_TEAM_SLOTS + MAX_SHOP_SLOTS]
+            srcs = torch.where(shop_type[kind, None, None], shop, teams)
+            srcs = torch.cat((srcs, model.no_source_embedding[None, None].expand(batch, 1, -1)), 1)
+            embedding = model.action_type_embedding(kind)
+            q = model.source_query(torch.cat((ctx, embedding), -1))
+            logits = torch.einsum("bd,bsd->bs", q, model.source_key(srcs)) / math.sqrt(
+                model.config.d_model
+            )
+            src, legal = _choice(logits, model._conditional_mask(inputs["source_mask"], kind))
+            valid = valid & legal
+            chosen = srcs.gather(1, src[:, None, None].expand(-1, 1, ctx.shape[1])).squeeze(1)
+            targets = torch.cat(
+                (
+                    tok[:, 1 : 1 + MAX_TEAM_SLOTS],
+                    model.no_target_embedding[None, None].expand(batch, 1, -1),
+                ),
+                1,
+            )
+            q = model.target_query(torch.cat((ctx, embedding, chosen), -1))
+            logits = torch.einsum("bd,btd->bt", q, model.target_key(targets)) / math.sqrt(
+                model.config.d_model
+            )
+            target, legal = _choice(logits, model._target_mask(inputs["target_mask"], kind, src))
+            valid = valid & legal
+            slot = model.end_freeze_head.scorer(
+                torch.cat((ctx[:, None].expand(-1, MAX_SHOP_SLOTS, -1), shop), -1)
+            ).squeeze(-1)
+            mask = inputs["target_mask"].bool()
+            eligible = (
+                mask[:, ActionType.FREEZE, :MAX_SHOP_SLOTS, NO_TARGET]
+                | mask[:, ActionType.UNFREEZE, :MAX_SHOP_SLOTS, NO_TARGET]
+            )
+            active = (
+                (kind == int(ActionType.END_TURN))
+                & (inputs["numeric"][:, 0, 11].abs() < 1e-8)
+                & inputs["type_mask"][:, ActionType.END_TURN].bool()
+            )
+            eligible = eligible & active[:, None]
+            counts = torch.round(inputs["numeric"][:, 0, 5].float() * SHOP_ACTION_CAP).long()
+            remaining = (SHOP_ACTION_CAP - counts).clamp(0, MAX_SHOP_SLOTS)
+            allowed = ((~eligible).float() @ bits.T == 0) & (sizes[None] <= remaining[:, None])
+            logits = (slot.float() @ bits.T).masked_fill(~allowed, -torch.inf)
+            freeze = (logits - logits.logsumexp(-1, keepdim=True)).argmax(-1)
+            valid = valid & torch.isfinite(slot).all(-1)
+            return torch.stack((kind, src, target, freeze, valid.long()), 1), f.memory
+
+        stream = torch.cuda.Stream(device=memory.device)
+        stream.wait_stream(torch.cuda.current_stream())
+        with torch.cuda.stream(stream):
+            for _ in range(3):
+                forward()
+        torch.cuda.current_stream().wait_stream(stream)
+        self.graph = torch.cuda.CUDAGraph()
+        with torch.cuda.graph(self.graph, stream=stream):
+            self.outputs = forward()
+        torch.cuda.current_stream().wait_stream(stream)
+
+    def replay(self, obs, memory):
+        for key, buffer in self.inputs.items():
+            buffer.copy_(obs[key])
+        self.memory.copy_(memory)
+        self.graph.replay()
+        return self.outputs
+
+
+def infer(actor, obs, memory):
+    # One workspace per actor, thread and width. Release graphs with the actor.
+    local = getattr(actor, "_public_graph_local", None)
+    if local is None:
+        local = actor._public_graph_local = threading.local()
+    key = (actor.model, tuple(memory.shape), memory.device)
+    if not hasattr(local, "graphs"):
+        local.graphs = {}
+    if key not in local.graphs:
+        try:
+            local.graphs[key] = GreedyGraph(actor.model, obs, memory)
+        except RuntimeError as error:
+            if not _capture_unavailable(error):
+                raise
+            warnings.warn(f"Using eager public-shop inference: {error}", RuntimeWarning)
+            local.graphs[key] = None
+    graph = local.graphs[key]
+    if graph is not None:
+        return graph.replay(obs, memory)
+    out = actor.model.act(obs, memory=memory, deterministic=True)
+    return (
+        torch.cat(
+            (out.actions, out.end_freeze_mask[:, None], torch.ones_like(out.end_freeze_mask[:, None])), 1
+        ),
+        out.memory,
+    )
+
+
+def _capture_unavailable(error):
+    message = str(error).lower()
+    return (
+        isinstance(error, torch.cuda.OutOfMemoryError) or "captur" in message or "cuda graph" in message
+    )
+
+
+class EncoderGraph:
+    """Capture only FP32 encoding; the ordinary sampler still owns all random draws."""
+
+    def __init__(self, model, obs, memory):
+        self.inputs = {k: v.clone() for k, v in obs.items()}
+        self.memory = memory.clone()
+        stream = torch.cuda.Stream(device=memory.device)
+        stream.wait_stream(torch.cuda.current_stream())
+        with torch.cuda.stream(stream):
+            for _ in range(3):
+                model.encode_decision(self.inputs, self.memory, forecast=False)
+        torch.cuda.current_stream().wait_stream(stream)
+        self.graph = torch.cuda.CUDAGraph()
+        with torch.cuda.graph(self.graph, stream=stream):
+            self.features = model.encode_decision(self.inputs, self.memory, forecast=False)
+        torch.cuda.current_stream().wait_stream(stream)
+
+    def replay(self, obs, memory):
+        for key, buffer in self.inputs.items():
+            buffer.copy_(obs[key])
+        self.memory.copy_(memory)
+        self.graph.replay()
+        return self.features
+
+
+class CollectionActor:
+    def __init__(self):
+        self.graphs = {}
+
+    def __call__(self, model, obs, memory, deterministic):
+        if not memory.is_cuda or model.training or model.config.causal_context_schema:
+            return model.act(obs, memory=memory, deterministic=deterministic)
+        # Each collector is single-threaded. Weights change in place after an
+        # update. The captured encoder recomputes features from those weights.
+        key = (model, tuple(memory.shape), memory.device)
+        if key not in self.graphs:
+            try:
+                self.graphs[key] = EncoderGraph(model, obs, memory)
+            except RuntimeError as error:
+                if not _capture_unavailable(error):
+                    raise
+                warnings.warn(f"Using eager collection inference: {error}", RuntimeWarning)
+                self.graphs[key] = None
+        if self.graphs[key] is None:
+            return model.act(obs, memory=memory, deterministic=deterministic)
+        features = self.graphs[key].replay(obs, memory)
+        return model.sample_joint_action(features, deterministic=deterministic)
