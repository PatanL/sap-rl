index 0000000..c80fad2
--- /dev/null
+++ b/research/public_planner/check_native_scorer.py
@@ -0,0 +1,140 @@
+"""Check native WDL, final represented pet fields and the exact NumPy random stream."""
+
+import argparse, ctypes, json, pickle, random
+from collections import Counter
+from pathlib import Path
+import numpy as np
+from plan_common import install
+
+install(cuda=False)
+from sapai import Team, Battle, Pet
+from native_scorer import encode, library, KINDS, PERKS, native_scores, NativeScorer
+from compact_scorer import CompactScorer
+
+lib = library()
+arr = np.ctypeslib.ndpointer
+lib.sap_inspect_battle.argtypes = [
+    arr(dtype=np.int32, flags="C_CONTIGUOUS"),
+    ctypes.c_uint32,
+    arr(dtype=np.int32, flags="C_CONTIGUOUS"),
+    arr(dtype=np.uint32, flags="C_CONTIGUOUS"),
+    ctypes.POINTER(ctypes.c_uint32),
+]
+lib.sap_inspect_battle.restype = ctypes.c_int8
+p = argparse.ArgumentParser()
+p.add_argument("--count", type=int, default=4096)
+p.add_argument("--out", type=Path, required=True)
+p.add_argument("--planner-calls", type=Path, help="Optional trusted planner corpus from capture.py")
+args = p.parse_args()
+rng = random.Random(2106771)
+cases = Counter()
+
+
+def inspect(a, b, seed, tag):
+    pair = np.concatenate([encode(a), encode(b)])
+    native = np.zeros_like(pair)
+    words = np.empty(624, np.uint32)
+    pos = ctypes.c_uint32()
+    outcome = lib.sap_inspect_battle(pair, seed, native, words, ctypes.byref(pos))
+    batched = int(native_scores(pair[:5], pair[5:][None], np.array([seed], dtype=np.uint32))[0, 0])
+    if batched != outcome:
+        raise ValueError("Native score grid disagrees with inspected battle")
+    if outcome < 0:
+        cases[tag + "Fallback"] += 1
+        return
+    battle = Battle(Team.from_state(a), Team.from_state(b), seed=seed, fast_training=True)
+    reference = battle.battle()
+    terminal = np.concatenate([encode(battle.t0.state), encode(battle.t1.state)])
+    mt = battle.rs.get_state()
+    if (
+        outcome != reference
+        or not np.array_equal(native, terminal)
+        or not np.array_equal(mt[1], words)
+        or mt[2] != pos.value
+    ):
+        problem = dict(
+            tag=tag,
+            seed=seed,
+            outcomes=[outcome, reference],
+            positions=[pos.value, mt[2]],
+            rngWordsEqual=np.array_equal(mt[1], words),
+            native=native.tolist(),
+            reference=terminal.tolist(),
+            inputs=pair.tolist(),
+            species=[[x["pet"]["name"] for x in q["team"]] for q in (a, b)],
+        )
+        args.out.with_suffix(".failure.json").write_text(json.dumps(problem, indent=2))
+        with args.out.with_suffix(".failure.pkl").open("wb") as f:
+            pickle.dump((a, b, seed), f)
+        raise ValueError(problem)
+    cases[tag + "Exact"] += 1
+
+
+# Level-three Sheep with Honey can summon two Bees as well as its Rams
+# under the pinned rules. The winner alone can conceal a wrong summon count.
+left, right = Team(), Team()
+for team, slot, name, level, attack, hp, temp, perk in (
+    (left, 0, 'mosquito', 3, 50, 2, 0, 'status-poison-attack'),
+    (left, 3, 'rooster', 2, 1, 49, 4, 'status-splash-attack'),
+    (right, 2, 'sheep', 3, 1, 10, 1, 'status-honey-bee'),
+):
+    pet=Pet(name)
+    pet.level,pet._attack,pet._health=level,attack,hp
+    pet._until_end_of_battle_attack_buff,pet.status=temp,perk
+    team[slot]=pet
+inspect(left.state,right.state,128120524,'sheepHoney')
+assert cases['sheepHoneyExact']==1
+
+calls = pickle.loads(args.planner_calls.read_bytes()) if args.planner_calls else []
+for states, opps, count, rs in calls:
+    source = random.Random()
+    source.setstate(rs)
+    seeds = [source.getrandbits(31) for _ in range(count)]
+    for a in states:
+        for b in opps:
+            for seed in seeds:
+                inspect(a, b, seed, "planner")
+
+
+def board():
+    team = Team()
+    for i in rng.sample(range(5), rng.randrange(1, 6)):
+        pet = Pet(rng.choice(list(KINDS) + ["fish", "otter", "penguin"]))
+        pet.level = rng.randint(1, 3)
+        pet.status = rng.choice(list(PERKS))
+        pet._attack = rng.choice([1, 2, 3, 5, 10, 20, 49, 50])
+        pet._health = rng.choice([1, 2, 3, 5, 10, 20, 49, 50])
+        pet._until_end_of_battle_attack_buff = rng.choice([0, 0, 1, 4])
+        pet._until_end_of_battle_health_buff = rng.choice([0, 0, 1, 4])
+        pet.ability_counter = rng.randint(0, 2) if pet.name == "pet-gorilla" else 0
+        team[i] = pet
+    return team.state
+
+
+for i in range(args.count):
+    inspect(board(), board(), rng.getrandbits(31), "random")
+# Exercise mixed supported/unsupported requests, overriding abilities, gaps,
+# multiple seeds, repeated boards, zero seeds and both directions.
+import multiprocessing as mp
+from sapai import Team
+
+simple = Team(["ant", "fish", "cricket"]).state
+complex_board = Team(["fly", "tiger", "whale"]).state
+overridden = Team(["parrot", "fish"]).state
+overridden["team"][0]["pet"]["override_ability"] = True
+overridden["team"][0]["pet"]["override_ability_dict"] = Pet("ant").ability.copy()
+with mp.get_context("fork").Pool(1) as pool:
+    native_backend = NativeScorer(pool)
+    for m in (0, 1, 4):
+        inputs = [simple, overridden, complex_board, simple]
+        opps = list(reversed(inputs))
+        ref_rng = random.Random(17)
+        new_rng = random.Random(17)
+        assert CompactScorer(pool).versus_many(inputs, opps, m, ref_rng) == native_backend.versus_many(
+            inputs, opps, m, new_rng
+        )
+        assert ref_rng.getstate() == new_rng.getstate()
+    assert native_backend.fallback_count > 0 and native_backend.native_count > 0
+    cases.update(mixedNative=native_backend.native_count, mixedFallback=native_backend.fallback_count)
+args.out.write_text(json.dumps(cases, indent=2))
+print(cases)
