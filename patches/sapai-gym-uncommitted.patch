new file mode 100644
index 0000000..84f2e95
--- /dev/null
+++ b/research/public_planner/check_compact_battles.py
@@ -0,0 +1,85 @@
+"""Compare individual battle outcomes, terminal teams, and RNG on released boards."""
+import argparse
+import hashlib
+import json
+import pickle
+import random
+import signal
+from pathlib import Path
+
+import numpy as np
+from compact_scorer import compact_board
+from plan_common import install
+
+
+def canonical(state):
+    def native(value):
+        if isinstance(value,np.ndarray):
+            return value.tolist()
+        if isinstance(value,np.generic):
+            return value.item()
+        raise TypeError(type(value))
+    return json.dumps(state,sort_keys=True,allow_nan=False,default=native,separators=(',',':'))
+
+
+def terminal(left,right,seed):
+    from sapai import Battle
+    b=Battle(left,right,seed=seed,fast_training=True)
+    signal.alarm(4)
+    try:
+        result=b.battle()
+    finally:
+        signal.alarm(0)
+    return result,canonical([b.t0.state,b.t1.state,b.rs.get_state()])
+
+
+def run(library,output):
+    from sapai import Team
+    def timeout(*_):
+        raise TimeoutError('A battle timed out in the parity audit')
+    signal.signal(signal.SIGALRM,timeout)
+    with library.open('rb') as stream:
+        digest=hashlib.file_digest(stream,'sha256').hexdigest()
+        if digest!='8f13394cb9081a528c42afc12659a4a742c073039831a304b792edc7b64da27c':
+            raise ValueError('Expected the released synthetic board library')
+        stream.seek(0)
+        boards=pickle.load(stream)
+    rng=random.Random(20261121620)
+    observed=set()
+    total=0
+    bytes_full=bytes_compact=0
+    for i in range(96):
+        turn=1+i%min(16,len(boards))
+        a,b=[row['board'] for row in rng.sample(boards[turn],2)]
+        compact=[compact_board(t) for t in (a,b)]
+        before=canonical([a,b])
+        bytes_full+=len(pickle.dumps([a,b]))
+        bytes_compact+=len(pickle.dumps(compact))
+        for team in (a,b):
+            observed.update(s['pet']['name'] for s in team['team'] if s['pet']['name']!='pet-none')
+        cached=[Team.from_state(t) for t in compact]
+        cache_before=canonical([t.state for t in cached])
+        for _ in range(8):
+            seed=rng.getrandbits(31)
+            expected=terminal(Team.from_state(a),Team.from_state(b),seed)
+            actual=terminal(*cached,seed)
+            if expected!=actual:
+                raise ValueError(f'Terminal mismatch on board pair {i}, seed {seed}')
+            total+=1
+        if before!=canonical([a,b]) or cache_before!=canonical([t.state for t in cached]):
+            raise ValueError('Board reused by subsequent battles changed')
+    result=dict(worlds=total,pairs=96,distinctSubmittedPetSpecies=len(observed),
+                originalPickleBytes=bytes_full,compactPickleBytes=bytes_compact,librarySHA256=digest,
+                passed=['outcome','both terminal team states','final battle RNG','source and cached input stability'])
+    with output.open('x') as f:
+        json.dump(result,f,indent=2)
+    print(json.dumps(result))
+
+
+if __name__=='__main__':
+    p=argparse.ArgumentParser(description=__doc__)
+    p.add_argument('library',type=Path)
+    p.add_argument('output',type=Path)
+    args=p.parse_args()
+    install(cuda=False)
+    run(args.library,args.output)
diff --git a/research/public_planner/check_fast_planner.py b/research/public_planner/check_fast_planner.py
new file mode 100644
index 0000000..e718257
--- /dev/null
+++ b/research/public_planner/check_fast_planner.py
@@ -0,0 +1,94 @@
+import argparse, json
+from pathlib import Path
+from unittest.mock import patch
+import numpy as np
+import torch
+from plan_common import install, load_actor, seed_of
+from compact_scorer import compact_board
+from public_panel import CONFIG
+from public_opponent import PublicOpponentPlanner
+from fast_public_planner import FastPublicPlanner
+
+parser = argparse.ArgumentParser(
+    description="Compare the public opponent rollouts and the planner RNG on fresh AI worlds."
+)
+parser.add_argument("--output", type=Path, required=True)
+args = parser.parse_args()
+install(cuda=True)
+from sapai_gym1 import SuperAutoPetsEnv
+from sapai_gym1.rl.selfplay_env import ParallelSelfPlayEnv
+from sapai_gym1.rl.action_schema import AutoregressiveAction
+from sapai_gym1.rl.joint_action import JointAction, step_decisions
+from sapai_gym1.rl.rollout_search import PublicSearchState
+
+torch.cuda.set_per_process_memory_fraction(
+    1.5 * 1024**3 / torch.cuda.get_device_properties(0).total_memory
+)
+actor = load_actor(device="cuda")
+
+
+def signature(p, view):
+    trace = []
+    original = SuperAutoPetsEnv.resolve_action
+
+    def execute(core, agent_idx, action):
+        trace.append((agent_idx, int(action)))
+        return original(core, agent_idx, action)
+
+    with patch.object(SuperAutoPetsEnv, "resolve_action", execute):
+        boards = p._simulated_opponent_boards(view, 0, CONFIG.sim_samples)
+    return (trace, [compact_board(b) for b in boards], p.rng.getstate())
+
+
+def compare(env, side, origin):
+    view = PublicSearchState.from_core(env.core, side)
+    outcome = view.core.agent.last_battle_outcome
+    view.core.opponent.last_battle_outcome = None if outcome is None else -outcome
+    view.core.opponent.lf_winner = None if outcome is None else outcome <= 0
+    seed = seed_of("shop-rollout-trace", origin, side)
+    expected = signature(PublicOpponentPlanner(actor, None, CONFIG, seed), view)
+    result = dict(
+        world=origin, turn=env.core.turn, seat=side, actions=len(expected[0]), opponents=len(expected[1])
+    )
+    for width in (64, 8):
+        candidate = FastPublicPlanner(actor, None, CONFIG, seed)
+        candidate.inference_width = width
+        actual = signature(candidate, view)
+        result[f"width{width}"] = [a == b for a, b in zip(actual, expected)]
+    return result
+
+
+rows = []
+with torch.inference_mode():
+    for i in range(12):
+        env = ParallelSelfPlayEnv()
+        world = seed_of("fresh-public-shop-trace", i)
+        obs = env.reset(seed=world, paired_tape=True)
+        memory = actor.model.initial_memory(2, "cuda")
+        for _ in range(2500):
+            if env.core.turn >= 2 + i % 10:
+                rows.extend(compare(env, s, world) for s in (0, 1))
+                break
+            sides = [s for s, active in enumerate(env.active_players()) if active]
+            obs = env.observations()
+            batch = {k: torch.from_numpy(np.stack([obs[s][k] for s in sides])).cuda() for k in obs[0]}
+            result = actor.model.act(batch, memory=memory[sides], deterministic=True)
+            actions = [None, None]
+            for j, s in enumerate(sides):
+                actions[s] = JointAction(
+                    AutoregressiveAction(*result.actions[j].tolist()), int(result.end_freeze_mask[j])
+                )
+                memory[s] = result.memory[j]
+            if step_decisions(env, actions).result.terminated:
+                break
+        print("checked worlds", i + 1, flush=True)
+assert len(rows) >= 20
+report = dict(
+    roots=len(rows),
+    actions=sum(r["actions"] for r in rows),
+    boards=sum(r["opponents"] for r in rows),
+    rows=rows,
+)
+args.output.write_text(json.dumps(report, indent=2))
+assert all(all(r["width64"]) and all(r["width8"]) for r in rows)
+print("narrow width mismatches", sum(not all(r["width8"]) for r in rows), flush=True)
