diff --git a/research/public_planner/build_battle.sh b/research/public_planner/build_battle.sh
new file mode 100755
index 0000000..be1a5c5
--- /dev/null
+++ b/research/public_planner/build_battle.sh
@@ -0,0 +1,33 @@
+#!/usr/bin/env bash
+# Build the pinned native W/D/L kernel into a run-local directory.
+set -euo pipefail
+if [[ $# != 1 ]]; then
+    echo "Usage: bash build_battle.sh OUTPUT_DIRECTORY" >&2
+    exit 2
+fi
+dir=$(cd "$(dirname "$0")" && pwd)
+mkdir -p -- "$1"
+out=$(realpath "$1")
+rustc_bin=${RUSTC:-rustc}
+if ! command -v "$rustc_bin" >/dev/null 2>&1 && [[ -z ${RUSTC:-} && -x "$HOME/.cargo/bin/rustc" ]]; then
+    rustc_bin="$HOME/.cargo/bin/rustc"
+fi
+if ! command -v "$rustc_bin" >/dev/null 2>&1; then
+    echo "Rust compiler unavailable" >&2
+    exit 3
+fi
+if ! version=$("$rustc_bin" -vV); then
+    echo "No usable Rust toolchain for this host" >&2
+    exit 3
+fi
+key=$({ sha256sum < "$dir/native/battle.rs"; echo "$version"; } | sha256sum | cut -d' ' -f1)
+file="$out/libsap_battle-$key.so"
+if [[ ! -s "$file" ]]; then
+    tmp=$(mktemp "$out/.sap-battle.XXXXXXXX.so")
+    trap 'rm -f -- "$tmp"' EXIT
+    "$rustc_bin" --edition=2021 --crate-type=cdylib -C opt-level=3 -C strip=symbols \
+        "$dir/native/battle.rs" -o "$tmp"
+    chmod 755 "$tmp"
+    mv -f -- "$tmp" "$file"
+fi
+echo "$file"
