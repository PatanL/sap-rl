+"""Training environment transition for a shopper with optional END positioning.
+
+The caller records the shopper observation, sampled joint action, recurrent
+state and behavior log probability before calling this function. Use the
+returned environment for the next decision. Only the returned native step's
+rewards and discounts feed the shopper's trajectory.
+"""
+from dataclasses import dataclass
+
+
+@dataclass
+class EndTransition:
+    env: object
+    step: object
+    moves: tuple
+
+
+def advance(env, sampled, planners):
+    from sapai_gym1.rl.action_schema import ActionType, FlatActionCodec
+    from sapai_gym1.rl.joint_action import step_decisions
+
+    if len(sampled) != 2 or len(planners) != 2:
+        raise ValueError("Expected one decision and assistance setting per seat")
+    active = env.active_players()
+    for side, action in enumerate(sampled):
+        if active[side] != (action is not None):
+            raise ValueError("Decision ownership differs from active seats")
+        if action is not None:
+            action.expand(env.core, side)
+
+    moves = [(), ()]
+    for side, (action, planner) in enumerate(zip(sampled, planners)):
+        if planner is None or action is None or action.action_type != ActionType.END_TURN:
+            continue
+        plan = planner._position(env, side, action)
+        if plan is None:
+            continue
+        if not plan or plan[-1] != action or any(
+            move.action_type != ActionType.MOVE or move.end_freeze_mask != 0 for move in plan[:-1]
+        ):
+            raise ValueError("END assistance must preserve the sampled END and its freeze mask")
+        moves[side] = tuple(plan[:-1])
+
+    # Compute both plans before applying either one. A bad prefix must not
+    # leave a partially reordered real game.
+    target = env.clone() if any(moves) else env
+    for side, prefix in enumerate(moves):
+        for move in prefix:
+            move.expand(target.core, side)
+            target.core.resolve_action(agent_idx=side, action=FlatActionCodec.encode(move.primitive))
+    # Native step validates both final actions again after the reorder costs,
+    # applies freeze toggles, resolves END effects and advances battle once.
+    step = step_decisions(target, sampled).result
+    return EndTransition(target, step, tuple(moves))
