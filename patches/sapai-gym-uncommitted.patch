@@ -0,0 +1,79 @@
+"""Exercise simultaneous assisted END, real freeze masks, and invalid plans."""
+import unittest
+
+import numpy as np
+from plan_common import install
+
+from assisted_end import advance
+
+
+class EndContracts(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        install(cuda=False)
+
+    def fixture(self):
+        from sapai import Team
+        from sapai_gym1.rl.selfplay_env import ParallelSelfPlayEnv
+        from sapai_gym1.rl.action_schema import ActionType, AutoregressiveAction
+        from sapai_gym1.rl.joint_action import JointAction
+        env=ParallelSelfPlayEnv()
+        env.reset(seed=381001,paired_tape=True)
+        for s,p in enumerate((env.core.agent,env.core.opponent)):
+            p.gold=0
+            p.team=Team(['fish','ant','deer'])
+            p._connect_objects()
+            label=('agent','opponent')[s]
+            setattr(env.core,'team_'+label,p.team)
+            setattr(env.core,'_'+label+'_actions_cache',None)
+            setattr(env.core,'_seen_team_orders_'+label,{env.core._team_order_key(p)})
+        end=JointAction(AutoregressiveAction(ActionType.END_TURN),1)
+        move=JointAction(AutoregressiveAction(ActionType.MOVE,0,1),0)
+        return env,end,move
+
+    def test_two_ends_match_native_moves_then_freeze_and_end(self):
+        from sapai_gym1.rl.action_schema import FlatActionCodec,ActionType
+        from sapai_gym1.rl.joint_action import step_decisions
+        env,end,move=self.fixture()
+        class Fixed:
+            def _position(self,game,side,sampled):
+                return [move,sampled]
+        reference=env.clone()
+        for s in (0,1):
+            reference.core.resolve_action(agent_idx=s,action=FlatActionCodec.encode(move.primitive))
+        expected=step_decisions(reference,[end,end]).result
+        result=advance(env,(end,end),(Fixed(),Fixed()))
+        self.assertEqual(result.moves,((move,),(move,)))
+        self.assertEqual(env.core.turn,1)
+        self.assertEqual(result.env.core.turn,2)
+        self.assertTrue(result.step.battle_resolved)
+        self.assertEqual(result.step.battle_result,expected.battle_result)
+        self.assertEqual(result.step.rewards,expected.rewards)
+        self.assertEqual(result.env._paired_battle_seeds,reference._paired_battle_seeds)
+        for actual,ref in zip(result.step.observations,expected.observations):
+            for k in ref:
+                np.testing.assert_array_equal(actual[k],ref[k])
+        for p in (result.env.core.agent,result.env.core.opponent):
+            self.assertTrue(any(slot.frozen for slot in p.shop))
+
+    def test_invalid_reorder_or_replaced_mask_does_not_commit(self):
+        from sapai_gym1.rl.action_schema import ActionType,AutoregressiveAction
+        from sapai_gym1.rl.joint_action import JointAction
+        env,end,move=self.fixture()
+        before=env.observations()
+        for bad in ([move,JointAction(end.primitive,0)],
+                    [move,JointAction(AutoregressiveAction(ActionType.SELL,1),0),end],
+                    [move,JointAction(AutoregressiveAction(ActionType.MOVE,4,0),0),end]):
+            class Bad:
+                def _position(self,*args):
+                    return bad
+            with self.assertRaises(ValueError):
+                advance(env,(end,end),(Bad(),None))
+            self.assertEqual(env.core.turn,1)
+            for a,b in zip(before,env.observations()):
+                for k in a:
+                    np.testing.assert_array_equal(a[k],b[k])
+
+
+if __name__=='__main__':
+    unittest.main()
