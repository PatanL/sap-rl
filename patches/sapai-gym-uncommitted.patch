+++ b/research/public_planner/bench_position.py
@@ -0,0 +1,119 @@
+"""Measure the complete END decision with alternating scorers on frozen roots."""
+import argparse
+import hashlib
+import json
+import multiprocessing as mp
+from pathlib import Path
+import time
+
+import torch
+from plan_common import install, load_actor, seed_of
+from prepared_scorer import PreparedScorer
+from public_opponent import PublicOpponentPlanner
+from public_panel import CONFIG, MatchBattleScorer
+
+
+class Recorder:
+    def __init__(self, backend):
+        self.backend = backend
+        self.calls = []
+        self.seconds = 0.
+
+    def versus_many(self, states, opponents, count, rng):
+        start = time.monotonic()
+        result = self.backend.versus_many(states, opponents, count, rng)
+        self.seconds += time.monotonic() - start
+        self.calls.append((len(states), len(opponents), count, list(result)))
+        return result
+
+
+def roots(actor):
+    from sapai_gym1.rl.joint_action import step_decisions
+    from sapai_gym1.rl.selfplay_env import ParallelSelfPlayEnv
+    from teacher_world import ActorRequest
+    for origin, side, target_turn in [(0,0,3),(1,1,5),(2,0,7),(3,1,9)]:
+        env = ParallelSelfPlayEnv()
+        env.reset(seed=seed_of('prepared-scorer-roots-v1',origin),paired_tape=True)
+        memory = [torch.zeros(actor.model.config.memory_dim) for _ in range(2)]
+        for _ in range(2500):
+            obs = env.observations()
+            seats = [s for s,a in enumerate(env.active_players()) if a]
+            responses = actor.act_many([ActorRequest(obs[s],memory[s],actor.owner) for s in seats])
+            actions = [None,None]
+            for s,r in zip(seats,responses):
+                actions[s] = r.action
+                memory[s] = r.next_memory
+            if (env.core.turn>=target_turn and actions[side] is not None
+                    and actions[side].action_type==0 and len(PublicOpponentPlanner._order_paths(env.core,side))>1):
+                yield origin, env, side, actions[side]
+                break
+            if step_decisions(env,actions).result.terminated:
+                raise RuntimeError(f'No eligible END at origin {origin}')
+        else:
+            raise RuntimeError('Root collection exceeded match limit')
+
+
+@torch.inference_mode()
+def run(output,device,workers,candidate='prepared',baseline='original',rollout_width=64):
+    if output.exists():
+        raise FileExistsError(output)
+    install(cuda=False)
+    with mp.get_context('fork').Pool(workers) as pool:
+        if device=='cuda':
+            install(cuda=True)
+            torch.cuda.set_per_process_memory_fraction(.04)
+        else:
+            torch.set_num_threads(1)
+            torch.backends.mha.set_fastpath_enabled(False)
+        actor=load_actor(device=device)
+        from compact_scorer import CompactScorer
+        from scorer_backend import select_backend
+        if candidate==baseline:
+            raise ValueError('Choose two different backends')
+        factories={'original':MatchBattleScorer,'compact':CompactScorer,'prepared':PreparedScorer,
+                   'native':lambda pool:select_backend('native',pool,rollout_width)[0]}
+        rows=[]
+        for origin,env,side,end in roots(actor):
+            expected=None
+            order=(baseline,candidate,candidate,baseline)
+            for name in (order if origin%2==0 else tuple(baseline if n==candidate else candidate for n in order)):
+                backend=factories[name](pool)
+                scorer=Recorder(backend)
+                scorer.rollout_width=rollout_width
+                planner_type=getattr(backend,'planner_type',PublicOpponentPlanner)
+                planner=planner_type(actor,scorer,CONFIG,seed_of('prepared-scorer-search-v1',origin))
+                start=time.monotonic()
+                plan=planner._position(env,side,end)
+                elapsed=time.monotonic()-start
+                signature=(scorer.calls,[a.to_dict() for a in plan] if plan else [])
+                if not scorer.calls:
+                    raise RuntimeError('No battle scoring in timed decision')
+                if expected is not None and signature!=expected:
+                    raise RuntimeError(f'Scores or selected moves diverged on origin {origin}')
+                expected=signature
+                rows.append(dict(origin=origin,turn=env.core.turn,seat=side,scorer=name,
+                                 seconds=elapsed,battleScoringSeconds=scorer.seconds,
+                                 plannedBattles=sum(a*b*c for a,b,c,_ in scorer.calls),
+                                 nativeBattles=getattr(backend,'native_count',0),fallbackBattles=getattr(backend,'fallback_count',0),
+                                 signature=hashlib.sha256(json.dumps(signature,sort_keys=True).encode()).hexdigest()))
+            print('verified root',origin,flush=True)
+    ratios={}
+    for field in ('seconds','battleScoringSeconds'):
+        totals={n:sum(r[field] for r in rows if r['scorer']==n) for n in (baseline,candidate)}
+        ratios[field]=dict(**totals,speedup=totals[baseline]/totals[candidate])
+    report=dict(device=device,workers=workers,candidate=candidate,baseline=baseline,rolloutWidth=rollout_width,checkpoint=actor.owner,ratios=ratios,rows=rows)
+    with output.open('x') as f:
+        json.dump(report,f,indent=2)
+    print(json.dumps(ratios),flush=True)
+
+
+if __name__=='__main__':
+    p=argparse.ArgumentParser(description=__doc__)
+    p.add_argument('--output',type=Path,required=True)
+    p.add_argument('--device',choices=('cpu','cuda'),default='cpu')
+    p.add_argument('--workers',type=int,default=1)
+    p.add_argument('--candidate',choices=('prepared','compact','native'),default='prepared')
+    p.add_argument('--baseline',choices=('original','compact'),default='original')
+    p.add_argument('--rollout-width',type=int,choices=(8,64),default=64)
+    args=p.parse_args()
+    run(args.output,args.device,args.workers,args.candidate,args.baseline,args.rollout_width)
