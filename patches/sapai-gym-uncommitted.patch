@@ -0,0 +1,81 @@
+"""Exercise the actual END search on matched views with different hidden worlds."""
+import hashlib
+import json
+import multiprocessing as mp
+from pathlib import Path
+
+import numpy as np
+import torch
+from plan_common import install, load_actor
+from planner import strip_rng
+from public_opponent import PublicOpponentPlanner
+from public_panel import CONFIG, MatchBattleScorer
+
+
+def main():
+    install(cuda=False)
+    from sapai import Team
+    from sapai_gym1.rl.joint_action import step_decisions
+    from sapai_gym1.rl.selfplay_env import ParallelSelfPlayEnv
+    from teacher_world import ActorRequest
+    torch.set_num_threads(1)
+    env=ParallelSelfPlayEnv()
+    env.reset(seed=901,paired_tape=True)
+    done=set()
+    checks=[]
+    with mp.get_context('fork').Pool(1) as pool:
+        actor=load_actor(device='cpu')
+        memory=[torch.zeros(512),torch.zeros(512)]
+        for _ in range(150):
+            obs=env.observations()
+            active=[s for s,a in enumerate(env.active_players()) if a]
+            responses=actor.act_many([ActorRequest(obs[s],memory[s],actor.owner) for s in active])
+            actions=[None,None]
+            for seat,response in zip(active,responses):
+                actions[seat]=response.action
+                if (seat not in done and env.core.turn>=2 and response.action.action_type==0 and
+                        len(PublicOpponentPlanner._order_paths(env.core,seat))>=2):
+                    variant=env.clone()
+                    variant.redeterminize(1191212)
+                    hidden=(variant.core.opponent,variant.core.agent)[seat]
+                    hidden.shop.shop_attack+=2
+                    hidden.shop.shop_health+=1
+                    hidden.gold=7
+                    hidden.default_gold=13
+                    hidden.team=Team(['ant','ant','fish'])
+                    hidden._connect_objects()
+                    setattr(variant.core,'team_'+('opponent' if seat==0 else 'agent'),hidden.team)
+                    for slot in hidden.shop:
+                        if not slot.empty:
+                            slot.frozen=not slot.frozen
+                    assert all(np.array_equal(v,variant.observations()[seat][k]) for k,v in obs[seat].items())
+                    observations=[]
+                    for world in (env,variant):
+                        scores=[]
+                        class RecordingScorer(MatchBattleScorer):
+                            def versus_many(self,states,opponents,samples,rng):
+                                result=super().versus_many(states,opponents,samples,rng)
+                                payload=[strip_rng(states),strip_rng(opponents),result]
+                                scores.append(hashlib.sha256(json.dumps(payload,sort_keys=True).encode()).hexdigest())
+                                return result
+                        planner=PublicOpponentPlanner(actor,RecordingScorer(pool),CONFIG,seed=111921+seat)
+                        plan=planner._position(world,seat,response.action)
+                        assert scores and planner.stats['positions']==1
+                        observations.append((scores,[a.to_dict() for a in plan] if plan else []))
+                    if observations[0]!=observations[1]:
+                        raise AssertionError(f'Position search differed on identical public inputs, seat {seat}')
+                    checks.append(dict(seat=seat,turn=env.core.turn,scoringDigests=observations[0][0],
+                                       selectedPlan=observations[0][1]))
+                    done.add(seat)
+                memory[seat]=response.next_memory
+            if len(done)==2:
+                break
+            if step_decisions(env,actions).result.terminated:
+                break
+    assert done=={0,1}
+    Path('public-position-check.json').write_text(json.dumps(checks,indent=2))
+    print('Both seats: identical candidate boards, opponent boards, scores, and selected plans.')
+
+
+if __name__=='__main__':
+    main()
diff --git a/research/public_planner/compact_scorer.py b/research/public_planner/compact_scorer.py
new file mode 100644
index 0000000..0d6fb65
--- /dev/null
+++ b/research/public_planner/compact_scorer.py
@@ -0,0 +1,22 @@
+"""Experimental transport for battles with an explicit independent seed."""
+from prepared_scorer import PreparedScorer
+
+
+def compact_board(state):
+    # Only the current pets' RNGs are replaced by Battle._bind_battle_rng.
+    # Preserve nested swallowed-pet records, ability overrides and all stats.
+    slots = []
+    for slot in state['team']:
+        pet = slot['pet'].copy()
+        pet.pop('seed_state', None)
+        slots.append({**slot, 'pet': pet})
+    return {**state, 'team': slots}
+
+
+class CompactScorer(PreparedScorer):
+    def versus_many(self, states, opponents, seeds_per, rng):
+        return super().versus_many(
+            [compact_board(s) for s in states],
+            [compact_board(b) for b in opponents],
+            seeds_per, rng,
+        )
