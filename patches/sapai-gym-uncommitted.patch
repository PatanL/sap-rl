+++ b/research/public_planner/native_scorer.py
@@ -0,0 +1,269 @@
+"""Batch seeded v30 fights in Rust, routing unrepresented fights to the reference."""
+
+import ctypes
+from functools import lru_cache
+import hashlib
+import os
+from pathlib import Path
+
+import numpy as np
+from compact_scorer import compact_board
+from planner import safe_battle
+
+
+KINDS = {
+    name: i + 2
+    for i, name in enumerate(
+        (
+            "ant",
+            "flamingo",
+            "cricket",
+            "deer",
+            "peacock",
+            "dolphin",
+            "crab",
+            "mosquito",
+            "blowfish",
+            "turtle",
+            "crocodile",
+            "mammoth",
+            "camel",
+            "boar",
+            "kangaroo",
+            "gorilla",
+            "spider",
+            "skunk",
+            "armadillo",
+            "dodo",
+            "wolverine",
+            "sheep",
+            "rooster",
+            "horse",
+            "turkey",
+            "leopard",
+            "hippo",
+            "rhino",
+        )
+    )
+}
+QUIET = {
+    "none",
+    "Sell",
+    "Buy",
+    "BuyFood",
+    "BuyTier1Animal",
+    "EatsShopFood",
+    "EatsShopFoodOrGainsPerk",
+    "EndOfTurn",
+    "EndOfTurnWith3PlusGold",
+    "EndOfTurnAfterLoss",
+    "EndOfTurnWithLvl3Friend",
+    "EndOfTurnWith4OrLessAnimals",
+    "LevelUp",
+    "PurchaseFood",
+    "StartOfTurn",
+}
+PERKS = {
+    name: i
+    for i, name in enumerate(
+        (
+            "none",
+            "status-bone-attack",
+            "status-steak-attack",
+            "status-melon-armor",
+            "status-garlic-armor",
+            "status-coconut-shield",
+            "status-poison-attack",
+            "status-splash-attack",
+            "status-weak",
+            "status-honey-bee",
+            "status-extra-life",
+        )
+    )
+}
+PERKS.update({"status-bread": 0, "status-cake": 0})
+RULES = {
+    "__init__": "f488318581f06234ed0747f1205d9de7738479e423b7ea136a054240babfc684",
+    "turtle_pack": "6fe49781971b4919fd26ada5806e4e00a443d2422241e467c473f31b92b6f9c4",
+    "lists": "96a3351ed74322e4cf420b59df398a694ed9bb9300ba8696e39ecd0a5ec68b03",
+    "rand": "2c8213c7691f211c791cb4916acc089bf6504152a384a057ee28902ef99ff896",
+    "battle": "03332ca6c673d4c138b6ffed7c4272a497e9660f42ff875964c327ef98ecd923",
+    "pets": "853bc756eadcfe429fb95572b6f7516e83016332c09a53244e50471fc3767e3a",
+    "teams": "0b7d6a7898d5dfedc2424182f31ea1f64080b97a2266871127f30499bbf69754",
+    "effects": "663d19feb1c7ea0cd6b3e5515573f61d58b4a9b5b4b3f4fca00449526b5f85c0",
+    "status": "a9a427a276536c9b26a5f09cf84e14ff89bbb638b55f26299700047e52426b96",
+    "data": "7892347ba634ae0380ed1e4cd5660dc84c19d3ff427eb2fb159e768b4ce76423",
+}
+
+
+def library_path():
+    return Path(
+        os.environ.get("SAP_BATTLE_LIBRARY", Path(__file__).with_name("native") / "libsap_battle.so")
+    )
+
+
+@lru_cache(maxsize=1)
+def library():
+    import sapai
+
+    base = Path(sapai.__file__).resolve().parent
+    for name, digest in RULES.items():
+        if hashlib.sha256((base / (name + ".py")).read_bytes()).hexdigest() != digest:
+            raise RuntimeError("Native scorer requires the pinned v30 " + name + " implementation")
+    path = library_path()
+    lib = ctypes.CDLL(str(path.resolve()))
+    if lib.sap_batch_abi() != 5:
+        raise ValueError("Incompatible Rust battle library")
+    tensor = np.ctypeslib.ndpointer
+    lib.sap_score_batch.argtypes = [
+        tensor(dtype=np.int32, flags="C_CONTIGUOUS"),
+        ctypes.c_size_t,
+        tensor(dtype=np.int32, flags="C_CONTIGUOUS"),
+        ctypes.c_size_t,
+        tensor(dtype=np.uint32, ndim=1, flags="C_CONTIGUOUS"),
+        ctypes.c_size_t,
+        tensor(dtype=np.int8, flags=("C_CONTIGUOUS", "WRITEABLE")),
+    ]
+    lib.sap_score_batch.restype = None
+    return lib
+
+
+@lru_cache(maxsize=512)
+def pet_kind(name, level):
+    from sapai.data import data
+
+    if name in ("pet-shark", "pet-fly", "pet-tiger"):
+        return -1
+    if name.removeprefix("pet-") in KINDS:
+        return KINDS[name.removeprefix("pet-")]
+    definition = data["pets"].get(name)
+    if not definition:
+        return -1
+    ability = definition.get(f"level{level}Ability", {"trigger": "none"})
+    return 1 if ability["trigger"] in QUIET else -1
+
+
+@lru_cache(maxsize=256)
+def birth_perk(name):
+    from sapai.data import data
+
+    return PERKS.get(data["pets"].get(name, {}).get("status", "none"), -1)
+
+
+@lru_cache(maxsize=256)
+def pet_tier(name):
+    from sapai.data import data
+
+    value = data["pets"].get(name, {}).get("tier")
+    return value if isinstance(value, int) else 0
+
+
+def encode(state):
+    result = np.zeros((5, 11), dtype=np.int32)
+    if len(state["team"]) != 5:
+        result[0, 0] = -1
+        return result
+    for i, slot in enumerate(state["team"]):
+        p = slot["pet"]
+        if p["name"] == "pet-none":
+            continue
+        level = p["level"]
+        stats = [
+            p[k]
+            for k in (
+                "attack",
+                "health",
+                "until_end_of_battle_attack_buff",
+                "until_end_of_battle_health_buff",
+            )
+        ]
+        if (
+            not isinstance(level, (int, np.integer))
+            or level not in (1, 2, 3)
+            or p["override_ability"]
+            or p["swallowed_pets"]
+            or p["status"] not in PERKS
+            or birth_perk(p["name"]) < 0
+            or any(
+                not isinstance(v, (int, np.integer)) or not (-50 if j == 1 else 0) <= v <= 50
+                for j, v in enumerate(stats)
+            )
+            or not isinstance(p["ability_counter"], (int, np.integer))
+            or not 0 <= p["ability_counter"] < 100000
+            or not isinstance(p.get("friends_hurt_counter", 0), (int, np.integer))
+            or not 0 <= p.get("friends_hurt_counter", 0) < 100000
+            or stats[1] + stats[3] <= 0
+        ):
+            result[i, 0] = -1
+            continue
+        result[i] = [
+            pet_kind(p["name"], level),
+            level,
+            *stats,
+            PERKS[p["status"]],
+            p["ability_counter"],
+            p.get("friends_hurt_counter", 0),
+            birth_perk(p["name"]),
+            pet_tier(p["name"]),
+        ]
+    return result
+
+
+def score_grid(left, right, seeds):
+    if any(a.ndim != 3 or a.shape[1:] != (5, 11) for a in (left, right)):
+        raise ValueError("Expected five-slot native boards")
+    output = np.empty((len(left), len(right), len(seeds)), dtype=np.int8)
+    library().sap_score_batch(left, len(left), right, len(right), seeds, len(seeds), output)
+    return output
+
+
+def native_scores(left, right, seeds):
+    return score_grid(left[None], right, seeds)[0]
+
+
+def fallback_chunk(args):
+    from sapai import Team
+
+    states, opponents, seeds, tasks = args
+    left = {}
+    right = {}
+    result = []
+    for i, j, k in tasks:
+        if i not in left:
+            left[i] = Team.from_state(states[i])
+        if j not in right:
+            right[j] = Team.from_state(opponents[j])
+        result.append(safe_battle(left[i], right[j], seeds[k]))
+    return result
+
+
+class NativeScorer:
+    def __init__(self, pool):
+        library()
+        self.pool = pool
+        self.native_count = self.fallback_count = 0
+
+    def versus_many(self, states, opponents, seeds_per, rng):
+        seeds = [rng.getrandbits(31) for _ in range(seeds_per)]
+        if not opponents or not seeds or not states:
+            return [0.0] * len(states)
+        opponents = [compact_board(s) for s in opponents]
+        encoded = np.stack([encode(s) for s in opponents])
+        seeds_array = np.array(seeds, dtype=np.uint32)
+        result = score_grid(np.stack([encode(s) for s in states]), encoded, seeds_array)
+        missing = np.argwhere(result < 0)
+        self.native_count += result.size - len(missing)
+        self.fallback_count += len(missing)
+        if len(missing):
+            # Chunk by candidate; avoid repeatedly transmitting all candidate boards.
+            # Keep opponent objects local to each worker for every seed in a chunk.
+            jobs = []
+            for i in np.unique(missing[:, 0]):
+                tasks = [(0, int(j), int(k)) for j, k in missing[missing[:, 0] == i, 1:]]
+                jobs.append(([compact_board(states[i])], opponents, seeds, tasks))
+            rows = self.pool.map(fallback_chunk, jobs)
+            for (i, j, k), outcome in zip(missing, (v for row in rows for v in row)):
+                result[i, j, k] = -1 if outcome is None else outcome
+        completed = (result >= 0).sum(axis=(1, 2)).clip(min=1)
+        scores = (result == 0).sum(axis=(1, 2)) + 0.5 * (result == 2).sum(axis=(1, 2))
+        return (scores / completed).tolist()
