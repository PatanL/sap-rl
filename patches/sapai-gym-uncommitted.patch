@@ -0,0 +1,126 @@
+"""Bounded self-play league, checkpoint evaluations, and an evidence-based champion."""
+import fcntl
+import hashlib
+import json
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import sys
+import tempfile
+
+
+HERE = Path(__file__).resolve().parent
+OUT = Path('/job')
+ROOT = Path('/workspace')
+SOURCE = ROOT / 'runs/direct-opening-exploration-20260918-v1'
+PARENT = ROOT / 'runs/ordinary-rl-shared-20260924-v2/outputs/chunk-20/update-025772.pt'
+PARENT_SHA = '0669109e9b6ee2d4f0309a3fec83039fc8a7d74f74e3c9f629d2f7026e515d49'
+TARGETS = (16, 128, 384)
+
+
+def sha(path):
+    with Path(path).open('rb') as stream:
+        return hashlib.file_digest(stream, 'sha256').hexdigest()
+
+
+def read(path):
+    return json.loads(path.read_text())
+
+
+def save(path, obj):
+    temp = path.with_suffix('.partial')
+    temp.write_text(json.dumps(obj, indent=2, allow_nan=False) + '\n')
+    temp.replace(path)
+
+
+def run_logged(cmd, log, env):
+    with log.open('w') as stream:
+        result = subprocess.run(cmd, stdout=stream, stderr=subprocess.STDOUT, env=env)
+    if result.returncode:
+        raise RuntimeError(f'Process exited {result.returncode}; see {log}')
+
+
+def train(target, previous):
+    marker = OUT / f'trained-{target:06d}.json'
+    if marker.exists():
+        old = read(marker)
+        if sha(old['path']) != old['sha256'] or old['previous'] != previous['sha256']:
+            raise ValueError('Checkpoint or training lineage changed')
+        return old
+    folder = Path(tempfile.mkdtemp(prefix=f'stage-{target:06d}-', dir=OUT))
+    cmd = [sys.executable, str(HERE/'train_stage.py'), '--distributed', '--device', 'cuda',
+           '--num-envs', '4', '--games-per-actor', '3', '--segments-per-update', '32',
+           '--transitions-per-update', '4096', '--trajectory-queue-size', '256',
+           '--max-behavior-policy-lag', '1', '--discount-mode', 'per_turn', '--discount', '0.99',
+           '--learning-rate', '2e-6', '--opponent-module-learning-rate', '1e-4',
+           '--opponent-adapter-learning-rate', '1e-5', '--end-freeze-learning-rate', '5e-5',
+           '--lean-policy-execution', '--lean-bootstrap', '--dense-trajectories', '--paired-random-tape',
+           '--training-exploration', 'opening-policy-temperature-v1-20260918',
+           '--disable-expert-anchor', '--max-historical-residents', '4',
+           '--checkpoint-every', '64', '--updates', str(target), '--seed', str(2026112100+target),
+           '--checkpoint-dir', str(folder)]
+    if previous['update'] == 0:
+        cmd += ['--init-checkpoint',str(PARENT),'--resident-checkpoint',str(PARENT)]
+    else:
+        league = Path(previous['path']).parent/'league.json'
+        if sha(league) != previous['leagueSHA256']:
+            raise ValueError('Previous league changed')
+        shutil.copy2(league,folder/'league.json')
+        cmd += ['--resume-checkpoint',previous['path']]
+    env = dict(os.environ, SAP_TRAIN_SOURCE=str(SOURCE),
+               PYTHONPATH=f'{SOURCE}/source/sapai:{SOURCE}/source/sapai-gym')
+    save(folder/'command.json',cmd)
+    print(f'Training through update {target}: {folder}',flush=True)
+    run_logged(cmd,folder/'training.log',env)
+    path = folder/f'update-{target:06d}.pt'
+    import torch
+    ck = torch.load(path, map_location='cpu', weights_only=True)
+    if not (ck['update']==target and ck['transitions']>previous['transitions']
+            and ck.get('privileged_replay') is None and ck['optimizer']['state']
+            and all(v.isfinite().all().item() for v in ck['model'].values())):
+        raise ValueError('Invalid learner checkpoint')
+    record = dict(path=str(path), sha256=sha(path), update=target, transitions=ck['transitions'],
+                  leagueSHA256=sha(folder/'league.json'), previous=previous['sha256'])
+    save(marker,record)
+    return record
+
+
+def main():
+    OUT.mkdir(exist_ok=True)
+    lock = (OUT/'loop.lock').open('a')
+    fcntl.flock(lock,fcntl.LOCK_EX|fcntl.LOCK_NB)
+    if sha(PARENT)!=PARENT_SHA:
+        raise ValueError('Unexpected starting policy')
+    parent = dict(path=str(PARENT),sha256=PARENT_SHA,update=0,transitions=0)
+    protocol = dict(parent=PARENT_SHA, milestones=TARGETS, trainingSource=sha(SOURCE/'train_runtime.py'),
+                    trainingOnly='simulated league play', scriptHashes={
+                        name:sha(HERE/name) for name in ('loop.py','train_stage.py','score.py')})
+    protocol = json.loads(json.dumps(protocol))
+    plan = OUT/'protocol.json'
+    if plan.exists() and read(plan)!=protocol:
+        raise ValueError('Existing run uses a different protocol. Choose a new output directory.')
+    save(plan,protocol)
+    history=[]
+    previous=champion=parent
+    for target in TARGETS:
+        candidate=train(target,previous)
+        report=OUT/f'score-{target:06d}.json'
+        if not report.exists():
+            run_logged([sys.executable,str(HERE/'score.py'),candidate['path'],candidate['sha256'],
+                        champion['path'],champion['sha256'],str(target),str(report)],
+                       OUT/f'evaluation-{target:06d}.log',os.environ)
+        result=read(report)
+        if (result['candidate'],result['incumbent'])!=(candidate['sha256'],champion['sha256']):
+            raise ValueError('Scorecard does not belong to this checkpoint comparison')
+        if result['promoted']:
+            champion=candidate
+        history.append(dict(update=target,transitions=candidate['transitions'],champion=champion['sha256'],
+                            baseline=result['baseline'],promotion=result['promoted'],confirmation=result['confirmation']))
+        save(OUT/'progression.json',dict(initial=parent,champion=champion,history=history))
+        print(f"Evaluated {target}; champion {champion['sha256'][:12]}",flush=True)
+        previous=candidate
+
+
+if __name__=='__main__':
+    main()
