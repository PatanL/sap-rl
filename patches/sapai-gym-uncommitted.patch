+"""Experimental worker for the public positioning planner."""
+from planner import safe_battle
+
+
+def score_prepared(args):
+    from sapai import Team
+    state, opponents, seeds = args
+    # Battle copies each input team, then binds the specified battle RNG.
+    team = Team.from_state(state)
+    total, completed = 0., 0
+    for opponent_state in opponents:
+        opponent = Team.from_state(opponent_state)
+        for seed in seeds:
+            outcome = safe_battle(team, opponent, seed)
+            if outcome is not None:
+                total += (1., 0., .5)[outcome]
+                completed += 1
+    return total / max(1, completed)
+
+
+class PreparedScorer:
+    def __init__(self, pool):
+        self.pool = pool
+
+    def versus_many(self, states, opponents, seeds_per, rng):
+        seeds = [rng.getrandbits(31) for _ in range(seeds_per)]
+        return self.pool.map(score_prepared, [(s, opponents, seeds) for s in states])
