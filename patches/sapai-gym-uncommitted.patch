+++ b/research/public_planner/matched_play.py
@@ -0,0 +1,227 @@
+"""Local two-seat v30 match driver for a future held-out Turtle Pack evaluation.
+
+Run in the panel runtime. The caller selects the human seat. The terminal
+interface returns only the human player's own shop and public match history.
+An owner-operated benchmark still needs a roster and scoring protocol.
+"""
+import argparse
+import hashlib
+import json
+import multiprocessing as mp
+import os
+from pathlib import Path
+import secrets
+import time
+
+import torch
+from plan_common import install, load_actor
+from public_opponent import PublicOpponentPlanner
+from public_panel import CONFIG, MatchBattleScorer
+
+
+class InvalidInput(ValueError):
+    """Input failed validation before either player or the planner advanced."""
+
+
+class MatchedPlay:
+    def __init__(self, actor, scorer, human_seat, game_seed, search_seed, *, mode='planner'):
+        from sapai_gym1.rl.selfplay_env import ParallelSelfPlayEnv
+        if human_seat not in (0,1):
+            raise ValueError('Human seat must be zero or one')
+        self.human_seat=human_seat
+        self.actor=actor
+        self.env=ParallelSelfPlayEnv()
+        self.env.reset(seed=game_seed,paired_tape=True)
+        if mode not in ('raw','planner'):
+            raise ValueError('Unknown match policy')
+        self.planner=PublicOpponentPlanner(actor,scorer,CONFIG,search_seed) if mode=='planner' else None
+        self.memory=torch.zeros(actor.model.config.memory_dim)
+        self.revision=0
+        self.winner=None
+        self.completed_battles=[]
+
+    def view(self):
+        from sapai_gym1.rl.action_schema import ActionType,FlatActionCodec
+        from sapai_gym1.rl.game_trace import player_snapshot
+        from sapai_gym1.rl.public_battle_board import public_records
+        core=self.env.core
+        side=self.human_seat
+        player,opponent=(core.agent,core.opponent) if side==0 else (core.opponent,core.agent)
+        other='opponent' if side==0 else 'agent'
+        moves=core.reorder_count_agent if side==0 else core.reorder_count_opponent
+        actions=core.shop_action_count_agent if side==0 else core.shop_action_count_opponent
+        toggled=core._freeze_toggled_agent if side==0 else core._freeze_toggled_opponent
+        orders=core._seen_team_orders_agent if side==0 else core._seen_team_orders_opponent
+        legal={}
+        if self.winner is None and not player.turn_ended:
+            for code in core._avail_actions(side):
+                a=FlatActionCodec.decode(code)
+                legal[int(code)]=(ActionType(a.action_type).name,int(a.source),int(a.target))
+        return dict(revision=self.revision,turn=int(core.turn),seat=side,
+                    player=player_snapshot(player),opponentLives=int(opponent.lives),
+                    opponentWins=int(opponent.wins),lastOpponent=public_records(getattr(core,'previous_'+other+'_state')),
+                    olderOpponent=public_records(getattr(core,'previous_previous_'+other+'_state')),
+                    movesUsed=moves,shopActionsUsed=actions,visitedOrders=len(orders),
+                    alreadyToggled=[i for i,slot in enumerate(player.shop) if not slot.empty and id(slot.obj) in toggled],
+                    legal=legal,winner=self.winner,
+                    battleHistory=self.completed_battles.copy())
+
+    def submit(self,code,revision,freeze_mask=0):
+        from sapai_gym1.rl.action_schema import FlatActionCodec, ActionType
+        from sapai_gym1.rl.joint_action import JointAction,step_decisions
+        from sapai_gym1.rl.distributed import _completed_match_result
+        if self.winner is not None or revision!=self.revision:
+            raise InvalidInput('Stale decision or completed match')
+        if type(code) is not int or code not in self.env.core._avail_actions(self.human_seat):
+            raise InvalidInput('Illegal action')
+        primitive=FlatActionCodec.decode(code)
+        if type(freeze_mask) is not int or not 0<=freeze_mask<1024:
+            raise InvalidInput('Expected a ten-slot freeze mask')
+        if freeze_mask and primitive.action_type!=ActionType.END_TURN:
+            raise InvalidInput('Only END accepts a freeze mask')
+        human=JointAction(primitive,freeze_mask)
+        try:
+            human.expand(self.env.core,self.human_seat)
+        except ValueError as exc:
+            raise InvalidInput(str(exc)) from exc
+        bot_seat=1-self.human_seat
+        for _ in range(100):
+            pair=[None,None]
+            pair[self.human_seat]=human
+            if self.env.active_players()[bot_seat]:
+                if self.planner is None:
+                    from teacher_world import ActorRequest
+                    obs=self.env.encoder.encode(self.env.core,bot_seat)
+                    response=self.actor.act_many([ActorRequest(obs,self.memory,self.actor.owner)])[0]
+                else:
+                    response=self.planner.decide(self.env,bot_seat,self.memory)
+                pair[bot_seat]=response.action
+                self.memory=response.next_memory
+            step=step_decisions(self.env,pair).result
+            self.revision+=1
+            if step.battle_resolved:
+                self.completed_battles.append(int(step.battle_result))
+            if step.terminated:
+                self.winner=int(_completed_match_result(self.env.core))
+                return
+            if self.env.active_players()[self.human_seat]:
+                return
+            human=None
+        raise RuntimeError('Turn exceeded the simulator action guard')
+
+
+def read_human_action(view):
+    player=view['player']
+    def board(slots):
+        if slots is None:
+            return 'unseen'
+        names=[]
+        for i,pet in enumerate(slots):
+            if pet is None:
+                names.append(f'[{i}] empty')
+                continue
+            name=pet.get('label') or pet['species'].removeprefix('pet-')
+            perk=pet.get('statusLabel') or pet.get('perk')
+            text=f'[{i}] {name} {pet["attack"]}/{pet["health"]} L{pet["level"]}+{pet["experience"]}'
+            if perk and perk!='none':
+                text+=f' {perk}'
+            if 'sellValue' in pet:
+                text+=f' sell={pet["sellValue"]}'
+            if pet.get('temporaryAttack') or pet.get('temporaryHealth'):
+                text+=' temp-buff'
+            names.append(text)
+        return ' | '.join(names)
+    print(f'\nTurn {view["turn"]}  Gold {player["gold"]}  Hearts {player["lives"]} vs {view["opponentLives"]}'
+          f'  Wins {player["wins"]} vs {view["opponentWins"]}  Actions {view["shopActionsUsed"]}/50'
+          f'  Moves {view["movesUsed"]}/10  Shop bonus +{player["shopAttack"]}/+{player["shopHealth"]}')
+    print('Your team (front first)',board(player['team']))
+    print('Opponent last board   ',board(view['lastOpponent']))
+    print('Opponent prior board  ',board(view['olderOpponent']))
+    for slot in player['shop']:
+        item=slot['item']
+        if not item:
+            continue
+        tags=[]
+        if slot['frozen']:
+            tags.append('frozen')
+        if slot['index'] in view['alreadyToggled']:
+            tags.append('already toggled')
+        if slot['rewardGroup'] is not None:
+            tags.append(f'discover group {slot["rewardGroup"]}')
+        print(f'  Shop [{slot["index"]}] {item["label"]} {item["attack"]}/{item["health"]}'
+              f'  {slot["cost"]}g  {", ".join(tags)}')
+    groups={}
+    for code,(name,source,target) in sorted(view['legal'].items()):
+        where='' if source==10 else str(source)
+        if target!=5:
+            where+=f'→{target}'
+        groups.setdefault(name,[]).append(f'{where} ({code})' if where else f'({code})')
+    for name,options in groups.items():
+        print(name,' '.join(options))
+    while True:
+        value=input('Action number (END optionally followed by shop slots to toggle), or q: ').strip()
+        if value=='q':
+            return None
+        parts=value.split()
+        if parts and all(x.isdecimal() for x in parts) and int(parts[0]) in view['legal']:
+            code,*slots=map(int,parts)
+            if slots and (view['legal'][code][0]!='END_TURN' or len(set(slots))!=len(slots)
+                          or any(s>=10 for s in slots)):
+                continue
+            return code,sum(1<<s for s in slots)
+
+
+def main():
+    from dataclasses import asdict
+    p=argparse.ArgumentParser()
+    p.add_argument('--human-seat',type=int,choices=(0,1),required=True)
+    p.add_argument('--receipt-dir',type=Path,required=True)
+    p.add_argument('--mode',choices=('raw','planner'),default='raw')
+    args=p.parse_args()
+    install(cuda=False)
+    from sapai.turtle_pack import SIMULATOR_REVISION
+    with mp.get_context('fork').Pool(3) as pool:
+        install(cuda=True)
+        torch.cuda.set_per_process_memory_fraction(.04)
+        actor=load_actor(device='cuda')
+        seed,search_seed=secrets.randbits(62),secrets.randbits(62)
+        match=MatchedPlay(actor,MatchBattleScorer(pool),args.human_seat,seed,search_seed,mode=args.mode)
+        args.receipt_dir.mkdir(parents=True,exist_ok=True)
+        path=args.receipt_dir/(secrets.token_hex(12)+'.json')
+        scripts=('public_opponent.py','public_panel.py','matched_play.py')
+        receipt=dict(status='started',humanSeat=args.human_seat,simulator=SIMULATOR_REVISION,
+                     seriesDigest=os.environ.get('SAP_SERIES_DIGEST'),seriesSlot=os.environ.get('SAP_SERIES_SLOT'),
+                     update=25772,checkpoint=actor.owner,policyMode=args.mode,
+                     plannerConfig=asdict(CONFIG) if args.mode=='planner' else None,
+                     sourceHashes={s:hashlib.sha256(Path(__file__).with_name(s).read_bytes()).hexdigest() for s in scripts},
+                     seedCommitment=hashlib.sha256(f'{seed}/{search_seed}'.encode()).hexdigest(),
+                     started=time.time(),trainingUse=False)
+        with path.open('x') as stream:
+            json.dump(receipt,stream)
+        try:
+            while match.winner is None:
+                view=match.view()
+                action=read_human_action(view)
+                if action is None:
+                    break
+                try:
+                    match.submit(action[0],view['revision'],action[1])
+                except InvalidInput as exc:
+                    print(str(exc))
+            receipt['status']='completed' if match.winner is not None else 'abandoned'
+        except (EOFError,KeyboardInterrupt):
+            receipt['status']='interrupted'
+        except Exception:
+            receipt['status']='engine-error'
+            raise
+        finally:
+            receipt.update(winner=match.winner,ended=time.time(),gameSeed=seed,searchSeed=search_seed,
+                           battleCount=len(match.completed_battles))
+            tmp=path.with_suffix('.partial')
+            tmp.write_text(json.dumps(receipt,indent=2))
+            tmp.replace(path)
+            print('Match outcome',receipt['status'],'winner (0/1 seat, 2 draw)',match.winner)
+
+
+if __name__=='__main__':
+    main()
