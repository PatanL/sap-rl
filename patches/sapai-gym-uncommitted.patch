+"""Select a pinned scorer and the corresponding public planner for new runs."""
+
+import hashlib
+import os
+
+from compact_scorer import CompactScorer
+from fast_public_planner import FastPublicPlanner
+from native_scorer import NativeScorer, library_path
+from public_opponent import PublicOpponentPlanner
+
+
+def select_backend(name, pool, rollout_width=64):
+    from public_panel import MatchBattleScorer
+
+    if name == "auto":
+        name = "native" if os.environ.get("SAP_BATTLE_LIBRARY") or library_path().is_file() else "compact"
+    if name == "native":
+        backend = NativeScorer(pool)
+        library = library_path()
+        with library.open("rb") as stream:
+            binary_digest = hashlib.file_digest(stream, "sha256").hexdigest()
+    elif name in ("reference", "compact"):
+        backend = (MatchBattleScorer if name == "reference" else CompactScorer)(pool)
+        binary_digest = None
+    else:
+        raise ValueError("Unknown battle scorer: " + name)
+    if rollout_width not in (8, 64):
+        raise ValueError("Supported opponent batch widths are 8 and 64")
+    if name != "reference":
+        backend.rollout_width = rollout_width
+        from graph_actor import CollectionActor
+
+        backend.collection_actor = CollectionActor()
+    backend.planner_type = PublicOpponentPlanner if name == "reference" else FastPublicPlanner
+    identity = dict(scorer=name, nativeSHA256=binary_digest, planner=backend.planner_type.__name__)
+    if name != "reference":
+        identity["rolloutWidth"] = rollout_width
+    return backend, identity
