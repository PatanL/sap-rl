new file mode 100644
index 0000000..94767f9
--- /dev/null
+++ b/research/selfplay/fit_position_outcomes.py
@@ -0,0 +1,119 @@
+"""Fit a cheap public END-order model, select on validation worlds, and test once."""
+import argparse
+import json
+from pathlib import Path
+
+import numpy as np
+import torch
+from plan_common import CURRENT, OUT, seed_of, sha
+from position_outcomes import GAMES, TAG, write
+from posnet import PosNet
+from train_posnet import loss_fn, tensors, values
+
+
+RELEASED = 'eb9debd4372ec32917b90c4759ea652dc9bbf91b31396540e30cdbb2426033d8'
+
+
+def load_split(folder, split):
+    path = folder / split
+    spec = json.loads((path / 'protocol.json').read_text())
+    summary = json.loads((path / 'summary.json').read_text())
+    identity = sha(path / 'protocol.json')
+    if (spec['parent'], spec['split'], spec['namespace'], spec['games'], summary['protocol']) != (
+        CURRENT['sha'], split, TAG, GAMES[split], identity
+    ):
+        raise ValueError('Wrong data collection protocol')
+    rows = []
+    for i in range(GAMES[split]):
+        game = json.loads((path / f'game-{i:03d}.json').read_text())
+        world = seed_of(TAG, split, i)
+        if game['world'] != world or game['protocol'] != identity:
+            raise ValueError('World belongs to a different split')
+        rows.extend((world, row) for row in game['rows'])
+    if len(rows) != summary['decisions']:
+        raise ValueError('Incomplete dataset')
+    return tensors(rows, 'cpu'), np.array([w for w, _ in rows])
+
+
+@torch.inference_mode()
+def world_gains(model, dataset, worlds):
+    model.eval()
+    gains = []
+    for i in range(0, len(worlds), 24):
+        indices = torch.arange(i, min(i + 24, len(worlds)))
+        prediction, target, mask = values(model, dataset, indices)
+        selected = prediction.masked_fill(~mask, -torch.inf).argmax(-1, keepdim=True)
+        gains.extend((target.gather(1, selected)[:, 0] - target[:, 0]).tolist())
+    gains = np.asarray(gains)
+    return np.array([gains[worlds == w].mean() for w in np.unique(worlds)])
+
+
+def estimate(scores):
+    samples = np.random.default_rng(25772).choice(scores, (20000, len(scores))).mean(1)
+    return dict(mean=float(scores.mean()), paired95=np.quantile(samples, [.025, .975]).tolist())
+
+
+def run(folder, contract=False):
+    torch.set_num_threads(1)
+    torch.backends.mha.set_fastpath_enabled(False)
+    torch.manual_seed(25772)
+    initial = OUT / 'posnet-zeroshot.pt'
+    if sha(initial) != RELEASED:
+        raise ValueError('Unexpected released positioner')
+    model = PosNet()
+    model.load_state_dict(torch.load(initial, map_location='cpu', weights_only=True)['model'])
+    training, train_worlds = load_split(folder, 'contract' if contract else 'train')
+    if contract:
+        validation, val_worlds = training, train_worlds
+    else:
+        validation, val_worlds = load_split(folder, 'validation')
+        if set(train_worlds) & set(val_worlds):
+            raise ValueError('Training and validation overlap')
+    dest = folder / ('fit-contract' if contract else 'fit')
+    dest.mkdir(exist_ok=True)
+    path = dest / 'positioner.pt'
+    best = -float('inf')
+    history = []
+    optimizer = torch.optim.AdamW(model.parameters(), lr=3e-5, weight_decay=.01)
+    steps = 1 if contract else 600
+    for step in range(steps + 1):
+        if step % 100 == 0 or step == steps:
+            gain = world_gains(model, validation, val_worlds).mean().item()
+            history.append(dict(step=step, meanValidationBattleGain=gain))
+            if gain > best:
+                best = gain
+                tmp = path.with_suffix('.tmp')
+                torch.save(dict(model=model.state_dict(), step=step, initialSHA256=RELEASED), tmp)
+                tmp.replace(path)
+        if step < steps:
+            model.train()
+            batch = torch.randint(len(train_worlds), (16,))
+            score, target, mask = values(model, training, batch)
+            loss, _, _ = loss_fn(score, target, mask)
+            optimizer.zero_grad(set_to_none=True)
+            loss.backward()
+            torch.nn.utils.clip_grad_norm_(model.parameters(), 1., error_if_nonfinite=True)
+            optimizer.step()
+    selected = torch.load(path, map_location='cpu', weights_only=True)
+    result = dict(initial=RELEASED, selected=sha(path), selectedStep=selected['step'], validation=history)
+    if not contract:
+        test, worlds = load_split(folder, 'test')
+        if set(worlds) & (set(train_worlds) | set(val_worlds)):
+            raise ValueError('Test worlds overlap development')
+        model.load_state_dict(selected['model'])
+        final = world_gains(model, test, worlds)
+        model.load_state_dict(torch.load(initial, map_location='cpu', weights_only=True)['model'])
+        baseline = world_gains(model, test, worlds)
+        result.update(testWorlds=len(final), testDecisions=len(worlds),
+                      selectedVsCurrentOrder=estimate(final), releasedVsCurrentOrder=estimate(baseline),
+                      selectedMinusReleased=estimate(final - baseline))
+    write(dest / 'result.json', result)
+    print(json.dumps(result), flush=True)
+
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('folder', type=Path)
+    parser.add_argument('--contract', action='store_true')
+    args = parser.parse_args()
+    run(args.folder, args.contract)
