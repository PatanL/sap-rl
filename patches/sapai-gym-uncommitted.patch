+"""Time matched ordinary+assisted V-trace updates with alternating battle workers.
+
+Run on the training hardware after the active study. Keep the optimizer,
+released parent, game seeds, number of simulations and learned decision budget
+fixed. Fail the comparison if trajectories, likelihoods or learned states differ.
+"""
+import argparse
+from contextlib import ExitStack
+from dataclasses import fields, is_dataclass
+import hashlib
+import json
+import multiprocessing as mp
+from pathlib import Path
+import tempfile
+import time
+from types import SimpleNamespace
+from unittest.mock import patch
+
+import numpy as np
+import torch
+import check_assisted_end
+import position_trial
+from plan_common import install, load_actor
+from position_trial import ARMS, train
+from prepared_scorer import PreparedScorer
+from compact_scorer import CompactScorer
+from public_panel import MatchBattleScorer
+
+
+def state_digest(value):
+    h=hashlib.sha256()
+    def visit(x):
+        if isinstance(x,torch.Tensor):
+            h.update(str((x.dtype,tuple(x.shape))).encode())
+            h.update(x.detach().cpu().contiguous().reshape(-1).view(torch.uint8).numpy().tobytes())
+        elif isinstance(x,np.ndarray):
+            h.update(str((x.dtype,x.shape)).encode())
+            h.update(x.tobytes(order='C'))
+        elif is_dataclass(x) and not isinstance(x,type):
+            h.update(type(x).__name__.encode())
+            for field in fields(x):
+                visit(field.name)
+                visit(getattr(x,field.name))
+        elif isinstance(x,dict):
+            for k in sorted(x,key=str):
+                visit(k)
+                visit(x[k])
+        elif isinstance(x,(tuple,list)):
+            h.update(str(len(x)).encode())
+            for v in x:
+                visit(v)
+        else:
+            h.update(repr(x).encode()+b'\0')
+    visit(value)
+    return h.hexdigest()
+
+
+def measured_update(config,actor,scorer):
+    """Capture trace references while timing, hash their contents afterward."""
+    from sapai_gym1.rl import training
+    original_collect = position_trial.collect
+    original_advance = check_assisted_end.advance
+    original_learn = training.learner_update
+    ownership = {}
+    collected = {arm:[] for arm in ARMS}
+    selected = {}
+    executed = []
+    times = {arm:dict(collect=0.,learn=0.) for arm in ARMS}
+    sync = torch.cuda.synchronize if next(actor.model.parameters()).is_cuda else lambda: None
+
+    def collect(shopper,opponent,planner,*args,**kwargs):
+        arm='ordinary' if planner is None else 'assisted'
+        ownership[id(shopper)]=arm
+        start=time.monotonic()
+        segments,stats=original_collect(shopper,opponent,planner,*args,**kwargs)
+        times[arm]['collect']+=time.monotonic()-start
+        collected[arm].append(segments)
+        return segments,stats
+
+    def advance(env,actions,planners):
+        transition=original_advance(env,actions,planners)
+        # Joint actions and move prefixes are immutable; never retain the world.
+        executed.append((tuple(actions),transition.moves))
+        return transition
+
+    def learn(model,optimizer,batch,*args,**kwargs):
+        arm=ownership[id(model)]
+        selected[arm]=batch
+        sync()
+        start=time.monotonic()
+        result=original_learn(model,optimizer,batch,*args,**kwargs)
+        sync()
+        times[arm]['learn']+=time.monotonic()-start
+        return result
+
+    with ExitStack() as context:
+        context.enter_context(patch.object(position_trial,'collect',collect))
+        context.enter_context(patch.object(check_assisted_end,'advance',advance))
+        context.enter_context(patch.object(training,'learner_update',learn))
+        sync()
+        start=time.monotonic()
+        models=train(config,actor,scorer)
+        sync()
+        elapsed=time.monotonic()-start
+    if set(selected)!=set(ARMS) or not executed:
+        raise RuntimeError('Incomplete timing instrumentation')
+    traces=dict(bothSeatActionsAndReorders=state_digest(executed),
+                collectedTurns=state_digest(collected),optimizerBatches=state_digest(selected))
+    return models,elapsed,times,traces
+
+
+def main():
+    parser=argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--output',type=Path,required=True)
+    parser.add_argument('--cpu-contract',action='store_true',
+                        help='Check trace instrumentation on one small CPU update per scorer.')
+    parser.add_argument('--backends', nargs='+', choices=('original','prepared','compact','compact-fast','native'))
+    parser.add_argument('--rollout-width', type=int, choices=(8,64), default=64)
+    parser.add_argument('--first-block', type=int, default=0)
+    args=parser.parse_args()
+    if args.backends and (len(args.backends)<2 or len(set(args.backends))!=len(args.backends)):
+        parser.error('Choose at least two distinct backends')
+    if args.first_block<0:
+        parser.error('--first-block must be nonnegative')
+    args.output.mkdir(parents=True,exist_ok=False)
+    install(cuda=False)
+    rows=[]
+    with mp.get_context('fork').Pool(1 if args.cpu_contract else 3) as pool:
+        if args.cpu_contract:
+            torch.set_num_threads(1)
+            torch.backends.mha.set_fastpath_enabled(False)
+        else:
+            install(cuda=True)
+            torch.cuda.set_per_process_memory_fraction(.05)
+        actor=load_actor(device='cpu' if args.cpu_contract else 'cuda')
+        from scorer_backend import select_backend
+        factories={'original':MatchBattleScorer, 'prepared':PreparedScorer, 'compact':CompactScorer,
+                   'compact-fast':lambda pool:select_backend('compact',pool,args.rollout_width)[0],
+                   'native':lambda pool:select_backend('native',pool,args.rollout_width)[0]}
+        names=args.backends or (['original','compact'] if args.cpu_contract else ['original','prepared','compact'])
+        backends={key:factories[key] for key in names}
+        orders=[tuple(backends)] if args.cpu_contract else [tuple(backends),tuple(reversed(backends))]
+        for block,order in enumerate(orders,args.first_block):
+            expected=None
+            for name in order:
+                with tempfile.TemporaryDirectory(dir=args.output) as scratch:
+                    config=SimpleNamespace(output=Path(scratch),updates=1,batch=64 if args.cpu_contract else 512,
+                        namespace='assisted-END-contract' if args.cpu_contract else f'prepared-update-abba-v1-{block}',
+                        protocol={'block':block,'scorer':name})
+                    scorer=backends[name](pool)
+                    models,elapsed,times,traces=measured_update(config,actor,scorer)
+                    ck=torch.load(config.output/'training.pt',map_location='cpu',weights_only=True)
+                    update,=ck['history']
+                    evidence=dict(worlds=update['worlds'],traces=traces,models={k:state_digest(ck[k]) for k in ARMS},
+                        metrics={arm:{k:v for k,v in update['arms'][arm].items() if k!='endStepSeconds'}
+                                 for arm in ARMS})
+                    trained=sum(x['trained'] for x in update['arms'].values())
+                    if trained!=2*config.batch:
+                        raise RuntimeError('Budget mismatch')
+                    row=dict(block=block,scorer=name,wallSeconds=elapsed,armSeconds=times,
+                        secondsPerThousandLearnedDecisions=elapsed*1000/trained,evidence=evidence,
+                        nativeBattles=getattr(scorer,'native_count',0), fallbackBattles=getattr(scorer,'fallback_count',0))
+                    (args.output/f'block-{block}-{name}.json').write_text(json.dumps(row,indent=2))
+                    if expected is not None and evidence!=expected:
+                        mismatches=[key for key in expected if evidence[key]!=expected[key]]
+                        raise RuntimeError(f'Training parity failure in {name} block {block}: {mismatches}')
+                    expected=evidence
+                    rows.append(row)
+                    del ck,models
+                    print(block,name,elapsed,flush=True)
+            print('matched update, optimizer and trajectory metrics:',block,flush=True)
+    totals={n:sum(r['wallSeconds'] for r in rows if r['scorer']==n) for n in backends}
+    result=dict(checkpoint=actor.owner,cpuContract=args.cpu_contract,rows=rows,totals=totals,
+                rolloutWidth=args.rollout_width, speedup={n:totals[names[0]]/t for n,t in totals.items()},
+                secondsPerThousand={name:total*1000/sum(
+                    sum(arm['trained'] for arm in row['evidence']['metrics'].values())
+                    for row in rows if row['scorer']==name) for name,total in totals.items()})
+    (args.output/'result.json').write_text(json.dumps(result,indent=2))
+    print('whole update speed ratio', result['speedup'],flush=True)
+
+
+if __name__=='__main__':
+    main()
diff --git a/research/selfplay/check_assisted_end.py b/research/selfplay/check_assisted_end.py
new file mode 100644
index 0000000..aa411af
--- /dev/null
+++ b/research/selfplay/check_assisted_end.py
@@ -0,0 +1,158 @@
+"""Run a real sampled shopper through an assisted match and one V-trace update.
+
+This CPU contract check tests credit assignment and legality, not strength.
+Run with the restored 25,772 release, the public planner and this directory
+on PYTHONPATH. Only the shopper's sampled actions enter the learner.
+"""
+import argparse
+import copy
+import json
+import math
+import multiprocessing as mp
+import time
+from pathlib import Path
+
+import numpy as np
+import torch
+from assisted_end import advance
+from plan_common import install, load_actor, seed_of
+from public_opponent import PublicOpponentPlanner
+from public_panel import CONFIG, MatchBattleScorer
+
+
+def tensors(observation, device='cpu'):
+    return {key: torch.as_tensor(value, device=device).unsqueeze(0) for key,value in observation.items()}
+
+
+@torch.no_grad()
+def collect(shopper, opponent, planner, index, *, namespace='assisted-END-contract',
+            greedy=False, opponent_planner=None, world_index=None, collection_actor=None):
+    from sapai_gym1.rl.action_schema import AutoregressiveAction
+    from sapai_gym1.rl.joint_action import JointAction
+    from sapai_gym1.rl.selfplay_env import ParallelSelfPlayEnv
+    from sapai_gym1.rl.training import Transition, TurnSegment
+
+    seat = index % 2
+    env = ParallelSelfPlayEnv()
+    world = seed_of(namespace+'-world', index if world_index is None else world_index)
+    obs = env.reset(seed=world, paired_tape=True)
+    torch.manual_seed(seed_of(namespace+'-policy', index))
+    device = next(shopper.parameters()).device
+    memory = shopper.initial_memory(2,device)
+    initial = memory[seat].cpu().clone()
+    pending, segments = [], []
+    decisions = moves = assisted_turns = assisted_buy_turns = 0
+    changed_turns = []
+    planner_seconds = 0.
+    for _ in range(2500):
+        pair = [None,None]
+        for side,active in enumerate(env.active_players()):
+            if not active:
+                continue
+            model = shopper if side==seat else opponent
+            inputs = tensors(obs[side],device)
+            if collection_actor is None:
+                result = model.act(inputs,memory=memory[side:side+1],deterministic=greedy or side!=seat)
+            else:
+                result = collection_actor(model,inputs,memory[side:side+1],greedy or side!=seat)
+            action = result.actions[0].cpu().numpy().copy()
+            mask = int(result.end_freeze_mask[0])
+            pair[side] = JointAction(AutoregressiveAction(*map(int,action)),mask)
+            if side==seat:
+                pending.append(Transition(observation=obs[side],action=action,behavior_log_prob=float(result.log_prob[0]),
+                                          end_freeze_mask=mask,reward=0.,discount=1.))
+                decisions += 1
+            memory[side] = result.memory[0]
+        planners = (planner,opponent_planner) if seat==0 else (opponent_planner,planner)
+        started = time.monotonic()
+        transition = advance(env,pair,planners)
+        env,step = transition.env,transition.step
+        if pair[seat] is not None and pair[seat].action_type==0:
+            planner_seconds += time.monotonic()-started
+        if transition.moves[seat]:
+            assert pair[seat].action_type==0 and pending[-1].action[0]==0
+            moves += len(transition.moves[seat])
+            assisted_turns += 1
+            changed_turns.append(len(segments))
+            assisted_buy_turns += int(any(t.action[0] in (2,3) for t in pending))
+        obs = step.observations
+        if not step.battle_resolved:
+            continue
+        assert pending and pending[-1].action[0]==0
+        pending[-1].reward += step.rewards[seat]
+        pending[-1].discount = 0. if step.terminated else .99
+        battle = 2 if step.battle_result==2 else int(step.battle_result!=seat)
+        segments.append(TurnSegment(pending,initial,obs[seat],step.terminated,battle))
+        initial = memory[seat].cpu().clone()
+        pending = []
+        if step.terminated:
+            break
+    if not segments or not segments[-1].terminal:
+        raise RuntimeError('Incomplete game')
+    if decisions != sum(len(s.transitions) for s in segments):
+        raise RuntimeError('Shopper decisions lost or planner actions added')
+    from sapai_gym1.rl.distributed import _completed_match_result
+    winner = _completed_match_result(env.core)
+    return segments, dict(seat=seat,world=world,score=.5 if winner==2 else float(winner==seat),
+                          decisions=decisions,battles=len(segments),plannerMoves=moves,
+                          assistedTurns=assisted_turns,assistedTurnsWithPurchase=assisted_buy_turns,
+                          changedTurnIndices=changed_turns,
+                          endStepSeconds=planner_seconds)
+
+
+@torch.no_grad()
+def verify_likelihood(policy, segments):
+    max_error=0.
+    policy.eval()
+    device=next(policy.parameters()).device
+    for segment in segments:
+        memory=segment.initial_memory.to(device).unsqueeze(0)
+        for t in segment.transitions:
+            features=policy.encode_decision(tensors(t.observation,device),memory,forecast=False)
+            out=policy.decode_decision(features,actions=torch.as_tensor(t.action,device=device).unsqueeze(0),
+                                       allow_end_freeze=True,end_freeze_masks=torch.tensor([t.end_freeze_mask],device=device),
+                                       action_only=True)
+            max_error=max(max_error,abs(float(out.log_prob[0])-t.behavior_log_prob))
+            memory=out.memory
+    if max_error>1e-4:
+        raise RuntimeError(f'Sampled shopper likelihood differs on replay: {max_error}')
+    return max_error
+
+
+def main():
+    p=argparse.ArgumentParser(description=__doc__)
+    p.add_argument('--output',type=Path,required=True)
+    args=p.parse_args()
+    if args.output.exists():
+        raise FileExistsError(args.output)
+    install(cuda=False)
+    from sapai_gym1.rl.training import learner_update
+    torch.set_num_threads(1)
+    torch.backends.mha.set_fastpath_enabled(False)
+    with mp.get_context('fork').Pool(1) as pool:
+        actor=load_actor(device='cpu')
+        shopper=copy.deepcopy(actor.model).requires_grad_(True)
+        segments=[]; games=[]
+        for index in range(2):
+            planner=PublicOpponentPlanner(actor,MatchBattleScorer(pool),CONFIG,seed_of('assisted-END-planner',index))
+            total,stats=collect(shopper,actor.model,planner,index)
+            segments.extend(total); games.append(stats)
+            print(stats,flush=True)
+        if not sum(g['assistedTurnsWithPurchase'] for g in games):
+            raise RuntimeError('No purchased board actually reordered in the probe')
+        error=verify_likelihood(shopper,segments)
+        optimizer=torch.optim.AdamW(shopper.parameters(),lr=2e-6)
+        metrics=learner_update(shopper,optimizer,segments,'cpu',use_bfloat16=False,lean_bootstrap=True)
+        changed=not torch.equal(shopper.type_head.weight,actor.model.type_head.weight)
+        if not changed or not math.isfinite(metrics.total_loss) or metrics.transitions!=sum(g['decisions'] for g in games):
+            raise RuntimeError('Unexpected learner update')
+    report=dict(parent=actor.owner,games=games,shopperDecisions=metrics.transitions,
+                maxBehaviorLogProbabilityError=error,loss=metrics.total_loss,policyWeightsChanged=changed)
+    args.output.parent.mkdir(parents=True,exist_ok=True)
+    with args.output.open('x') as f:
+        json.dump(report,f,indent=2)
+    print(json.dumps(report))
+
+
+if __name__=='__main__':
+    main()
diff --git a/research/selfplay/check_position_outcome_visibility.py b/research/selfplay/check_position_outcome_visibility.py
new file mode 100644
index 0000000..530f35f
--- /dev/null
+++ b/research/selfplay/check_position_outcome_visibility.py
@@ -0,0 +1,107 @@
+"""Regression check for the learned positioner's pre-battle information boundary."""
+import hashlib
+import json
+
+import numpy as np
+import torch
+from fast_position_matches import PublicOrderScorer
+from plan_common import OUT, install, load_actor, seed_of
+from planner import strip_rng
+from position_outcomes import candidates, label
+from posnet import PosNetScorer
+
+
+def digest(value):
+    return hashlib.sha256(json.dumps(value, sort_keys=True, allow_nan=False).encode()).hexdigest()
+
+
+def run():
+    install(cuda=False)
+    from sapai import Team
+    from sapai_gym1.rl.action_schema import AutoregressiveAction
+    from sapai_gym1.rl.joint_action import JointAction, step_decisions
+    from sapai_gym1.rl.selfplay_env import ParallelSelfPlayEnv
+    torch.set_num_threads(1)
+    torch.backends.mha.set_fastpath_enabled(False)
+    actor = load_actor(device='cpu')
+    network = PosNetScorer(OUT / 'posnet-zeroshot.pt', device='cpu')
+    class Scorer:
+        def score(self, boards, opponent, turn):
+            scores = network.score(boards, opponent, turn)
+            self.fingerprint = digest([boards, opponent, turn, scores])
+            return scores
+    def inspect(world, side, end, key):
+        recorder = Scorer()
+        data = candidates(world, side, end, key)
+        if data is None:
+            return None
+        plan = PublicOrderScorer(recorder)._position(world, side, end)
+        inputs, teams = data
+        return dict(features=digest(inputs), submitted=digest([strip_rng(t.state) for t in teams]),
+                    network=recorder.fingerprint, plan=[a.to_dict() for a in plan or ()]), data
+
+    env = ParallelSelfPlayEnv()
+    world_seed = seed_of('learned-position-visibility', 0)
+    env.reset(seed=world_seed, paired_tape=True)
+    memory = actor.model.initial_memory(2, 'cpu')
+    records = {}
+    for _ in range(2500):
+        turn = env.core.turn
+        sides = [s for s, active in enumerate(env.active_players()) if active]
+        obs = env.observations()
+        batch = {k:torch.from_numpy(np.stack([obs[s][k] for s in sides])) for k in obs[sides[0]]}
+        with torch.inference_mode():
+            result = actor.model.act(batch, memory=memory[sides], deterministic=True)
+        actions = [None, None]
+        for j, s in enumerate(sides):
+            end = JointAction(AutoregressiveAction(*result.actions[j].tolist()), int(result.end_freeze_mask[j]))
+            actions[s] = end
+            memory[s] = result.memory[j]
+            if len(records) == 4 or turn < 3 or end.action_type != 0:
+                continue
+            milestone = 6 if turn >= 6 else 3
+            if (milestone, s) in records:
+                continue
+            key = (world_seed, turn, s)
+            original = inspect(env, s, end, key)
+            if original is None:
+                continue
+            variant = env.clone()
+            variant.redeterminize(123021 + turn)
+            hidden = (variant.core.opponent, variant.core.agent)[s]
+            hidden.gold += 4
+            hidden.shop.shop_attack += 2
+            hidden.shop.shop_health += 1
+            hidden.team = Team(['fish', 'ant'])
+            hidden._connect_objects()
+            setattr(variant.core, 'team_' + ('opponent' if s == 0 else 'agent'), hidden.team)
+            for slot in hidden.shop:
+                if not slot.empty:
+                    slot.frozen = not slot.frozen
+            counterfactual_obs = variant.observations()[s]
+            if not all(np.array_equal(x, counterfactual_obs[k]) for k,x in obs[s].items()):
+                raise ValueError('Perturbation changed a public observation')
+            counterfactual = inspect(variant, s, end, key)
+            if counterfactual is None or original[0] != counterfactual[0]:
+                raise ValueError('Unrevealed opponent data influenced the candidate set or network')
+            # Swap the later submitted opponent only in the outcome-producing step.
+            # Extremes are fixtures for this dataflow test and never enter fitting.
+            weak, strong = Team(['fish']), Team(['fish'] * 5)
+            for slot in strong:
+                slot.pet._attack = slot.pet._health = 50
+            first = label(original[1], weak, s, key)
+            second = label(original[1], strong, s, key)
+            changed = first.pop('y') != second.pop('y')
+            if first != second or first != original[1][0]:
+                raise ValueError('Outcome labeling modified an input')
+            records[milestone,s] = dict(seat=s, turn=turn, labeledOrders=len(first['orders']),
+                                         outcomesChanged=changed, **original[0])
+        if len(records) == 4 or step_decisions(env, actions).result.terminated:
+            break
+    if len(records) != 4 or not all(row['outcomesChanged'] for row in records.values()):
+        raise ValueError('Incomplete two-seat visibility and target control')
+    return list(records.values())
+
+
+if __name__ == '__main__':
+    print(json.dumps(run(), indent=2))
diff --git a/research/selfplay/crossplay.py b/research/selfplay/crossplay.py
new file mode 100644
index 0000000..5693bb2
--- /dev/null
+++ b/research/selfplay/crossplay.py
@@ -0,0 +1,103 @@
+"""Cycle-end cross-play of the final learner and its starting policy.
+
+Use the same public v30 evaluation and the same worlds for both arms. The
+historical policies are related baselines and were not opponents in this cycle.
+"""
+from dataclasses import replace
+from pathlib import Path
+import json
+
+import numpy as np
+import torch
+from loop import OUT, PARENT, PARENT_SHA, read, save, sha
+from plan_common import install, load_actor, seed_of
+from score import panel
+
+
+RESIDENTS = {
+    'v22': '8f0cd760bdf3ea8258fec84ad6e93882054ee82755032808308737324aff6e5c',
+    'v25': '7c60acec58b56080bf240a85444163a1d72dba7bee25ac7f54e3dc8302d60994',
+}
+PAIRS = 32
+
+
+class PrimitiveResident:
+    def __init__(self, name):
+        from sapai_gym1.rl.causal_transport import validate_checkpoint_context
+        from sapai_gym1.rl.model import EntityTransformerConfig, EntityTransformerPolicy
+        path = Path('/residents') / (name+'.pt')
+        if sha(path) != RESIDENTS[name]:
+            raise ValueError(f'{name} checkpoint digest mismatch')
+        weights = torch.load(path, map_location='cpu', weights_only=True)
+        validate_checkpoint_context(weights, allow_observation_transfer=True)
+        self.policy = EntityTransformerPolicy(EntityTransformerConfig(**weights['config']))
+        self.policy.load_state_dict(weights['model'], strict=True)
+        if self.policy.config.end_freeze:
+            raise ValueError('Expected a primitive-action historical policy')
+        self.policy.to('cuda').eval().requires_grad_(False)
+
+    def act(self, *args, **kwargs):
+        result = self.policy.act(*args, **kwargs)
+        # The v30 match executor expands a zero mask to the native primitive
+        # with no extra freeze/unfreeze actions.
+        return replace(result, end_freeze_mask=torch.zeros_like(result.actions[:,0]))
+
+
+def paired_differences(first, second, seeds):
+    def keyed(rows):
+        scores = {(seed, seat): score for seed, seat, score in rows}
+        if (len(scores)!=len(rows) or set(scores)!={(s,k) for s in seeds for k in (0,1)}
+                or not all(v in (0,.5,1) for v in scores.values())):
+            raise ValueError('Incomplete or duplicated game record')
+        return scores
+    a,b = keyed(first),keyed(second)
+    return np.array([sum(a[s,k]-b[s,k] for k in (0,1))/2 for s in seeds])
+
+
+def gain(deltas):
+    resampled = np.random.default_rng(25772).choice(deltas,(20000,len(deltas))).mean(axis=1)
+    return dict(scoreChange=float(deltas.mean()), paired95=np.quantile(resampled,[.025,.975]).tolist())
+
+
+def main():
+    install(cuda=True)
+    torch.cuda.set_per_process_memory_fraction(.04)
+    protocol = read(OUT/'protocol.json')
+    milestone = protocol['milestones'][-1]
+    trained = read(OUT/f'trained-{milestone:06d}.json')
+    scorecard = read(OUT/f'score-{milestone:06d}.json')
+    if scorecard['candidate']!=trained['sha256'] or protocol['parent']!=PARENT_SHA:
+        raise ValueError('Unexpected training or evaluation lineage')
+    namespace = 'sap-league-continuation-v2-final-transfer-v1'
+    seeds = [seed_of(namespace,i) for i in range(PAIRS)]
+    folder = OUT/'crossplay'
+    folder.mkdir(exist_ok=True)
+    arms = dict(baseline=(PARENT,PARENT_SHA),candidate=(trained['path'],trained['sha256']))
+    models = {arm:load_actor(dict(path=str(path),sha=digest),device='cuda').model
+              for arm,(path,digest) in arms.items()}
+    report, paired = {}, []
+    for name,digest in RESIDENTS.items():
+        resident = PrimitiveResident(name)
+        results = {}
+        for arm,(path,model_digest) in arms.items():
+            receipt = folder/f'{name}-{arm}.json'
+            identity = dict(policy=model_digest,opponent=digest,namespace=namespace,pairs=PAIRS)
+            if receipt.exists():
+                record = read(receipt)
+                if record['identity']!=identity:
+                    raise ValueError(f'Cannot reuse {receipt}')
+            else:
+                record = dict(identity=identity,result=panel(models[arm],resident,namespace,PAIRS))
+                save(receipt,record)
+            results[arm] = record['result']
+            print(name,arm,results[arm]['score'],flush=True)
+        deltas = paired_differences(results['candidate']['games'],results['baseline']['games'],seeds)
+        paired.append(deltas)
+        report[name] = dict(raw=results['baseline']['score'],candidate=results['candidate']['score'],**gain(deltas))
+    report['equalOpponentAverage'] = gain(np.mean(paired,axis=0))
+    save(folder/'summary.json',dict(checkpoint=trained['sha256'],update=milestone,report=report))
+    print(json.dumps(report),flush=True)
+
+
+if __name__=='__main__':
+    main()
diff --git a/research/selfplay/fast_position_matches.py b/research/selfplay/fast_position_matches.py
new file mode 100644
index 0000000..36559b9
--- /dev/null
+++ b/research/selfplay/fast_position_matches.py
@@ -0,0 +1,107 @@
+"""Head-to-head screen of a frozen public order scorer on the released shopper."""
+import argparse
+import fcntl
+import json
+import time
+from pathlib import Path
+
+import numpy as np
+import torch
+from check_assisted_end import collect
+from plan_common import install, load_actor, seed_of, sha
+from planner import TurnPlanner
+from position_outcomes import board, write
+from posnet import PosNetScorer
+
+
+class PublicOrderScorer:
+    def __init__(self, scorer):
+        self.scorer = scorer
+
+    def _position(self, env, side, end):
+        from sapai_gym1.rl.action_schema import ActionType, AutoregressiveAction
+        from sapai_gym1.rl.joint_action import JointAction
+        from sapai_gym1.rl.rollout_search import PublicSearchState
+        if env.core.turn == 1:
+            return None
+        view = PublicSearchState.from_core(env.core, side)
+        paths = TurnPlanner._order_paths(view.core, 0)
+        if len(paths) < 2:
+            return None
+        base = board(view.core.agent.team)
+        candidates = [TurnPlanner._reordered(base, path) for path in paths]
+        scores = self.scorer.score(candidates, board(view.core.previous_opponent_state), view.core.turn)
+        if len(scores) != len(paths) or not np.isfinite(scores).all():
+            raise ValueError('Invalid order scores')
+        for i in sorted(range(len(paths)), key=scores.__getitem__, reverse=True):
+            if i == 0:
+                return None
+            moves = [JointAction(AutoregressiveAction(ActionType.MOVE, a, b), 0) for a, b in paths[i]]
+            clone = view.clone()
+            try:
+                for action in [*moves, end]:
+                    TurnPlanner._apply(clone.core, 0, action)
+            except ValueError:
+                continue
+            return [*moves, end]
+        return None
+
+
+def run(folder, contract):
+    install(cuda=False)
+    torch.set_num_threads(1)
+    torch.backends.mha.set_fastpath_enabled(False)
+    actor = load_actor(device='cpu')
+    fit = folder / ('fit-contract' if contract else 'fit')
+    network = fit / 'positioner.pt'
+    identity = sha(network)
+    if json.loads((fit / 'result.json').read_text())['selected'] != identity:
+        raise ValueError('Selected positioner differs from validation receipt')
+    dest = folder / ('match-contract' if contract else 'matches')
+    dest.mkdir(exist_ok=True)
+    lock = (dest / 'matches.lock').open('a')
+    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+    pairs = 1 if contract else 64
+    namespace = 'learned-public-order-25772-' + ('contract' if contract else 'screen')
+    spec = dict(shopper=actor.owner, positioner=identity, namespace=namespace, pairs=pairs,
+                device='cpu', source=sha(__file__))
+    if (dest / 'protocol.json').exists() and json.loads((dest / 'protocol.json').read_text()) != spec:
+        raise ValueError('Different match protocol')
+    write(dest / 'protocol.json', spec)
+    protocol = sha(dest / 'protocol.json')
+    scorer = PublicOrderScorer(PosNetScorer(network, device='cpu'))
+    pairscores = []
+    scores = []
+    for i in range(pairs):
+        for side in (0, 1):
+            path = dest / f'game-{i:03d}-{side}.json'
+            if path.exists():
+                row = json.loads(path.read_text())
+            else:
+                start = time.monotonic()
+                _, row = collect(actor.model, actor.model, scorer, 2*i+side,
+                                 world_index=i, namespace=namespace, greedy=True)
+                row.update(protocol=protocol, seconds=time.monotonic()-start)
+                write(path, row)
+            if (row['seat'], row['world'], row['protocol']) != (
+                side, seed_of(namespace+'-world', i), protocol
+            ) or row['score'] not in (0, .5, 1):
+                raise ValueError('Mismatched game record')
+            scores.append(row['score'])
+        pairscores.append(np.mean(scores[-2:]))
+        if (i+1) % 8 == 0 or i+1 == pairs:
+            print('completed seed pairs', i+1, flush=True)
+    boot = np.random.default_rng(25772).choice(pairscores, (20000, pairs)).mean(1)
+    report = dict(protocol=protocol, pairs=pairs, score=float(np.mean(pairscores)),
+                  wins=scores.count(1), draws=scores.count(.5), losses=scores.count(0),
+                  paired95=np.quantile(boot, [.025,.975]).tolist())
+    write(dest / 'result.json', report)
+    print(json.dumps(report))
+
+
+if __name__ == '__main__':
+    p = argparse.ArgumentParser(description=__doc__)
+    p.add_argument('folder', type=Path)
+    p.add_argument('--contract', action='store_true')
+    a = p.parse_args()
+    run(a.folder, a.contract)
