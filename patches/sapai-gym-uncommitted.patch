@@ -0,0 +1,169 @@
+"""Position-only accelerations on the corrected one-seat public reconstruction."""
+
+import copy
+from functools import lru_cache
+
+import numpy as np
+import torch
+
+from public_opponent import PublicOpponentPlanner
+
+
+@lru_cache(maxsize=1)
+def _mask_table():
+    from sapai_gym1.rl.action_schema import FlatActionCodec
+
+    return np.asarray(
+        [FlatActionCodec.decode(i).as_tuple() for i in range(FlatActionCodec.NUM_ACTIONS)], dtype=np.intp
+    )
+
+
+def _action_masks(core, side):
+    from sapai_gym1.rl.action_schema import NUM_ACTION_TYPES, NUM_SOURCES, NUM_TARGETS
+
+    legal = core._avail_actions(side)
+    table = _mask_table()
+    codes = np.fromiter(legal, dtype=np.intp, count=len(legal))
+    if codes.size and (codes.min() < 0 or codes.max() >= len(table)):
+        raise ValueError("Invalid legal action code")
+    kind, src, dst = table[codes].T
+    types = np.zeros(NUM_ACTION_TYPES, dtype=np.int8)
+    sources = np.zeros((NUM_ACTION_TYPES, NUM_SOURCES), dtype=np.int8)
+    targets = np.zeros((NUM_ACTION_TYPES, NUM_SOURCES, NUM_TARGETS), dtype=np.int8)
+    types[kind] = 1
+    sources[kind, src] = 1
+    targets[kind, src, dst] = 1
+    return types, sources, targets
+
+
+def _shop_encoder(original):
+    # Histories are immutable for the duration of a hypothetical shop turn.
+    # Cache by object identity, with bounded lifetime and ordinary handling
+    # of different history objects.
+    encoder = copy.copy(original)
+    older_key, latest_key = object(), object()
+    history = None
+
+    def encode_history(older, latest):
+        nonlocal older_key, latest_key, history
+        if older is not older_key or latest is not latest_key:
+            history = original._encode_opponent_history(older, latest)
+            older_key, latest_key = older, latest
+        return history
+
+    encoder._encode_opponent_history = encode_history
+    encoder._action_masks = _action_masks
+    return encoder
+
+
+class FastPublicPlanner(PublicOpponentPlanner):
+    inference_width = 64
+    use_graph = True
+
+    def _public_shop_cores(self, live, n):
+        if not n:
+            return
+        base = next(super()._public_shop_cores(live, 1))
+        for _ in range(n):
+            # Only the acting player shops. Each independent imagined player
+            # and its shop are installed by the caller. Previous submitted
+            # boards are identical public history for these hypotheses.
+            core = copy.copy(base)
+            core._legality_identities = type(base._legality_identities)()
+            core.last_actions = list(base.last_actions)
+            core._freeze_toggled_agent = set(base._freeze_toggled_agent)
+            core._freeze_toggled_opponent = set(base._freeze_toggled_opponent)
+            core._seen_team_orders_agent = set(base._seen_team_orders_agent)
+            core._seen_team_orders_opponent = set(base._seen_team_orders_opponent)
+            core.rs_random = copy.copy(base.rs_random)
+            yield core
+
+    @torch.inference_mode()
+    def _finish_public_shops(self, clones, side):
+        from sapai_gym1.rl.action_schema import ActionType, AutoregressiveAction, FlatActionCodec
+        from sapai_gym1.rl.joint_action import JointAction
+
+        width = getattr(self.scorer, "rollout_width", self.inference_width)
+        model = self.actor.model
+        device = next(model.parameters()).device
+        memory = model.initial_memory(len(clones), device)
+        active = list(range(len(clones)))
+        if not active:
+            return []
+        encoder = _shop_encoder(clones[0].encoder)
+        for _ in range(self.cfg.max_plan_steps):
+            if not active:
+                break
+            following = []
+            for start in range(0, len(active), width):
+                group = active[start : start + width]
+                rows = [encoder.encode(clones[i].core, side) for i in group]
+                # Preserve the canonical 64-row FP32 actor shape and row order.
+                # Recurrent states stay on device. The caller consumes only
+                # finished boards; intermediate board fingerprints are unused.
+                index = group + [group[-1]] * (width - len(group))
+                padded = rows + [rows[-1]] * (width - len(group))
+                obs = {k: torch.from_numpy(np.stack([r[k] for r in padded])).to(device) for k in rows[0]}
+                if device.type == "cuda" and self.use_graph:
+                    from graph_actor import infer
+
+                    packed, next_memory = infer(self.actor, obs, memory[index])
+                    memory[group] = next_memory[: len(group)]
+                    actions = packed[: len(group)].tolist()
+                else:
+                    out = model.act(obs, memory=memory[index], deterministic=True)
+                    memory[group] = out.memory[: len(group)]
+                    packed = torch.cat(
+                        (out.actions[: len(group)], out.end_freeze_mask[: len(group), None]), dim=1
+                    )
+                    actions = [row + [True] for row in packed.tolist()]
+                for i, (kind, source, target, mask, valid) in zip(group, actions):
+                    if not valid:
+                        raise ValueError("Invalid legal mask or nonfinite simulated opponent policy")
+                    action = JointAction(AutoregressiveAction(kind, source, target), mask)
+                    if kind == ActionType.END_TURN:
+                        self._apply(clones[i].core, side, action)
+                    else:
+                        # resolve_action itself checks the freshly encoded legal action.
+                        clones[i].core.resolve_action(
+                            agent_idx=side, action=FlatActionCodec.encode(action.primitive)
+                        )
+                    if not self._player(clones[i].core, side).turn_ended:
+                        following.append(i)
+            active = following
+        return [
+            self._player(c.core, side).team.state
+            for c in clones
+            if self._player(c.core, side).turn_ended
+        ]
+
+    def _public_clone(self, env, side):
+        from sapai import Player
+        from sapai_gym1.rl.identity_remap import remap_shop_identities, remap_team_orders
+        from sapai_gym1.rl.rollout_search import PublicSearchState
+
+        if side != 0 or not isinstance(env, PublicSearchState) or not self.cfg.position_only:
+            return super()._public_clone(env, side)
+        # Final-order proposals execute only the acting player's native
+        # MOVE, freeze toggles and END. Public board histories and the other
+        # player are read-only here. Isolate all mutable action bookkeeping.
+        new = copy.copy(env)
+        core = new.core = copy.copy(env.core)
+        original = env.core.agent
+        data = original.state
+        if "action_history" in data:
+            data["action_history"] = list(data["action_history"])
+        core.agent = Player.from_state(data)
+        core.team_agent, core.shop_agent = core.agent.team, core.agent.shop
+        core._legality_identities = type(env.core._legality_identities)()
+        core._seen_team_orders_agent = remap_team_orders(
+            original, core.agent, env.core._seen_team_orders_agent
+        )
+        core._seen_team_orders_agent.add(core._team_order_key(core.agent))
+        core._freeze_toggled_agent = remap_shop_identities(
+            original, core.agent, env.core._freeze_toggled_agent
+        )
+        core._agent_actions_cache = None
+        core.last_actions = [None]
+        new.redeterminize(self.rng.getrandbits(62))
+        return new
