index 0000000..02a53d3
--- /dev/null
+++ b/research/selfplay/run_position_trial.sh
@@ -0,0 +1,99 @@
+#!/usr/bin/env bash
+# Start or resume the paired END-training trial. New runs pin their method and scorer.
+set -euo pipefail
+if [[ $# != 2 ]]; then
+    echo 'Usage: bash run_position_trial.sh RESTORED_RELEASE RUN_DIRECTORY' >&2
+    exit 2
+fi
+release=$(realpath "$1")
+test -f "$release/runs/ordinary-rl-shared-20260924-v2/outputs/chunk-20/update-025772.pt"
+mkdir -p -- "$2"
+job=$(realpath "$2")
+study=$(cd "$(dirname "$0")" && pwd)
+planner=$(realpath "$study/../public_planner")
+name="sap-$(basename "$job")"
+exec 9>"$job/launch.lock"
+flock 9
+if docker container inspect "$name" >/dev/null 2>&1; then
+    for entry in "/workspace:$release" "/out:$job"; do
+        dest=${entry%%:*}
+        expected=${entry#*:}
+        actual=$(docker inspect -f "{{range .Mounts}}{{if eq .Destination \"$dest\"}}{{.Source}}{{end}}{{end}}" "$name")
+        if [[ "$expected" != "$actual" ]]; then
+            echo "Existing container $name points to a different $dest" >&2
+            exit 1
+        fi
+    done
+    if [[ -f "$job/protocol.json" && ( -n ${SAP_SCORER:-} || -n ${SAP_ROLLOUT_WIDTH:-} ) ]]; then
+        python3 - "$job/protocol.json" <<'PY'
+import json, os, sys
+backend = json.load(open(sys.argv[1])).get('backend', {})
+actual, width = backend.get('scorer', 'reference'), backend.get('rolloutWidth', 64)
+if os.environ.get('SAP_SCORER','auto') not in ('auto',actual):
+    sys.exit(f'Existing run uses {actual}')
+if 'SAP_ROLLOUT_WIDTH' in os.environ and int(os.environ['SAP_ROLLOUT_WIDTH']) != width:
+    sys.exit(f'Existing run uses rollout width {width}')
+PY
+    fi
+    if [[ $(docker inspect -f '{{.State.Running}}' "$name") == true ]]; then
+        echo "$name is running"
+    elif [[ -s "$job/result.json" && $(docker inspect -f '{{.State.ExitCode}}' "$name") == 0 ]]; then
+        echo "$name already completed"
+    else
+        docker start "$name"
+    fi
+    exit 0
+fi
+width=${SAP_ROLLOUT_WIDTH:-8}
+case "$width" in 8|64) ;; *) echo 'SAP_ROLLOUT_WIDTH must be 8 or 64' >&2; exit 2 ;; esac
+backend=${SAP_SCORER:-auto}
+case "$backend" in auto|native|compact|reference) ;; *) echo "Unknown SAP_SCORER $backend" >&2; exit 2 ;; esac
+method="$job/method"
+options=()
+if [[ -f "$job/protocol.json" && -d "$job/reference-method" && ! -d "$method" ]]; then
+    # Original pilot protocols hash the original five source files.
+    method="$job/reference-method"
+else
+    if [[ ! -d "$method" ]]; then
+        stage=$(mktemp -d "$job/.method-XXXXXXXX")
+        trap 'rm -rf -- "$stage"' EXIT
+        cp "$study"/{position_trial,check_assisted_end,assisted_end}.py "$stage/"
+        cp "$planner"/{public_panel,public_opponent,scorer_backend,compact_scorer,prepared_scorer,native_scorer,fast_public_planner,graph_actor}.py "$stage/"
+        mkdir "$stage/native"
+        cp "$planner/native/battle.rs" "$stage/native/"
+        cp "$planner/build_battle.sh" "$stage/"
+        mv -- "$stage" "$method"
+        trap - EXIT
+    fi
+    # Resume uses the backend recorded before the first learner update.
+    if [[ -f "$job/protocol.json" ]]; then
+        recorded=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["backend"]["scorer"])' "$job/protocol.json")
+        if [[ "$backend" != auto && "$backend" != "$recorded" ]]; then
+            echo "Run uses $recorded; requested $backend" >&2; exit 1
+        fi
+        backend="$recorded"
+        old_width=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["backend"].get("rolloutWidth",64))' "$job/protocol.json")
+        if [[ -n ${SAP_ROLLOUT_WIDTH:-} && "$width" != "$old_width" ]]; then
+            echo "Run uses rollout width $old_width; requested $width" >&2; exit 1
+        fi
+        width=$old_width
+    fi
+    if [[ "$backend" == native || "$backend" == auto ]]; then
+        if lib=$(bash "$method/build_battle.sh" "$job/native-build"); then
+            backend=native
+            options+=(-e "SAP_BATTLE_LIBRARY=/out/native-build/$(basename "$lib")")
+        else
+            rc=$?
+            if [[ "$backend" != auto || $rc != 3 ]]; then exit "$rc"; fi
+            backend=compact
+        fi
+    fi
+    options+=(-e "SAP_SCORER=$backend" -e "SAP_ROLLOUT_WIDTH=$width")
+fi
+docker run -d --name "$name" --gpus all --network none --cpus 4 --memory 12g --memory-swap 12g \
+    --user "$(id -u):$(id -g)" -e OMP_NUM_THREADS=1 -e OPENBLAS_NUM_THREADS=1 -e MKL_NUM_THREADS=1 \
+    -e PYTHONUNBUFFERED=1 -e PYTHONDONTWRITEBYTECODE=1 -e TORCH_ALLOW_TF32_CUBLAS_OVERRIDE=0 \
+    -e PYTHONPATH=/study:/workspace/runs/claude-end-positioner-20261112-v1 "${options[@]}" \
+    -v "$release:/workspace:ro" -v "$job:/out" -v "$method:/study:ro" \
+    --entrypoint python "${SAP_MATCH_IMAGE:-sap-rl-shared:research-25772}" /study/position_trial.py \
+    --output /out --device cuda
diff --git a/research/selfplay/score.py b/research/selfplay/score.py
new file mode 100644
index 0000000..bb19e21
--- /dev/null
+++ b/research/selfplay/score.py
@@ -0,0 +1,83 @@
+"""Evaluate greedy whole-match play. Each world seed is played from both seats."""
+import hashlib
+import json
+import sys
+from pathlib import Path
+
+import numpy as np
+import torch
+from plan_common import install, load_actor, seed_of
+from loop import PARENT, PARENT_SHA, save
+
+
+@torch.inference_mode()
+def panel(candidate, opponent, namespace, pairs):
+    from sapai_gym1.rl.selfplay_env import ParallelSelfPlayEnv
+    from sapai_gym1.rl.joint_action import JointAction, step_decisions
+    from sapai_gym1.rl.action_schema import AutoregressiveAction
+    from sapai_gym1.rl.distributed import _completed_match_result
+    scores=[]
+    for start in range(0,pairs,8):
+        games=[]
+        for i in range(start,min(start+8,pairs)):
+            seed=seed_of(namespace,i)
+            for seat in (0,1):
+                env=ParallelSelfPlayEnv()
+                env.reset(seed=seed,paired_tape=True)
+                games.append(dict(seed=seed,seat=seat,env=env,score=None,
+                                  memory=torch.zeros(2,candidate.config.memory_dim,device='cuda')))
+        for _ in range(2500):
+            live=[g for g in games if g['score'] is None]
+            if not live:
+                break
+            requests=[[],[]]
+            actions=[[None,None] for g in live]
+            for j,g in enumerate(live):
+                obs=g['env'].observations()
+                for s,active in enumerate(g['env'].active_players()):
+                    if active:
+                        requests[int(s!=g['seat'])].append((j,s,obs[s],g['memory'][s]))
+            for model,group in zip((candidate,opponent),requests):
+                if not group:
+                    continue
+                obs={k:torch.as_tensor(np.stack([r[2][k] for r in group]),device='cuda') for k in group[0][2]}
+                out=model.act(obs,memory=torch.stack([r[3] for r in group]),deterministic=True)
+                prim=out.actions.cpu().tolist()
+                masks=out.end_freeze_mask.cpu().tolist()
+                for k,(j,s,_,_) in enumerate(group):
+                    actions[j][s]=JointAction(AutoregressiveAction(*prim[k]),masks[k])
+                    live[j]['memory'][s]=out.memory[k]
+            for g,both in zip(live,actions):
+                if step_decisions(g['env'],both).result.terminated:
+                    winner=_completed_match_result(g['env'].core)
+                    g['score']=.5 if winner==2 else float(winner==g['seat'])
+        if any(g['score'] is None for g in games):
+            raise RuntimeError('Match failed to finish')
+        scores.extend([[g['seed'],g['seat'],g['score']] for g in games])
+    by_pair=np.array([.5*(scores[i][2]+scores[i+1][2]) for i in range(0,len(scores),2)])
+    boot=np.random.default_rng(25772).choice(by_pair,(20000,pairs)).mean(1)
+    # Separate confirmation seeds per milestone, with at most three promotion attempts.
+    return dict(pairs=pairs,score=float(by_pair.mean()),paired95=np.quantile(boot,[.025,.975]).tolist(),
+                promotionLower=float(np.quantile(boot,.05/3)),games=scores)
+
+
+def main():
+    candidate_path,candidate_sha,inc_path,inc_sha,target,destination=sys.argv[1:]
+    install(cuda=True)
+    torch.cuda.set_per_process_memory_fraction(.04)
+    def model(path,sha):
+        return load_actor(dict(path=str(path),sha=sha),device='cuda').model
+    candidate=model(candidate_path,candidate_sha)
+    parent=model(PARENT,PARENT_SHA)
+    baseline=panel(candidate,parent,'sap-loop-v1-fixed-monitor',32)
+    confirmation=None
+    if baseline['score']>.5:
+        incumbent=parent if inc_sha==PARENT_SHA else model(inc_path,inc_sha)
+        confirmation=panel(candidate,incumbent,'sap-loop-v1-confirm-'+target,64)
+    promoted=bool(confirmation and confirmation['promotionLower']>.5)
+    save(Path(destination),dict(candidate=candidate_sha,incumbent=inc_sha,baseline=baseline,
+                                confirmation=confirmation,promoted=promoted))
+
+
+if __name__=='__main__':
+    main()
