+++ b/research/selfplay/status.py
@@ -0,0 +1,101 @@
+"""Show live learner progress and completed whole-match evaluations."""
+import argparse
+import json
+import re
+import subprocess
+from pathlib import Path
+
+
+def read(path):
+    return json.loads(path.read_text())
+
+
+def learner_progress(logs):
+    for path in sorted(logs, key=lambda p: p.stat().st_mtime_ns, reverse=True):
+        last = None
+        with path.open() as stream:
+            for line in stream:
+                if line.startswith('update='):
+                    last = re.search(r'^update=(\d+) transitions=(\d+) fps=([\d.]+)(?:\s|$)', line) or last
+        if last:
+            update, transitions, fps = last.groups()
+            print(f'Last learner update {update} | {int(transitions):,} decisions | {fps} decisions/s')
+            return
+    print('Waiting for the first completed learner update')
+
+
+def population_progress(directory, protocol):
+    learner_progress(directory.glob('train-from-*.log'))
+    league_path = directory/'training/league.json'
+    if league_path.exists():
+        members = read(league_path)['members']
+        saved = [m for m in members if m['role'] == 'historical'
+                 and (league_path.parent/Path(m['checkpoint']).name).is_file()]
+        if saved:
+            newest = max(saved, key=lambda m: m['created_step'])
+            print(f'Last saved checkpoint {Path(newest["checkpoint"]).name} | {newest["created_step"]:,} decisions')
+    folder = directory/'eval'
+    for step in protocol['milestones']:
+        path = folder/f'development-{step}.json'
+        if path.is_file():
+            panel = read(path)['result']
+            lo, hi = panel['paired95']
+            print(f'Update {step} scored {panel["score"]:.1%} against the parent on '
+                  f'{panel["pairs"]} seed pairs (95% interval {lo:.1%} to {hi:.1%})')
+    path = directory/'result.json'
+    if path.is_file():
+        final = read(path)
+        if final['confirmation']:
+            panel = final['confirmation']
+            lo, hi = panel['paired95']
+            print(f'Final confirmation {panel["score"]:.1%} on {protocol["finalConfirmationPairs"]} '
+                  f'fresh seed pairs (95% interval {lo:.1%} to {hi:.1%})')
+        delta = final['transfer']['average']
+        print(f'Average score change against v22 and v25 {100*delta["scoreChange"]:+.2f} percentage points')
+        decision = 'passed' if final['passedAIComparison'] else 'did not pass'
+        print(f'Candidate {final["candidate"][:12]} {decision} the AI comparison')
+    elif (directory/'trained.json').is_file():
+        print('Training complete | final evaluation results pending')
+    else:
+        milestones = ', '.join(map(str, protocol['milestones']))
+        print(f'Training target {protocol["milestones"][-1]:,} updates | checkpoints {milestones} evaluated after training')
+
+
+def status(directory):
+    directory = directory.resolve()
+    protocol = read(directory/'protocol.json')
+    population = 'population_league.py' in protocol.get('methods', {})
+    container = ('sap-' if population else 'sap-loop-') + directory.name
+    state = subprocess.run(
+        ['docker', 'inspect', '--format',
+         '{{.State.Status}}{{if eq .State.Status "exited"}} (exit {{.State.ExitCode}}){{end}}', container],
+        text=True, capture_output=True,
+    )
+    print(f'{container} | {state.stdout.strip() if state.returncode == 0 else "container state unavailable"}')
+    if population:
+        print(f'Parent SHA {protocol["parent"][:12]}')
+        population_progress(directory, protocol)
+        return
+    records = []
+    for path in sorted(directory.glob('score-*.json')):
+        report = json.loads(path.read_text())
+        milestone = int(path.stem.removeprefix('score-'))
+        records.append(milestone)
+        monitor = report['baseline']
+        line = f'Update {milestone}: {monitor["score"]:.1%} vs 25,772 ({monitor["pairs"]} seat pairs)'
+        confirm = report['confirmation']
+        if confirm:
+            line += f'; {confirm["score"]:.1%} vs incumbent on {confirm["pairs"]} fresh pairs'
+        print(line + ('; promoted' if report['promoted'] else '; incumbent retained'))
+    learner_progress(directory.glob('stage-*/training.log'))
+    current = directory/'progression.json'
+    champion = json.loads(current.read_text())['champion']['sha256'] if current.exists() else protocol['parent']
+    next_update = next((u for u in protocol['milestones'] if u not in records), None)
+    print(f'Champion SHA {champion[:12]} | ' +
+          (f'next evaluation at {next_update}' if next_update is not None else 'bounded cycle evaluated'))
+
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('run_directory', type=Path)
+    status(parser.parse_args().run_directory)
