+//! Seeded W/D/L evaluator for the pinned Turtle v30 battle rules.
+//! Unrepresented mechanics and bounded nonterminal fights return FALLBACK.
+use std::slice;
+const FALLBACK: i8 = -1;
+const NONE: i32 = 0;
+const QUIET: i32 = 1;
+const ANT: i32 = 2;
+const FLAMINGO: i32 = 3;
+const CRICKET: i32 = 4;
+const DEER: i32 = 5;
+const PEACOCK: i32 = 6;
+const DOLPHIN: i32 = 7;
+const CRAB: i32 = 8;
+const MOSQUITO: i32 = 9;
+const BLOWFISH: i32 = 10;
+const TURTLE: i32 = 11;
+const CROCODILE: i32 = 12;
+const MAMMOTH: i32 = 13;
+const CAMEL: i32 = 14;
+const BOAR: i32 = 15;
+const KANGAROO: i32 = 16;
+const GORILLA: i32 = 17;
+const SPIDER: i32 = 18; // If it faints, the random summon is resolved by the reference.
+const SKUNK: i32 = 19;
+const ARMADILLO: i32 = 20;
+const DODO: i32 = 21;
+const WOLVERINE: i32 = 22;
+const SHEEP: i32 = 23;
+const ROOSTER: i32 = 24;
+const HORSE: i32 = 25;
+const TURKEY: i32 = 26;
+const LEOPARD: i32 = 27;
+const HIPPO: i32 = 28;
+const RHINO: i32 = 29;
+const MUSHROOM: i32 = 10;
+
+const BONE: i32 = 1;
+const STEAK: i32 = 2;
+const MELON: i32 = 3;
+const GARLIC: i32 = 4;
+const COCONUT: i32 = 5;
+const POISON: i32 = 6;
+const CHILI: i32 = 7;
+const WEAK: i32 = 8;
+const HONEY: i32 = 9;
+
+#[repr(C)]
+#[derive(Clone, Copy, Default)]
+pub struct Pet {
+    kind: i32,
+    level: i32,
+    attack: i32,
+    health: i32,
+    temp_attack: i32,
+    temp_health: i32,
+    perk: i32,
+    counter: i32,
+    friend_hurts: i32,
+    birth_perk: i32,
+    tier: i32,
+}
+
+impl Pet {
+    fn atk(self) -> i32 {
+        (self.attack + self.temp_attack).min(50)
+    }
+    fn hp(self) -> i32 {
+        (self.health + self.temp_health).min(50)
+    }
+    fn living(self) -> bool {
+        self.kind != NONE && self.hp() > 0
+    }
+    fn hit(self) -> i32 {
+        let a = self.atk();
+        if a <= 0 {
+            return 0;
+        }
+        a + match self.perk {
+            BONE => 3,
+            STEAK => 20,
+            _ => 0,
+        }
+    }
+    fn defend(self, damage: i32) -> i32 {
+        if damage <= 0 {
+            return 0;
+        }
+        match self.perk {
+            MELON => (damage - 20).max(0),
+            COCONUT => 0,
+            GARLIC => (damage - 2).max(2),
+            WEAK => damage + 3,
+            _ => damage,
+        }
+    }
+    fn buff(&mut self, a: i32, h: i32) {
+        self.attack = (self.attack + a).min(50);
+        self.health = (self.health + h).min(50);
+    }
+}
+
+// NumPy legacy RandomState(integer), rk_interval, and Fisher-Yates shuffle.
+// choice(..., replace=False) shuffles the entire candidate list even for one draw.
+#[derive(Clone)]
+struct Mt {
+    words: [u32; 624],
+    pos: usize,
+}
+impl Mt {
+    fn new(seed: u32) -> Self {
+        let mut words = [0; 624];
+        words[0] = seed;
+        for i in 1..624 {
+            let prev = words[i - 1];
+            words[i] = 1812433253u32
+                .wrapping_mul(prev ^ (prev >> 30))
+                .wrapping_add(i as u32);
+        }
+        Self { words, pos: 624 }
+    }
+    fn word(&mut self) -> u32 {
+        if self.pos == 624 {
+            for i in 0..624 {
+                let y = (self.words[i] & 0x80000000) | (self.words[(i + 1) % 624] & 0x7fffffff);
+                self.words[i] = self.words[(i + 397) % 624]
+                    ^ (y >> 1)
+                    ^ (if y & 1 != 0 { 0x9908b0df } else { 0 });
+            }
+            self.pos = 0;
+        }
+        let mut y = self.words[self.pos];
+        self.pos += 1;
+        y ^= y >> 11;
+        y ^= (y << 7) & 0x9d2c5680;
+        y ^= (y << 15) & 0xefc60000;
+        y ^ (y >> 18)
+    }
+    fn interval(&mut self, max: usize) -> usize {
+        if max == 0 {
+            return 0;
+        }
+        let mask = u32::MAX >> (max as u32).leading_zeros();
+        loop {
+            let v = (self.word() & mask) as usize;
+            if v <= max {
+                return v;
+            }
+        }
+    }
+    fn shuffle<T>(&mut self, a: &mut [T]) {
+        for i in (1..a.len()).rev() {
+            let j = self.interval(i);
+            a.swap(i, j);
+        }
+    }
+    fn choice(&mut self, ids: &mut [usize]) -> usize {
+        self.shuffle(ids);
+        ids[0]
+    }
+}
+
+struct Fight {
+    pets: [Pet; 10],
+    hurt: [u8; 10],
+    rng: Mt,
+    pending: Vec<(usize, Pet, usize)>,
+}
+impl Fight {
+    fn team(i: usize) -> std::ops::Range<usize> {
+        let first = i / 5 * 5;
+        first..first + 5
+    }
+    fn opponents(i: usize) -> std::ops::Range<usize> {
+        Self::team(if i < 5 { 5 } else { 0 })
+    }
+    fn compact(&mut self) {
+        for start in [0, 5] {
+            let mut out = start;
+            for i in start..start + 5 {
+                if self.pets[i].kind != NONE {
+                    self.pets.swap(out, i);
+                    self.hurt.swap(out, i);
+                    out += 1;
+                }
+            }
+        }
+    }
+    fn priority(&mut self) -> ([usize; 10], usize) {
+        // Stable insertion sort for at most ten slots, followed by the
+        // reference shuffle within each attack group.
+        let mut order = [0; 10];
+        let mut n = 0;
+        for (i, pet) in self.pets.iter().enumerate() {
+            if pet.kind == NONE {
+                continue;
+            }
+            let mut at = n;
+            while at > 0 && self.pets[order[at - 1]].atk() < pet.atk() {
+                order[at] = order[at - 1];
+                at -= 1;
+            }
+            order[at] = i;
+            n += 1;
+        }
+        let mut begin = 0;
+        while begin < n {
+            let mut end = begin + 1;
+            while end < n && self.pets[order[end]].atk() == self.pets[order[begin]].atk() {
+                end += 1;
+            }
+            self.rng.shuffle(&mut order[begin..end]);
+            begin = end;
+        }
+        (order, n)
+    }
+    fn damage(&mut self, i: usize, amount: i32, clear_shield: bool) -> i32 {
+        let v = if clear_shield && amount == 0 {
+            match self.pets[i].perk {
+                GARLIC => 2,
+                WEAK => 3,
+                _ => 0,
+            }
+        } else {
+            self.pets[i].defend(amount)
+        };
+        if clear_shield && matches!(self.pets[i].perk, MELON | COCONUT) {
+            self.pets[i].perk = 0;
+        }
+        self.pets[i].health -= v;
+        if v > 0 {
+            self.hurt[i] += 1;
+        }
+        v
+    }
+    fn shot(&mut self, i: usize, n: usize, amount: i32, lowest: bool) {
+        let mut choices: Vec<_> = Self::opponents(i)
+            .filter(|&j| self.pets[j].living())
+            .collect();
+        if choices.is_empty() {
+            return;
+        }
+        if lowest {
+            let min = choices.iter().map(|&j| self.pets[j].hp()).min().unwrap();
+            choices.retain(|&j| self.pets[j].hp() == min);
+        }
+        let n = n.min(choices.len());
+        if n == 1 {
+            let j = self.rng.choice(&mut choices);
+            self.damage(j, amount, true);
+        } else {
+            // itertools.combinations emits lexicographic tuples.
+            let mut combinations = Vec::new();
+            for a in 0..choices.len() {
+                for b in a + 1..choices.len() {
+                    if n == 2 {
+                        combinations.push(vec![choices[a], choices[b]]);
+                    } else {
+                        for c in b + 1..choices.len() {
+                            combinations.push(vec![choices[a], choices[b], choices[c]]);
+                        }
+                    }
+                }
+            }
+            let mut ids: Vec<_> = (0..combinations.len()).collect();
+            for &j in &combinations[self.rng.choice(&mut ids)] {
+                self.damage(j, amount, true);
+            }
+        }
+    }
+    fn start(&mut self) -> Option<()> {
+        self.priority(); // constructor
+        self.compact();
+        let (order, n) = self.priority();
+        for &i in &order[..n] {
+            // after initial move, before StartOfBattle
+            let p = self.pets[i];
+            match p.kind {
+                CRAB => {
+                    let friends: Vec<_> = Self::team(i)
+                        .filter(|&j| j != i && self.pets[j].living())
+                        .collect();
+                    if let Some(high) = friends.iter().map(|&j| self.pets[j].hp()).max() {
+                        let n = friends
+                            .iter()
+                            .filter(|&&j| self.pets[j].hp() == high)
+                            .count();
+                        self.rng.interval(n - 1); // with replacement in the Crab effect
+                        self.pets[i].health = (p.health + (high * p.level + 3) / 4).min(50);
+                    }
+                }
+                SKUNK => {
+                    let mut choices: Vec<_> = Self::opponents(i)
+                        .filter(|&j| self.pets[j].living())
+                        .collect();
+                    if let Some(high) = choices.iter().map(|&j| self.pets[j].hp()).max() {
+                        choices.retain(|&j| self.pets[j].hp() == high);
+                        let j = self.rng.choice(&mut choices);
+                        self.pets[j].health = ((high as f64 * (1. - (33 * p.level) as f64 * 0.01))
+                            .floor() as i32)
+                            .max(1);
+                    }
+                }
+                ARMADILLO => {
+                    for target in &mut self.pets {
+                        if target.living() {
+                            target.buff(0, 8 * p.level);
+                        }
+                    }
+                }
+                DODO => {
+                    if let Some(j) = Self::team(i)
+                        .rev()
+                        .find(|&j| j < i && self.pets[j].living())
+                    {
+                        self.pets[j].buff((p.atk() * p.level / 2).max(1), 0);
+                    }
+                }
+                CROCODILE => {
+                    for _ in 0..p.level {
+                        if let Some(j) = Self::opponents(i).rev().find(|&j| self.pets[j].living()) {
+                            self.damage(j, 8, true);
+                        }
+                    }
+                }
+                DOLPHIN => {
+                    for _ in 0..p.level {
+                        self.shot(i, 1, 4, true)
+                    }
+                }
+                LEOPARD => self.shot(i, p.level as usize, p.atk() / 2, false),
+                MOSQUITO => self.shot(i, p.level as usize, 1, false),
+                _ => (),
+            }
+        }
+        self.resolve(false)?;
+        self.compact();
+        self.priority();
+        Some(())
+    }
+    fn resolve(&mut self, defer: bool) -> Option<()> {
+        let mut dead = [false; 10];
+
+        for _ in 0..256 {
+            let (indices, n) = self.priority();
+            let order = &indices[..n];
+            if let Some(&i) = order.iter().find(|&&i| self.hurt[i] > 0) {
+                self.hurt[i] -= 1;
+                let pet = self.pets[i];
+                match pet.kind {
+                    PEACOCK => self.pets[i].buff(3 * pet.level, 0),
+                    CAMEL => {
+                        if let Some(j) = Self::team(i).find(|&j| j > i && self.pets[j].living()) {
+                            self.pets[j].buff(pet.level, 2 * pet.level);
+                        }
+                    }
+                    GORILLA if pet.counter < pet.level => {
+                        self.pets[i].counter += 1;
+                        self.pets[i].perk = COCONUT;
+                    }
+                    BLOWFISH => self.shot(i, 1, 3 * pet.level, false),
+                    _ => (),
+                }
+                for j in Self::team(i) {
+                    if i != j && self.pets[j].kind == WOLVERINE {
+                        self.pets[j].friend_hurts += 1;
+                        if self.pets[j].friend_hurts >= 4 {
+                            self.pets[j].friend_hurts = 0;
+                            let debuff = -3 * self.pets[j].level;
+                            for k in Self::opponents(j) {
+                                if self.pets[k].living() {
+                                    self.pets[k].buff(0, debuff);
+                                }
+                            }
+                        }
+                    }
+                }
+                continue;
+            }
+            if let Some(&i) = order.iter().find(|&&i| self.pets[i].hp() <= 0 && !dead[i]) {
+                dead[i] = true;
+                let p = self.pets[i];
+                match p.kind {
+                    ANT => {
+                        let mut friends: Vec<_> = Self::team(i)
+                            .filter(|&j| j != i && self.pets[j].living())
+                            .collect();
+                        if !friends.is_empty() {
+                            let j = self.rng.choice(&mut friends);
+                            self.pets[j].buff(p.level, p.level);
+                        }
+                    }
+                    FLAMINGO => {
+                        let friends: Vec<_> = Self::team(i)
+                            .filter(|&j| j > i && self.pets[j].living())
+                            .take(2)
+                            .collect();
+                        for j in friends {
+                            self.pets[j].buff(p.level, p.level);
+                        }
+                    }
+                    SPIDER => return None,
+                    TURTLE => {
+                        let friends: Vec<_> = Self::team(i)
+                            .filter(|&j| {
+                                j > i && self.pets[j].living() && self.pets[j].perk != MELON
+                            })
+                            .take(p.level as usize)
+                            .collect();
+                        for j in friends {
+                            self.pets[j].perk = MELON;
+                        }
+                    }
+                    MAMMOTH => {
+                        for j in Self::team(i) {
+                            if self.pets[j].living() {
+                                self.pets[j].buff(2 * p.level, 2 * p.level);
+                            }
+                        }
+                    }
+                    CRICKET | DEER | SHEEP | ROOSTER => {
+                        let (a, h, perk, count) = match p.kind {
+                            DEER => (5 * p.level, 3 * p.level, CHILI, 1),
+                            SHEEP => (2 * p.level, 2 * p.level, 0, 2),
+                            ROOSTER => (p.atk() / 2, 1, 0, p.level),
+                            _ => (p.level, p.level, 0, 1),
+                        };
+                        self.pending.push((
+                            i,
+                            Pet {
+                                kind: QUIET,
+                                level: 1,
+                                attack: a,
+                                health: h,
+                                perk,
+                                birth_perk: perk,
+                                tier: 1,
+                                ..Pet::default()
+                            },
+                            count as usize,
+                        ));
+                    }
+                    _ => (),
+                }
+                if p.perk == MUSHROOM {
+                    self.pending.push((
+                        i,
+                        Pet {
+                            kind: p.kind,
+                            level: p.level,
+                            attack: 1,
+                            health: 1,
+                            perk: p.birth_perk,
+                            birth_perk: p.birth_perk,
+                            tier: p.tier,
+                            ..Pet::default()
+                        },
+                        1,
+                    ));
+                } else if p.perk == HONEY {
+                    self.pending.push((
+                        i,
+                        Pet {
+                            kind: QUIET,
+                            level: 1,
+                            attack: 1,
+                            health: 1,
+                            tier: 1,
+                            ..Pet::default()
+                        },
+                        if p.kind == SHEEP { 2 } else { 1 },
+                    ));
+                }
+                continue;
+            }
+            for (i, &d) in dead.iter().enumerate() {
+                if d {
+                    self.pets[i] = Pet::default();
+                }
+            }
+            if !defer {
+                self.flush_summons();
+            }
+            self.priority();
+            return Some(());
+        }
+        None
+    }
+    fn flush_summons(&mut self) {
+        for (i, pet, n) in std::mem::take(&mut self.pending) {
+            self.summon(i, pet, n);
+        }
+    }
+
+    fn enqueue(&mut self, queue: &mut Vec<(i32, u64, usize, Pet)>, i: usize, pet: Pet) {
+        // random_sample uses two MT words even for attackers without a
+        // KnockOut ability; later random target selection observes the stream.
+        let high = (self.rng.word() >> 5) as u64;
+        let low = (self.rng.word() >> 6) as u64;
+        if matches!(pet.kind, HIPPO | RHINO) {
+            queue.push((pet.atk(), (high << 26) | low, i, pet));
+        }
+    }
+
+    fn knockouts(&mut self, queue: &mut Vec<(i32, u64, usize, Pet)>) -> Option<()> {
+        for _ in 0..64 {
+            if queue.is_empty() {
+                self.flush_summons();
+                return Some(());
+            }
+            queue.sort_by(|x, y| (y.0, y.1).cmp(&(x.0, x.1)));
+            let (_, _, i, source) = queue.remove(0);
+            let mut killed = false;
+            if source.kind == HIPPO {
+                if self.pets[i].kind != HIPPO || self.pets[i].counter >= 3 {
+                    continue;
+                }
+                self.pets[i].counter += 1;
+                self.pets[i].buff(3 * source.level, 3 * source.level);
+            } else if let Some(j) = Self::opponents(i).find(|&j| self.pets[j].living()) {
+                let damage = 4 * source.level * if self.pets[j].tier == 1 { 2 } else { 1 };
+                self.damage(j, damage, true);
+                killed = self.pets[j].hp() <= 0;
+            }
+            self.resolve(true)?;
+            if killed {
+                let active = if self.pets[i].kind == RHINO {
+                    self.pets[i]
+                } else {
+                    source
+                };
+                self.enqueue(queue, i, active);
+            }
+        }
+        None
+    }
+    fn summon(&mut self, origin: usize, pet: Pet, count: usize) {
+        // The reference recomputes how many survivors precede the original
+        // physical slot for each queued summon, then compacts that team.
+        let side = Self::team(origin);
+        let start = side.start;
+        let ahead = self.pets[start..origin]
+            .iter()
+            .filter(|p| p.kind != NONE)
+            .count();
+        let mut members: Vec<Pet> = self.pets[side.clone()]
+            .iter()
+            .copied()
+            .filter(|p| p.kind != NONE)
+            .collect();
+        let n = count.min(5 - members.len());
+        if n == 0 {
+            return;
+        }
+        members.splice(ahead..ahead, std::iter::repeat(pet).take(n));
+        self.pets[side.clone()].fill(Pet::default());
+        self.pets[start..start + members.len()].copy_from_slice(&members);
+        for idx in start + ahead..start + ahead + n {
+            for obs in side.clone() {
+                if obs == idx {
+                    continue;
+                }
+                let friend = self.pets[obs];
+                if friend.kind == HORSE {
+                    let new = self.pets[idx].temp_attack + friend.level;
+                    self.pets[idx].temp_attack = new.min((50 - self.pets[idx].attack).max(0));
+                } else if friend.kind == TURKEY {
+                    self.pets[idx].buff(3 * friend.level, friend.level);
+                }
+            }
+        }
+    }
+    fn result(&self) -> Option<i8> {
+        match (
+            self.pets[..5].iter().any(|p| p.living()),
+            self.pets[5..].iter().any(|p| p.living()),
+        ) {
+            (true, true) => None,
+            (true, false) => Some(0),
+            (false, true) => Some(1),
+            _ => Some(2),
+        }
+    }
+    fn run(&mut self) -> Option<i8> {
+        self.start()?;
+        for _ in 0..512 {
+            self.priority();
+            self.compact();
+            if let Some(result) = self.result() {
+                return Some(result);
+            }
+            for i in [0, 5] {
+                let pet = self.pets[i];
+                if pet.kind == BOAR {
+                    self.pets[i].buff(4 * pet.level, 2 * pet.level);
+                }
+            }
+            self.resolve(false)?; // BeforeAttack / hurt-and-faint
+            let (a, b) = (self.pets[0], self.pets[5]);
+            let da = self.damage(5, a.hit(), false);
+            let db = self.damage(0, b.hit(), false);
+            for i in [0, 5] {
+                if matches!(self.pets[i].perk, STEAK | MELON | COCONUT) {
+                    self.pets[i].perk = 0;
+                }
+            }
+            if a.perk == POISON && da > 0 {
+                self.pets[5].health = -b.temp_health;
+            }
+            if b.perk == POISON && db > 0 {
+                self.pets[0].health = -a.temp_health;
+            }
+            let mut knockouts = Vec::new();
+            if self.pets[0].hp() <= 0 {
+                self.enqueue(&mut knockouts, 5, self.pets[5]);
+            }
+            if self.pets[5].hp() <= 0 {
+                self.enqueue(&mut knockouts, 0, self.pets[0]);
+            }
+            for (attacker, behind) in [(a, 6), (b, 1)] {
+                if attacker.perk == CHILI && self.pets[behind].kind != NONE {
+                    self.damage(behind, 5, true);
+                    if self.pets[behind].hp() <= 0 {
+                        let source = if behind == 6 { 0 } else { 5 };
+                        self.enqueue(&mut knockouts, source, self.pets[source]);
+                    }
+                }
+            }
+            for i in [1, 6] {
+                let p = self.pets[i];
+                if p.kind == KANGAROO {
+                    self.pets[i].buff(p.level, p.level);
+                }
+            }
+            self.resolve(true)?;
+            self.knockouts(&mut knockouts)?;
+            self.compact();
+            if let Some(result) = self.result() {
+                return Some(result);
+            }
+        }
+        None
+    }
+}
+
+#[no_mangle]
+pub extern "C" fn sap_batch_abi() -> u32 {
+    5
+}
+
+#[no_mangle]
+pub unsafe extern "C" fn sap_score_batch(
+    left: *const Pet,
+    m: usize,
+    right: *const Pet,
+    n: usize,
+    seeds: *const u32,
+    k: usize,
+    out: *mut i8,
+) {
+    let candidates = slice::from_raw_parts(left, m * 5);
+    let opponents = slice::from_raw_parts(right, n * 5);
+    let streams: Vec<_> = slice::from_raw_parts(seeds, k)
+        .iter()
+        .copied()
+        .map(Mt::new)
+        .collect();
+    let result = slice::from_raw_parts_mut(out, m * n * k);
+    for (i, a) in candidates.chunks_exact(5).enumerate() {
+        for (j, b) in opponents.chunks_exact(5).enumerate() {
+            let scores = &mut result[(i * n + j) * k..(i * n + j + 1) * k];
+            if a.iter().chain(b).any(|p| !(0..=RHINO).contains(&p.kind)) {
+                scores.fill(FALLBACK);
+                continue;
+            }
+            for (slot, rng) in scores.iter_mut().zip(&streams) {
+                let mut pets = [Pet::default(); 10];
+                pets[..5].copy_from_slice(a);
+                pets[5..].copy_from_slice(b);
+                *slot = Fight {
+                    pets,
+                    hurt: [0; 10],
+                    rng: rng.clone(),
+                    pending: Vec::new(),
+                }
+                .run()
+                .unwrap_or(FALLBACK);
+            }
+        }
+    }
+}
+
+/// Testing surface: the same engine as the batch entry point, with final
+/// represented pet fields and full MT19937 state for differential checks.
+#[no_mangle]
+pub unsafe extern "C" fn sap_inspect_battle(
+    input: *const Pet,
+    seed: u32,
+    terminal: *mut Pet,
+    words: *mut u32,
+    pos: *mut u32,
+) -> i8 {
+    let mut pets = [Pet::default(); 10];
+    pets.copy_from_slice(slice::from_raw_parts(input, 10));
+    if pets.iter().any(|p| !(0..=RHINO).contains(&p.kind)) {
+        return FALLBACK;
+    }
+    let mut fight = Fight {
+        pets,
+        hurt: [0; 10],
+        rng: Mt::new(seed),
+        pending: Vec::new(),
+    };
+    let Some(result) = fight.run() else {
+        return FALLBACK;
+    };
+    slice::from_raw_parts_mut(terminal, 10).copy_from_slice(&fight.pets);
+    slice::from_raw_parts_mut(words, 624).copy_from_slice(&fight.rng.words);
+    *pos = fight.rng.pos as u32;
+    result
+}
