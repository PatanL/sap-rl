+"""Run the released v30 learner with an explicit CUDA allocator ceiling."""
+import os
+import runpy
+import sys
+import hashlib
+import shutil
+import tempfile
+from pathlib import Path
+
+
+if __name__ == "__main__":
+    import torch
+
+    if not torch.cuda.is_available():
+        raise RuntimeError("The shared-GPU run requires CUDA.")
+    torch.cuda.set_per_process_memory_fraction(
+        min(1.0, 6 * 1024**3 / torch.cuda.get_device_properties(0).total_memory)
+    )
+    source = Path(os.environ["SAP_TRAIN_SOURCE"])
+    # Smaller groups accumulate gradients into the same Adam step, weighted
+    # by transition count by the frozen learner. Leave the release read-only.
+    with tempfile.TemporaryDirectory(prefix="sap-small-groups-") as scratch:
+        gym = Path(scratch) / "sapai-gym"
+        shutil.copytree(source / "source/sapai-gym", gym)
+        module = gym / "sapai_gym1/rl/training.py"
+        data = module.read_bytes()
+        if hashlib.sha256(data).hexdigest() != "76fba2c16e90d9b8adf6b05381ea934353957d66ebadb9fdcd5fc259e91ec984":
+            raise ValueError("Unexpected frozen learner version")
+        for old, new in [(b"len(bucket), 128)", b"len(bucket), 16)"),
+                         (b"bucket[start : start + 128]", b"bucket[start : start + 16]")]:
+            if data.count(old) != 1:
+                raise ValueError("Unexpected learner group layout")
+            data = data.replace(old, new)
+        module.write_bytes(data)
+        sys.path[:0] = [str(gym), str(source)]
+        os.environ["PYTHONPATH"] = str(gym) + os.pathsep + os.environ["PYTHONPATH"]
+        runpy.run_path(str(source / "train_runtime.py"), run_name="__main__")
diff --git a/research/selfplay/turn_policy_selection.py b/research/selfplay/turn_policy_selection.py
new file mode 100644
index 0000000..eb801cd
--- /dev/null
+++ b/research/selfplay/turn_policy_selection.py
@@ -0,0 +1,232 @@
+"""Learn a once-per-shop-turn choice among three frozen self-play policies."""
+import argparse
+import copy
+import fcntl
+import json
+from pathlib import Path
+
+import numpy as np
+import torch
+from torch import nn
+from plan_common import CURRENT, install, load_actor, seed_of, sha
+
+
+NAMES = ('parent', 'terminal-response', 'strategy')
+TAG = 'whole-match-turn-policy-selection-25772-v1'
+RESIDENT_HASHES = {
+    'terminal-response': '18e7bbc8186a972c68f3f77fd2c8a978ca5973dcd5df6d0c7ec553dbaeb5c944',
+    'strategy': '02a18880f23b27437a7bcc509938584a832999c6bbca00f901ea329a00312111',
+}
+
+
+def write(path, value):
+    tmp = path.with_suffix('.partial')
+    tmp.write_text(json.dumps(value, indent=2, allow_nan=False))
+    tmp.replace(path)
+
+
+class TurnSelector(nn.Module):
+    def __init__(self, width):
+        super().__init__()
+        rng = torch.Generator().manual_seed(seed_of(TAG, 'projection'))
+        self.register_buffer('projection', torch.randn(width, 32, generator=rng) / width**.5)
+        self.head = nn.Linear(32, len(NAMES))
+        nn.init.zeros_(self.head.weight)
+        nn.init.zeros_(self.head.bias)
+
+    def features(self, context):
+        return nn.functional.layer_norm(context, context.shape[-1:]) @ self.projection
+
+
+def batched(rows):
+    return {k: torch.from_numpy(np.stack([r[k] for r in rows])) for k in rows[0]}
+
+
+@torch.no_grad()
+def play(models, selector, assignments, *, training=False, fixed=None):
+    from sapai_gym1.rl.selfplay_env import ParallelSelfPlayEnv
+    from sapai_gym1.rl.joint_action import JointAction, step_decisions
+    from sapai_gym1.rl.action_schema import AutoregressiveAction
+    from sapai_gym1.rl.distributed import _completed_match_result
+    games = []
+    for world, opponent in assignments:
+        for seat in (0, 1):
+            for replica in range(2 if training else 1):
+                env = ParallelSelfPlayEnv()
+                env.reset(seed=world, paired_tape=True)
+                rng = torch.Generator().manual_seed(seed_of(TAG, 'choices', world, seat, replica))
+                games.append(dict(world=world, seat=seat, replica=replica, opponent=opponent,
+                                  env=env, memory=models[0].initial_memory(2, 'cpu'), rng=rng,
+                                  turn=0, selected=None, trace=[], score=None))
+    for _ in range(2500):
+        live = [g for g in games if g['score'] is None]
+        if not live:
+            break
+        observations = [g['env'].observations() for g in live]
+        new = [i for i,g in enumerate(live) if g['env'].core.turn != g['turn']]
+        if new:
+            ctx = None
+            if fixed is None:
+                obs = batched([observations[i][live[i]['seat']] for i in new])
+                memory = torch.stack([live[i]['memory'][live[i]['seat']] for i in new])
+                encoded = models[0].encode_decision(obs, memory, forecast=False)
+                ctx = selector.features(encoded.context)
+                log_probs = selector.head(ctx).log_softmax(-1)
+            for j,i in enumerate(new):
+                g = live[i]
+                g['turn'] = g['env'].core.turn
+                if fixed is not None:
+                    choice = fixed
+                elif training:
+                    choice = int(torch.multinomial(log_probs[j].exp(), 1, generator=g['rng']))
+                else:
+                    choice = int(log_probs[j].argmax())
+                g['selected'] = choice
+                if training:
+                    g['trace'].append((ctx[j].clone(), choice, float(log_probs[j,choice])))
+                else:
+                    g['trace'].append(choice)
+        requests = [[] for _ in models]
+        actions = [[None, None] for _ in live]
+        for i,g in enumerate(live):
+            for side, active in enumerate(g['env'].active_players()):
+                if active:
+                    owner = g['selected'] if side==g['seat'] else g['opponent']
+                    requests[owner].append((i, side))
+        for model, group in zip(models, requests):
+            if not group:
+                continue
+            obs = batched([observations[i][s] for i,s in group])
+            memory = torch.stack([live[i]['memory'][s] for i,s in group])
+            out = model.act(obs, memory=memory, deterministic=True)
+            for j,(i,s) in enumerate(group):
+                actions[i][s] = JointAction(AutoregressiveAction(*out.actions[j].tolist()),
+                                            int(out.end_freeze_mask[j]))
+                live[i]['memory'][s] = out.memory[j]
+        for g,pair in zip(live, actions):
+            if step_decisions(g['env'], pair).result.terminated:
+                winner = _completed_match_result(g['env'].core)
+                g['score'] = .5 if winner==2 else float(winner==g['seat'])
+    if any(g['score'] is None or len(g['trace'])!=g['turn'] for g in games):
+        raise RuntimeError('Incomplete match or incorrect turn ownership')
+    return games
+
+
+def update(selector, optimizer, games):
+    traces, advantage = [], []
+    for a,b in zip(games[::2],games[1::2]):
+        if (a['world'],a['seat'],a['opponent'],a['replica']) != (b['world'],b['seat'],b['opponent'],0) or b['replica']!=1:
+            raise ValueError('Replicas must share world, seat, and opponent')
+        for g,other in ((a,b),(b,a)):
+            traces.extend(g['trace'])
+            advantage.extend([g['score']-other['score']]*len(g['trace']))
+    features, actions, saved = zip(*traces)
+    logp = selector.head(torch.stack(features)).log_softmax(-1)
+    chosen = logp.gather(1, torch.tensor(actions)[:,None])[:,0]
+    error = (chosen.detach()-torch.tensor(saved)).abs().max().item()
+    if error > 1e-4:
+        raise ValueError(f'Sampled choice likelihood changed: {error}')
+    loss = -(chosen*torch.tensor(advantage)).sum() / len(games)
+    optimizer.zero_grad(set_to_none=True)
+    loss.backward()
+    norm = torch.nn.utils.clip_grad_norm_(selector.head.parameters(), 1., error_if_nonfinite=True)
+    optimizer.step()
+    return dict(games=len(games), choices=len(traces), credited=int(np.count_nonzero(advantage)),
+                counts=np.bincount(actions,minlength=3).tolist(), gradientNorm=float(norm), likelihoodError=error)
+
+
+def interval(scores):
+    scores=np.asarray(scores)
+    samples=np.random.default_rng(25772).choice(scores,(20000,len(scores))).mean(1)
+    return dict(score=float(scores.mean()), paired95=np.quantile(samples,[.025,.975]).tolist())
+
+
+def run(folder, residents, contract):
+    install(cuda=False)
+    torch.set_num_threads(1)
+    torch.backends.mha.set_fastpath_enabled(False)
+    torch.manual_seed(25772)
+    folder.mkdir(parents=True,exist_ok=True)
+    lock=(folder/'experiment.lock').open('a')
+    fcntl.flock(lock,fcntl.LOCK_EX|fcntl.LOCK_NB)
+    updates, pairs = (2,2) if contract else (64,96)
+    namespace=TAG+('-contract' if contract else '')
+    spec=dict(namespace=namespace, parent=CURRENT['sha'], source=sha(__file__), residents=RESIDENT_HASHES,
+              updates=updates, trainingWorldsPerUpdate=4, freshEvaluationPairs=pairs, lr=.002)
+    protocol=folder/'protocol.json'
+    if protocol.exists() and json.loads(protocol.read_text())!=spec:
+        raise ValueError('Incompatible experiment')
+    write(protocol,spec)
+    parent=load_actor(device='cpu').model
+    models=[parent]
+    for name in NAMES[1:]:
+        path=residents/(name+'.pt')
+        if sha(path)!=RESIDENT_HASHES[name]:
+            raise ValueError('Frozen expert changed')
+        ck=torch.load(path, map_location='cpu', weights_only=True, mmap=True)
+        if ck['parent']!=CURRENT['sha']:
+            raise ValueError('Wrong expert lineage')
+        model=copy.deepcopy(parent)
+        model.load_state_dict(ck['model'])
+        models.append(model.eval().requires_grad_(False))
+    selector=TurnSelector(parent.config.d_model)
+    optimizer=torch.optim.Adam(selector.head.parameters(),lr=spec['lr'])
+    saved=folder/'training.pt'
+    history=[]
+    if saved.exists():
+        state=torch.load(saved,map_location='cpu',weights_only=True)
+        if state['protocol']!=sha(protocol):
+            raise ValueError('Checkpoint belongs to another protocol')
+        selector.load_state_dict(state['model'])
+        optimizer.load_state_dict(state['optimizer'])
+        history=state['history']
+    train_seeds=[seed_of(namespace,'train',u,i) for u in range(updates) for i in range(4)]
+    eval_seeds=[seed_of(namespace,'eval',i) for i in range(pairs)]
+    if len(set(train_seeds+eval_seeds))!=len(train_seeds)+len(eval_seeds):
+        raise ValueError('Repeated world')
+    for u in range(len(history),updates):
+        assignments=[(train_seeds[u*4+i],(0,1,0,2)[(i+u)%4]) for i in range(4)]
+        games=play(models,selector,assignments,training=True)
+        log=update(selector,optimizer,games)
+        history.append(dict(update=u+1,worlds=[w for w,_ in assignments],**log))
+        tmp=saved.with_suffix('.tmp')
+        torch.save(dict(model=selector.state_dict(),optimizer=optimizer.state_dict(),
+                        protocol=sha(protocol),history=history),tmp)
+        tmp.replace(saved)
+        write(folder/'training.json',history)
+        if (u+1)%8==0 or contract:
+            print('selector update',u+1,log,flush=True)
+    digest=sha(saved)
+    results={}
+    paired={}
+    for name in ('selector',*NAMES):
+        rows=[]
+        for start in range(0,pairs,8):
+            block=eval_seeds[start:start+8]
+            path=folder/f'{name}-{start:03d}.json'
+            if not path.exists():
+                games=play(models,selector,[(w,0) for w in block],fixed=None if name=='selector' else NAMES.index(name))
+                rec=[dict(world=g['world'],seat=g['seat'],score=g['score'],choices=g['trace']) for g in games]
+                write(path,dict(arm=name,checkpoint=digest,games=rec))
+            rec=json.loads(path.read_text())
+            if (rec['arm'],rec['checkpoint'])!=(name,digest) or [(g['world'],g['seat']) for g in rec['games']]!=[
+                (w,s) for w in block for s in (0,1)]:
+                raise ValueError('Wrong match receipt')
+            rows.extend(rec['games'])
+        scores=np.array([g['score'] for g in rows]).reshape(-1,2).mean(1)
+        if name=='parent' and not np.all(scores==.5):
+            raise ValueError('Parent mirror did not give complementary results')
+        paired[name]=scores
+        results[name]=dict(**interval(scores),choices=np.bincount([c for g in rows for c in g['choices']],minlength=3).tolist())
+        print('completed',name,pairs,'pairs',flush=True)
+    results['selectorMinusFixed']={n:interval(paired['selector']-paired[n]) for n in NAMES}
+    write(folder/'result.json',dict(checkpoint=digest,protocol=sha(protocol),results=results))
+
+
+if __name__=='__main__':
+    p=argparse.ArgumentParser(description=__doc__)
+    p.add_argument('output',type=Path)
+    p.add_argument('residents',type=Path)
+    p.add_argument('--contract',action='store_true')
+    a=p.parse_args()
+    run(a.output,a.residents,a.contract)
