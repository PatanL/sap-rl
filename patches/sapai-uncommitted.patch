diff --git a/tests/test_calculator_fixtures.py b/tests/test_calculator_fixtures.py
new file mode 100644
index 0000000..1531b7c
--- /dev/null
+++ b/tests/test_calculator_fixtures.py
@@ -0,0 +1,37 @@
+"""Regression cases for submitted boards and calculator process isolation."""
+from pathlib import Path
+import shutil
+import sys
+import unittest
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "tools"))
+from differential_calculator import _calculator_config, _run_calculator, _submitted_team
+
+
+def pet(name, attack, health, experience=0, status="none"):
+    return dict(id="pet-" + name, attack=attack, health=health, experience=experience, status=status)
+
+
+class CalculatorFixtures(unittest.TestCase):
+    def test_parrot_has_native_copy_at_its_own_level_on_submitted_board(self):
+        team = _submitted_team([pet("crocodile", 14, 4), pet("parrot", 6, 7, 2)])
+        copied = team[1].pet.ability
+        self.assertEqual(copied["_copiedFrom"], "pet-crocodile")
+        self.assertEqual(copied["effect"], team[0].pet.fd["level2Ability"]["effect"])
+        self.assertEqual((team[1].pet.attack, team[1].pet.health), (6, 7))
+
+    def test_same_battle_twice_matches_fresh_process(self):
+        calculator = Path(__file__).resolve().parents[2] / "SAP-Calculator"
+        if not shutil.which("node") or not (calculator / "simulation/dist/index.js").is_file():
+            self.skipTest("Requires Node and the pinned SAP-Calculator checkout")
+        board = dict(
+            player=[pet("cat", 9, 14), pet("hippo", 17, 10, 2),
+                    pet("crab", 6, 16, status="status-garlic-armor"),
+                    pet("camel", 12, 10, status="status-honey-bee")],
+            opponent=[pet("peacock", 4, 15, status="status-honey-bee"),
+                      pet("dragon", 14, 11), pet("ant", 6, 13, status="status-extra-life"),
+                      pet("cricket", 7, 13, 2, "status-honey-bee")])
+        config = _calculator_config(board, 8, 99)
+        solo, = _run_calculator(calculator, [config])
+        self.assertEqual(solo["opponentWins"], 8)
+        self.assertEqual(_run_calculator(calculator, [config, config]), [solo, solo])
