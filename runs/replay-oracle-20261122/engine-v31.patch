+def _slot_insert(layout, slot_idx, pet):
+    """Put ``pet`` into a fixed board slot, shifting neighbours if needed.
+
+    v31: the board has five fixed slots and a summon goes into the slot
+    where the pet died. If that slot is taken, the pets from there are
+    pushed FORWARD when an empty slot exists ahead, and pushed back only
+    when none does. Evidence, all real fights also reproduced by
+    SAP-Calculator:
+    - Deer with Mushroom dies at the front: nothing ahead, so the Bus is
+      pushed back and the Mushroom Deer stands in front of it;
+    - Deer with Mushroom sniped mid-team or at the back while a slot ahead
+      is empty: the Bus is pushed forward and the Mushroom Deer is behind;
+    - Cricket with Honey at the front: Bee in front of the Zombie Cricket.
+    Preferring to push back instead fixed 3 real fights and broke 3.
+    """
+
+    size = len(layout)
+    target = min(max(int(slot_idx), 0), size - 1)
+    if layout[target] is None:
+        layout[target] = pet
+        return True
+    for empty in range(target - 1, -1, -1):
+        if layout[empty] is None:
+            layout[empty:target] = layout[empty + 1 : target + 1]
+            layout[target] = pet
+            return True
+    for empty in range(target + 1, size):
+        if layout[empty] is None:
+            layout[target + 1 : empty + 1] = layout[target:empty]
+            layout[target] = pet
+            return True
+    return False
+
+
+def _write_layout(team, layout):
+    from sapai.teams import TeamSlot
+
+    held = {id(slot.pet): slot for slot in team if not slot.empty}
+    for index, pet in enumerate(layout):
+        if pet is None:
+            team[index] = TeamSlot(seed_state=team.seed_state)
+        else:
+            team[index] = held[id(pet)]
+
+
+def _resync_layouts(layouts, teams, team_idx, slot_idx, created):
+    """Re-place whatever the last summon created, by fixed slot.
+
+    The summon effects compact the team and choose a position from a count
+    of pets ahead, which loses where the empty slots really are. After each
+    one, the new pets on the dead pet's own team are moved to the slot rule
+    above; a summon onto the other team keeps the engine's arrangement.
+    """
+
+    for index in (0, 1):
+        team = teams[index]
+        layout = layouts[index]
+        present = [slot.pet for slot in team if not slot.empty]
+        for position, pet in enumerate(layout):
+            if pet is not None and not any(pet is other for other in present):
+                layout[position] = None
+        fresh = [
+            pet
+            for pet in present
+            if not any(pet is other for other in layout if other is not None)
+        ]
+        if index != team_idx:
+            if fresh:
+                layouts[index] = [
+                    None if slot.empty else slot.pet for slot in team
+                ]
+            continue
+        ordered = [pet for pet in created if any(pet is other for other in fresh)]
+        ordered += [pet for pet in fresh if not any(pet is other for other in ordered)]
+        placed_all = True
+        for pet in ordered:
+            placed_all = _slot_insert(layout, slot_idx, pet) and placed_all
+        if placed_all:
+            _write_layout(team, layout)
+        else:
+            layouts[index] = [None if slot.empty else slot.pet for slot in team]
