# Allowlist: everything is ignored unless a rule below brings it back.
# Weights (*.pt), replays, captures, images, video and build output never match an allowed type.
*
!*/

# Allowed file types
!*.py
!*.sh
!*.rs
!*.toml
!*.md
!*.txt
!*.tsv
!*.json
!*.jsonl
!*.js
!*.patch
!*.log
!*.yml
!*.yaml
!*.csv
!*.diff
!*.sha256
!SHA256SUMS
!*.SHA256SUMS
!Cargo.lock
!Dockerfile*
!.gitignore
!.dockerignore

# Pinned engine builds are loaded by hash; keep the libraries themselves.
!/engine-rs-pinned/**/*.so

# Whole areas that stay local
/checkpoints/
/replay-data/
/.human-play-data/
/.tools/
/.pytest_cache/

# Other repositories (see SOURCES.md for URL and commit; local edits are in patches/)
/sapai/
/sapai-gym/
/sap-replay-bot/
/SAP-Calculator/

# Rust build output and the large generated test fixtures
/engine-rs/target/
/engine-rs/golden/
/engine-rs/env-golden/

# Runs: folders dated 2026-11-21 or later; older run folders stay local (not reviewed for this repository)
/runs/*
!/runs/*-2026112[1-9]/
!/runs/*-20261130/
!/runs/*-202612[0-9][0-9]/
!/runs/*-2027[0-9][0-9][0-9][0-9]/

# Inside runs: caches, vendored duplicates, raw replays, client captures, session data
__pycache__/
node_modules/
tmp/
raw/
raw-*/
captures/
live-browser-profile/
live-guest-profile/
/runs/replay-oracle-20261122/packaged/*
!/runs/replay-oracle-20261122/packaged/v31-20261123g/

# Client network log (session data)
network*.jsonl

# Per-battle and per-seat logs are large by nature (about 13 MB each)
*-battles.jsonl
seats.jsonl
*-pairs.json
*-fights.json

